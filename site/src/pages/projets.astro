---
import Base from '../layouts/Base.astro';
---

<Base
  title="Nos projets — BOPA"
  description="Les projets de la Chaire Innovation BOPA, du pré-opératoire au post-opératoire."
>
  <section class="section-block">
    <div class="wrap">
      <span class="kicker">Innovations</span>
      <h1>Nos projets</h1>
      <p class="lede">
        Des innovations développées au service de l'AP-HP, présentées ici à
        chaque étape du parcours patient.
      </p>

      <div class="card-grid">
        <article class="card">
          <span class="phase-tag">Pré-opératoire</span>
          <h2>LiverSight</h2>
          <p>
            Un outil de communication médecin-patient : le foie, les tumeurs
            et le geste chirurgical proposé prennent vie en 3D immersive
            pour faciliter une explication pédagogique. Les options
            thérapeutiques peuvent être simulées, comparées et expliquées en
            temps réel, et un PDF personnalisé accompagne le patient après
            la consultation.
          </p>
          <p>
            Développée en partenariat avec Toys Films, sous la supervision
            médicale du Pr. Eric Vibert et du Dr. Oriana Ciacio, chirurgiens
            au Centre Hépato-Biliaire de l'hôpital Paul-Brousse — AP-HP.
          </p>
        </article>

        <article class="card">
          <span class="phase-tag">Per-opératoire</span>
          <h2>Anyo</h2>
          <p>
            Un algorithme développé par la Chaire pour optimiser la
            répartition des gardes des chirurgiens. Un planning mieux
            réparti, c'est moins de fatigue, une meilleure ambiance au bloc
            et, in fine, des gestes chirurgicaux plus sûrs.
          </p>
        </article>

        <article class="card">
          <span class="phase-tag">Post-opératoire</span>
          <h2>Colette</h2>
          <p>
            Un chatbot disponible 24h/24 et 7j/7 pour répondre aux
            questions fréquentes des patients transplantés du foie —
            médicaments, alimentation, suivi médical, signes d'alerte —
            réduisant stress et anxiété après la greffe.
          </p>
          <p>
            Développé sous la supervision d'Elise Goyon, infirmière de
            coordination à l'hôpital Paul-Brousse — AP-HP, en collaboration
            avec l'ONG Bayes Impact.
          </p>
        </article>

        <article class="card">
          <span class="phase-tag">À venir</span>
          <h2>PancreaSight</h2>
          <p>Détails à venir.</p>
        </article>

        <article class="card">
          <span class="phase-tag">À venir</span>
          <h2>HEPAT-GREEN</h2>
          <p>Détails à venir.</p>
        </article>
      </div>

      <div class="btn-row">
        <a class="btn" href="/#publications">Voir nos publications</a>
      </div>
    </div>
  </section>
</Base>
