---
import Base from '../layouts/Base.astro';
import { phases } from '../data/projects.js';

// Correctif "gabarit vignettes + carrousel" (2026-08-29) : flèches du
// carrousel, même convention d'icône que le reste du site (24x24,
// stroke="currentColor", stroke-width 1.6).
const chevronLeft =
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const chevronRight =
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<Base
  title="Nos projets - BOPA"
  description="Tous les projets de la Chaire Innovation BOPA, du préopératoire au postopératoire."
>
  <main class="innovations-v2" id="innovations-v2">
    <section class="innovations-v2__intro innovations-v2__intro--dark" aria-labelledby="innovations-title">
      <div class="innovations-v2__container innovations-v2__intro-grid">
        <div class="innovations-v2__intro-copy">
          <p class="innovations-v2__breadcrumb">Accueil <span aria-hidden="true">›</span> Nos projets</p>
          <h1 id="innovations-title">Nos <span>innovations</span></h1>
          <p class="innovations-v2__lead">
            Des idées nées sur le terrain, portées par les équipes du bloc opératoire : voici tous
            les projets de la Chaire, à chaque étape du parcours patient.
          </p>
        </div>

        <div class="innovations-v2__journey" aria-label="Les trois temps du parcours chirurgical">
          <div class="innovations-v2__journey-line" aria-hidden="true"></div>

          <div class="innovations-v2__journey-step">
            <div class="innovations-v2__journey-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="13"/><circle cx="32" cy="32" r="4"/><path d="M32 7v10M32 47v10M7 32h10M47 32h10"/></svg>
            </div>
            <strong>PRÉOPÉRATOIRE</strong>
            <span>Mieux comprendre<br />pour mieux planifier</span>
          </div>

          <div class="innovations-v2__journey-step">
            <div class="innovations-v2__journey-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M7 34h12l7-18 11 34 8-24 6 8h6"/></svg>
            </div>
            <strong>PEROPÉRATOIRE</strong>
            <span>Mieux voir, mieux décider,<br />mieux opérer</span>
          </div>

          <div class="innovations-v2__journey-step">
            <div class="innovations-v2__journey-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M13 49V27M25 49V17M37 49V34M49 49V10"/><path d="M8 49h48"/></svg>
            </div>
            <strong>POSTOPÉRATOIRE</strong>
            <span>Mieux suivre<br />pour mieux guérir</span>
          </div>
        </div>
      </div>
    </section>

    <div class="innovations-v2__filters-band">
      <div class="innovations-v2__container">
        <nav class="innovations-v2__filters" aria-label="Filtrer les projets">
          <button type="button" class="is-active" data-project-filter="all" aria-pressed="true">Tous les projets</button>
          {phases.map((phase) => (
            <button
              type="button"
              data-project-filter={phase.id}
              data-filter-tone={phase.id === 'medico-economique' ? 'gold' : 'blue'}
              aria-pressed="false"
            >
              {phase.label}
            </button>
          ))}
        </nav>
      </div>
    </div>

    <div class="innovations-v2__catalogue">
      <div class="innovations-v2__container">
        {phases.map((phase) => (
          <section
            class={`innovations-v2__category ${phase.id === 'medico-economique' ? 'innovations-v2__category--gold' : ''}`}
            data-project-category={phase.id}
            aria-labelledby={`category-${phase.id}`}
          >
            <aside class="innovations-v2__category-label">
              <div class={`innovations-v2__category-icon innovations-v2__category-icon--${phase.icon}`} aria-hidden="true">
                {phase.icon === 'target' && <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="13"/><circle cx="32" cy="32" r="4"/><path d="M32 7v10M32 47v10M7 32h10M47 32h10"/></svg>}
                {phase.icon === 'pulse' && <svg viewBox="0 0 64 64"><path d="M7 34h12l7-18 11 34 8-24 6 8h6"/></svg>}
                {phase.icon === 'chart' && <svg viewBox="0 0 64 64"><path d="M13 49V27M25 49V17M37 49V34M49 49V10"/><path d="M8 49h48"/></svg>}
                {phase.icon === 'euro' && <span>€</span>}
              </div>
              <div>
                <h2 id={`category-${phase.id}`}>{phase.label.toUpperCase()}</h2>
                <p>{phase.tagline}</p>
              </div>
            </aside>

            <div class="innovations-v2__row" data-innovations-row>
              <div
                class="innovations-v2__row-viewport"
                data-innovations-viewport
                tabindex="0"
                aria-label={`Projets ${phase.label} - défilement horizontal`}
              >
                <div class="innovations-v2__row-track" data-innovations-track>
                  {phase.projects.map((project) => {
                    return (
                      <article class="bopa-project-card" data-innovation-card>
                        <div class="bopa-project-card__media">
                          <img src={project.image} alt="" loading="lazy" />
                        </div>
                        <div class="bopa-project-card__body">
                          <h3>{project.name}</h3>
                          <p>{project.description}</p>
                          {project.action && (
                            <a
                              class="innovations-v2__card-action"
                              href={project.action.href}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {project.action.type === 'video' && <span aria-hidden="true">▶</span>}
                              <span>{project.action.label}</span>
                              {project.action.type === 'external' && <span aria-hidden="true">↗</span>}
                            </a>
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
              <div class="innovations-v2__row-fade innovations-v2__row-fade--left" aria-hidden="true"></div>
              <div class="innovations-v2__row-fade innovations-v2__row-fade--right" aria-hidden="true"></div>
              <button
                type="button"
                class="innovations-v2__row-arrow innovations-v2__row-arrow--left"
                data-innovations-prev
                aria-label={`Voir les projets précédents (${phase.label})`}
                hidden
                set:html={chevronLeft}
              />
              <button
                type="button"
                class="innovations-v2__row-arrow innovations-v2__row-arrow--right"
                data-innovations-next
                aria-label={`Voir les projets suivants (${phase.label})`}
                hidden
                set:html={chevronRight}
              />
            </div>
          </section>
        ))}
      </div>
    </div>

    <section class="innovations-v2__cta">
      <div class="innovations-v2__container">
        <div class="innovations-v2__cta-inner">
          <div class="innovations-v2__cta-icon" aria-hidden="true">
            <svg viewBox="0 0 64 64"><circle cx="32" cy="22" r="10"/><path d="M13 53c2-14 10-21 19-21s17 7 19 21"/></svg>
          </div>
          <div class="innovations-v2__cta-copy">
            <h2>Vous avez une idée de projet ?<br /><span>Construisons-la ensemble.</span></h2>
            <p>Nous collaborons avec des équipes cliniques, académiques et industrielles pour accélérer l'innovation chirurgicale.</p>
          </div>
          <a class="innovations-v2__cta-button" href="/#nous-contacter">Nous contacter <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Onglets client-side, sans framework : masque/affiche les sections de
  // catégorie, pas de rechargement de page. Garde anti-double-init pour
  // la navigation client-side d'Astro (transitions/HMR).
  const root = document.querySelector('#innovations-v2');
  if (root && !root.hasAttribute('data-filters-ready')) {
    root.setAttribute('data-filters-ready', 'true');
    const buttons = Array.from(root.querySelectorAll('[data-project-filter]'));
    const sections = Array.from(root.querySelectorAll('[data-project-category]'));

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-project-filter') || 'all';

        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        sections.forEach((section) => {
          const visible = filter === 'all' || section.getAttribute('data-project-category') === filter;
          section.toggleAttribute('hidden', !visible);
        });

        // Une rangée masquée par un filtre a un scrollWidth/clientWidth de 0
        // tant qu'elle est display:none - recalculer l'état des flèches/du
        // fondu une fois qu'un filtre la rend à nouveau visible.
        requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
      });
    });
  }
</script>

<script>
  // Rangées de vignettes en carrousel horizontal (correctif "gabarit
  // vignettes + carrousel", 2026-08-29) - adapté du modèle de logique
  // fourni dans le pack : IntersectionObserver/ResizeObserver + scroll
  // natif, aucune librairie. Le scroll horizontal natif + scroll-snap
  // (CSS) gèrent déjà swipe tactile/trackpad/molette ; ce script ne fait
  // que piloter les flèches et l'état du fondu.
  const rowsRoot = document.querySelector('#innovations-v2');
  if (rowsRoot && !rowsRoot.hasAttribute('data-rows-ready')) {
    rowsRoot.setAttribute('data-rows-ready', 'true');

    rowsRoot.querySelectorAll<HTMLElement>('[data-innovations-row]').forEach((row) => {
      const viewport = row.querySelector<HTMLElement>('[data-innovations-viewport]');
      const track = row.querySelector<HTMLElement>('[data-innovations-track]');
      const prev = row.querySelector<HTMLButtonElement>('[data-innovations-prev]');
      const next = row.querySelector<HTMLButtonElement>('[data-innovations-next]');
      const card = row.querySelector<HTMLElement>('[data-innovation-card]');

      if (!viewport || !track || !card) return;

      const getStep = () => {
        const cardWidth = card.getBoundingClientRect().width;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0');
        return cardWidth + gap;
      };

      const update = () => {
        const max = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
        const x = viewport.scrollLeft;
        const epsilon = 4;
        const canLeft = x > epsilon;
        const canRight = x < max - epsilon;

        row.dataset.canScrollLeft = String(canLeft);
        row.dataset.canScrollRight = String(canRight);

        if (prev) prev.hidden = !canLeft;
        if (next) next.hidden = !canRight;
      };

      prev?.addEventListener('click', () => {
        viewport.scrollBy({ left: -getStep(), behavior: 'smooth' });
      });

      next?.addEventListener('click', () => {
        viewport.scrollBy({ left: getStep(), behavior: 'smooth' });
      });

      viewport.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      new ResizeObserver(update).observe(viewport);

      update();
    });
  }
</script>

<style>
  /* ============================================================
     BOPA - /nos_innovations/ V2 (renamed 2026-08-27, was /innovations/)
     Référence : REFERENCE-INNOVATIONS-V2.png (2026-08-27)
     Les vignettes projets réutilisent .bopa-project-card telles quelles
     (site.css, même composant que "Nos projets phares" sur la home) -
     ce fichier ne redéfinit que la mise en page propre à cette page
     (intro, frise, onglets, regroupement par catégorie, CTA).
     ============================================================ */

  .innovations-v2 {
    --bopa-navy: var(--color-navy);
    --bopa-blue: var(--color-accent);
    --bopa-blue-strong: var(--bopa-blue-3, #03a2da);
    --bopa-ink: var(--color-ink);
    --bopa-muted: var(--color-muted);
    --bopa-border: var(--color-line);
    --bopa-bg: var(--color-bg-tint);
    --bopa-white: #ffffff;
    /* Filtres uniquement (2026-08-27, finitions V2) : le bleu nuit exact
       du bloc haut (--mp-navy), légèrement plus clair ET plus saturé, pas
       simplement mélangé à du blanc (ça désature et tire vers le gris -
       correctif de la V1). OKLCH + syntaxe relative "from" : on bouge la
       luminosité (L) et la chroma (C) tout en gardant la teinte (H)
       identique, donc toujours "franchement bleu nuit", jamais gris ni
       cyan. Le bloc haut lui-même reste sur --mp-navy tel quel. */
    --bopa-filter-navy: oklch(from var(--mp-navy) calc(l + 0.06) calc(c + 0.03) h);
    color: var(--bopa-ink);
    background: var(--bopa-bg);
  }

  .innovations-v2 *,
  .innovations-v2 *::before,
  .innovations-v2 *::after {
    box-sizing: border-box;
  }

  /* Largeur alignée sur le container réel des grandes sections de la HOME
     (correctif "gabarit vignettes + carrousel", 2026-08-29) : 1320px,
     même valeur et même logique de padding-inline (64px = 2rem de
     chaque côté) que .bopa-mission-v2__inner/.bopa-vision-v4__inner/
     .bopa-projects-v2__inner/.bopa-contact__inner/.bopa-support__inner.
     Cette page utilisait 1500px, un cran plus large - HOME reste la
     référence, jamais l'inverse. */
  .innovations-v2__container {
    width: min(1320px, calc(100% - 64px));
    margin-inline: auto;
  }

  /* Intro ---------------------------------------------------- */
  .innovations-v2__intro {
    background: var(--bopa-white);
    padding: clamp(42px, 5vw, 78px) 0 44px;
  }

  /* Bloc haut en bleu nuit (2026-08-27, correctif Hero/CTA) : englobe
     titre + intro + frise Pré/Per/Post, s'arrête avant les filtres, qui
     restent dans leur propre bande claire juste en dessous (voir
     .innovations-v2__filters-band). Reprend var(--mp-navy) tel quel -
     même bleu nuit que Notre Mission - jamais une nouvelle nuance. */
  .innovations-v2__intro--dark {
    background: var(--mp-navy);
  }
  .innovations-v2__intro--dark .innovations-v2__breadcrumb {
    color: rgba(255, 255, 255, 0.6);
  }
  .innovations-v2__intro--dark .innovations-v2__intro-copy h1,
  .innovations-v2__intro--dark .innovations-v2__intro-copy h1 span {
    color: #fff;
  }
  .innovations-v2__intro--dark .innovations-v2__lead {
    color: rgba(255, 255, 255, 0.88);
  }
  .innovations-v2__intro--dark .innovations-v2__journey-step span {
    color: rgba(255, 255, 255, 0.94);
  }
  .innovations-v2__intro--dark .innovations-v2__journey-icon {
    color: var(--bopa-cyan);
  }
  .innovations-v2__intro--dark .innovations-v2__journey-line::before,
  .innovations-v2__intro--dark .innovations-v2__journey-line::after {
    background: var(--bopa-cyan);
  }

  .innovations-v2__filters-band {
    background: var(--bopa-white);
    padding: 28px 0 34px;
  }

  .innovations-v2__intro-grid {
    display: grid;
    grid-template-columns: minmax(290px, 0.78fr) minmax(620px, 1.55fr);
    column-gap: clamp(52px, 8vw, 128px);
    row-gap: 34px;
    align-items: center;
  }

  .innovations-v2__intro-copy {
    align-self: start;
  }

  .innovations-v2__breadcrumb {
    margin: 0 0 26px;
    font-size: 0.92rem;
    color: var(--bopa-muted);
  }
  .innovations-v2__breadcrumb span {
    margin-inline: 8px;
  }

  /* Harmonisation typographique Niveau 1 (2026-08-27) : mêmes métriques
     que le H2 de Notre Mission (étalon). */
  .innovations-v2 h1 {
    margin: 0;
    font-size: clamp(2rem, 3.1vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 600;
    color: var(--bopa-ink);
    max-width: 8ch;
  }
  .innovations-v2 h1 span {
    display: block;
    color: var(--bopa-blue);
  }

  .innovations-v2__lead {
    max-width: 470px;
    margin: 28px 0 0;
    font-size: clamp(1rem, 1.18vw, 1.18rem);
    line-height: 1.72;
    color: var(--bopa-muted);
  }

  /* Journey (frise Pré/Per/Post) ------------------------------ */
  .innovations-v2__journey {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    min-width: 0;
    padding-top: 34px;
  }

  .innovations-v2__journey-line {
    position: absolute;
    top: 64px;
    left: 16.66%;
    right: 16.66%;
    height: 1px;
    border-top: 1px dashed var(--bopa-cyan);
    z-index: 0;
  }
  .innovations-v2__journey-line::before,
  .innovations-v2__journey-line::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bopa-blue);
  }
  .innovations-v2__journey-line::before {
    left: 25%;
  }
  .innovations-v2__journey-line::after {
    right: 25%;
  }

  .innovations-v2__journey-step {
    position: relative;
    z-index: 1;
    text-align: center;
    min-width: 0;
  }

  .innovations-v2__journey-icon,
  .innovations-v2__category-icon {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    margin: 0 auto 20px;
    border: 1.5px solid var(--bopa-cyan);
    border-radius: 50%;
    background: var(--bopa-white);
    color: var(--bopa-ink);
  }
  .innovations-v2__journey-icon svg,
  .innovations-v2__category-icon svg,
  .innovations-v2__cta-icon svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .innovations-v2__journey-step strong {
    display: block;
    margin-bottom: 16px;
    color: var(--bopa-blue-strong);
    font-size: 0.93rem;
    letter-spacing: 0.015em;
  }
  .innovations-v2__journey-step span {
    display: block;
    color: var(--bopa-ink);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* Filters (onglets) ----------------------------------------- */
  .innovations-v2__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }

  /* Filtres sur une déclinaison du bleu nuit éclaircie de 7% (2026-08-27,
     finitions V1) : --bopa-filter-navy, définie plus haut dans .innovations-v2
     à partir de --mp-navy - le bloc haut de page reste sur --mp-navy tel
     quel, seuls les filtres respirent un peu plus sur le fond clair. */
  .innovations-v2__filters button {
    appearance: none;
    border: 1px solid var(--bopa-filter-navy);
    background: transparent;
    color: var(--bopa-filter-navy);
    min-height: 44px;
    padding: 10px 24px;
    border-radius: 999px;
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    transition: background-color .18s ease, color .18s ease, border-color .18s ease, transform .18s ease;
  }
  .innovations-v2__filters button:hover {
    transform: translateY(-1px);
    border-color: var(--bopa-filter-navy);
  }
  .innovations-v2__filters button.is-active {
    background: var(--bopa-filter-navy);
    border-color: var(--bopa-filter-navy);
    color: var(--bopa-white);
  }
  .innovations-v2__filters button:focus-visible,
  .bopa-project-card:focus-visible,
  .innovations-v2__cta-button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--bopa-cyan) 35%, transparent);
    outline-offset: 3px;
  }

  /* Catalogue: regroupement par catégorie ---------------------- */
  .innovations-v2__catalogue {
    background: var(--bopa-bg);
  }

  .innovations-v2__category {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 30px;
    padding: 30px 0 28px;
    border-bottom: 1px solid var(--bopa-border);
  }
  .innovations-v2__category[hidden] {
    display: none;
  }

  .innovations-v2__category-label {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding-top: 2px;
  }

  .innovations-v2__category-icon {
    flex: 0 0 58px;
    width: 58px;
    height: 58px;
    margin: 0;
    color: var(--bopa-blue-strong);
  }
  .innovations-v2__category-icon span {
    font-size: 1.9rem;
    line-height: 1;
    font-weight: 500;
  }

  .innovations-v2__category-label h2 {
    margin: 7px 0 12px;
    color: var(--bopa-blue-strong);
    font-size: 0.96rem;
    line-height: 1.2;
    letter-spacing: .015em;
    font-weight: 700;
  }
  .innovations-v2__category-label p {
    margin: 0;
    max-width: 175px;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--bopa-ink);
  }

  /* Rangée de vignettes en carrousel horizontal (correctif "gabarit
     vignettes + carrousel", 2026-08-29) - .bopa-project-card fournit déjà
     tout le visuel de la carte (site.css) ; ce bloc ne pose que la mise
     en page de la rangée + le carrousel. Gabarit = LiverSight, mesuré en
     place avant ce correctif (270px de large, 410px de haut, 184px de
     zone image, déjà la valeur de .bopa-project-card/.bopa-project-card__media
     partagées avec la home) : chaque carte passe d'une largeur flexible
     (flex:1 1 0, 205-270px variable selon le nombre de cartes de la
     rangée - la cause du gabarit incohérent d'une catégorie à l'autre) à
     une largeur FIXE identique partout, la rangée devenant scrollable
     plutôt que les cartes rétrécissant.
     Marge haute/basse sur .innovations-v2__row-track (pas sur le
     viewport) : overflow-x: auto sur le viewport force aussi son propre
     overflow-y à "auto", et sans marge la carte se ferait rogner par ce
     même viewport au survol (translateY) - la marge doit donc vivre sur
     l'élément qui bouge (track), pas sur celui qui coupe (viewport). */
  .innovations-v2__row {
    position: relative;
  }

  .innovations-v2__row-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    overscroll-behavior-inline: contain;
  }
