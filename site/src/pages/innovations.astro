---
import Base from '../layouts/Base.astro';
import { phases } from '../data/projects.js';
---

<Base
  title="Nos projets — BOPA"
  description="Tous les projets de la Chaire Innovation BOPA, du préopératoire au postopératoire."
>
  <section class="section-block">
    <div class="mesh-echo" aria-hidden="true"></div>
    <div class="wrap projets-intro" data-reveal>
      <div>
        <span class="kicker">Innovations</span>
        <h1>Nos projets</h1>
        <p class="lede">
          Des idées nées sur le terrain, portées par les équipes du bloc
          opératoire : voici tous les projets de la Chaire, à chaque étape du
          parcours patient.
        </p>
      </div>
      <div class="phases-image">
        <img
          src="/images/graphics/phases.png"
          alt="Frise du parcours patient en trois phases : phase 1 préopératoire (mieux communiquer), phase 2 peropératoire (mieux analyser), phase 3 postopératoire (mieux suivre)."
        />
      </div>
    </div>

    {phases.map((phase) => (
      <div class="wrap section-sub" data-reveal>
        <span class="phase-tag" style={`--step-color: ${phase.step}`}>{phase.label}</span>
        <h2>{phase.subtitle}</h2>
        <div class="card-grid">
          {phase.projects.map((project) => {
            const Tag = project.href ? 'a' : 'article';
            return (
              <Tag
                class="card"
                style={`border-top-color: ${phase.step}`}
                href={project.href}
                target={project.href && '_blank'}
                rel={project.href && 'noopener'}
              >
                <h3>{project.name}</h3>
                <p>{project.text}</p>
                {project.photo && (
                  <div class="card-photo">
                    <img src={project.photo.src} alt={project.photo.alt} loading="lazy" />
                  </div>
                )}
                {project.videoId && (
                  <div class="card-video">
                    <iframe
                      src={`https://www.youtube-nocookie.com/embed/${project.videoId}`}
                      title={`Vidéo de présentation - ${project.name}`}
                      loading="lazy"
                      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    ></iframe>
                  </div>
                )}
              </Tag>
            );
          })}
        </div>
      </div>
    ))}
  </section>
</Base>

<style>
  /* .section-sub lives in index.astro's own scoped <style> - redeclared
     here since Astro doesn't share page-scoped styles across pages. */
  .section-sub {
    margin-top: var(--space-4);
  }

  .section-sub .phase-tag {
    font-size: var(--text-base);
    padding: 0.45em 1.1em;
    margin-bottom: var(--space-3);
  }

  /* Side by side per the owner's request - collapses to stacked below
     40rem, same no-split-screens-on-mobile rule as everywhere else. */
  .projets-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-5);
  }

  @media (max-width: 40rem) {
    .projets-intro {
      grid-template-columns: 1fr;
    }
  }

  /* The PNG already has native transparency, so no CSS mask/fade is
     needed (same treatment as the homepage's .approche-image). */
  .phases-image img {
    width: 100%;
    display: block;
    margin: 0 auto;
  }

  /* Cards in the same row stretch to match their tallest sibling (grid
     default) so each phase's projects read as same-size blocks on
     computers. Fixed 3 columns per feedback (was auto-fit); a phase
     with a project count not divisible by 3 just leaves a short last
     row, which is fine. */
  .card-grid {
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
  }

  @media (max-width: 40rem) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }

  .card p {
    text-align: justify;
    hyphens: none;
  }

  /* Uncovr's card is a real link (see Tag above) - undo the global `a`
     color/underline so it still reads as a plain card. */
  a.card {
    text-decoration: none;
    color: inherit;
  }

  /* Stretched cards (see .card-grid above) leave slack below their
     content on the shorter ones. Flex column + margin-top: auto on the
     media collects that slack right above the image/video instead,
     so every picture lands flush with the card's bottom edge. */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* h3's own margin-bottom (global rule) would otherwise stack with the
     flex gap above and double the title-to-text spacing. */
  .card h3 {
    margin-bottom: 0;
  }

  .card-video {
    margin-top: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card-video iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .card-photo {
    margin-top: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

