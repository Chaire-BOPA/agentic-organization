  .bopa-vision-v4__timeline {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(100px, .72fr)
      minmax(285px, 1fr)
      minmax(285px, 1fr)
      minmax(285px, 1fr)
      minmax(110px, .8fr);
    gap: clamp(1.15rem, 2.4vw, 2.5rem);
    margin-top: clamp(3.8rem, 6vw, 5.6rem);
    align-items: start;
