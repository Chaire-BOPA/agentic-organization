---
import Base from '../layouts/Base.astro';

const partnerLogos = [
  { src: '/logos/partenaires/logo-aphp.png', alt: 'AP-HP - Assistance Publique-Hôpitaux de Paris' },
  { src: '/logos/partenaires/logo-imt.png', alt: 'Institut Mines-Télécom', scale: 0.85 },
  { src: '/logos/partenaires/logo-upsaclay.png', alt: 'Université Paris-Saclay' },
  { src: '/logos/partenaires/logo-faphp.png', alt: 'Fondation AP-HP' },
  { src: '/logos/partenaires/logo-fondation-imt.png', alt: 'Fondation Mines-Télécom', scale: 1.15 },
  { src: '/logos/partenaires/logo-fondation-upsaclay.png', alt: "Fondation de l'Université Paris-Saclay", scale: 1.15 },
  { src: '/logos/partenaires/logo-relyens.png', alt: 'Relyens' },
  { src: '/logos/partenaires/logo-vermon.png', alt: 'Vermon', scale: 0.85 },
];

const team = [
  {
    group: 'Ceux qui font BOPA tous les jours',
    people: [
      { name: 'Charles Hellec', role: 'Directeur de la Chaire BOPA' },
      { name: 'Elie Farah', role: 'Directeur de la plateforme BOPtech' },
    ],
  },
  {
    group: "L'équipe soignante du CHB",
    people: [{ name: 'Pr Éric Vibert', role: 'Chirurgien, Centre Hépato-Biliaire - initiateur de la Chaire' }],
  },
  {
    group: 'Collaborateurs ingénieurs et sciences humaines',
    people: [{ name: 'Axelle Piguet', role: 'Ingénieure' }],
  },
];
---

<Base
  title="BOPA - Chaire Innovation Bloc OPératoire Augmenté"
  description="La Chaire Innovation BOPA invente la chirurgie hépato-bilio-pancréatique de demain, au sein de l'hôpital Paul-Brousse AP-HP."
>
  <section id="accueil" class="section-block dark hero">
    <div class="wrap" data-reveal>
      <h1>Nous façonnons<br />le bloc opératoire<br /><em>de demain.</em></h1>
      <p class="lede">
        La Chaire Innovation BOPA développe des solutions numériques<br />
        innovantes pour améliorer la qualité, la sécurité et l'expérience<br />
        des patients en chirurgie hépato-bilio-pancréatique.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn" href="#projets">Découvrez nos projets</a>
        <a class="btn" href="https://soutenir.fondationaphp.fr/BOPA/" target="_blank" rel="noopener">Nous soutenir</a>
      </div>
    </div>
    <a href="#qui-sommes-nous" class="scroll-cue" aria-label="Découvrir la suite">
      <span>Découvrir</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 1v13M2 8l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section id="qui-sommes-nous" class="section-block">
    <div class="wrap" data-reveal>
      <span class="kicker">La Chaire</span>
      <h2>Qui sommes-nous ?</h2>
      <p class="lede">
        La Chaire Innovation BOPA améliore la qualité et la sécurité des
        soins au bloc opératoire, en chirurgie hépato-bilio-pancréatique, en
        concevant, développant et déployant des solutions numériques basées
        sur l'IA et les jumeaux numériques.
      </p>
      <p>
        Portée par trois membres fondateurs - l'AP-HP, l'Institut
        Mines-Télécom et l'Université Paris-Saclay - elle est installée au
        sein de l'hôpital Paul-Brousse (GHU AP-HP Université Paris-Saclay),
        à proximité directe du Centre Hépato-Biliaire (CHB), 1er centre de
        transplantation hépatique et chirurgie hépato-bilio-pancréatique en
        France.
      </p>
      <p class="text-muted">
        Un enjeu qui reste entier : six mois après une transplantation
        hépatique, la mortalité avoisine encore les 10 %.
      </p>
    </div>
    <div class="wrap">
      <div class="stat-row">
        <div class="stat">
          <span class="stat-value" data-reveal>1500</span>
          <span class="stat-label">Actes par an au bloc (chirurgies et procédures radiologiques)</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.1s">200</span>
          <span class="stat-label">Greffes de foie ou de pancréas par an</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.2s">500</span>
          <span class="stat-label">Cancers hépato-bilio-pancréatiques traités par an</span>
        </div>
      </div>
    </div>
    <div class="wrap partners-block" data-reveal style="--reveal-delay: 0.1s">
      <p class="partners-label">Nos membres fondateurs et partenaires</p>
      <div class="logo-marquee">
        <div class="logo-marquee-track">
          {partnerLogos.map((logo) => (
            <img src={logo.src} alt={logo.alt} loading="lazy" style={`--logo-scale: ${logo.scale ?? 1}`} />
          ))}
          {partnerLogos.map((logo) => (
            <img src={logo.src} alt="" aria-hidden="true" loading="lazy" style={`--logo-scale: ${logo.scale ?? 1}`} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="approche" class="section-block">
    <div class="wrap" data-reveal>
      <span class="kicker">Notre approche</span>
      <h2>La vision : de l'innovation exclusive au progrès universel</h2>
      <p class="lede">
        Une conviction de sciences humaines guide chaque projet : une
        innovation n'a de valeur que si elle est adoptée. Trois exigences
        cadrent tout ce que la Chaire construit.
      </p>
    </div>
    <div class="wrap">
      <div class="card-grid">
        <div class="card">
          <h3>Acceptabilité</h3>
          <p>Des solutions numériques co-construites et validées par les soignants.</p>
        </div>
        <div class="card">
          <h3>Interopérabilité</h3>
          <p>Des systèmes capables de s'intégrer partout.</p>
        </div>
        <div class="card">
          <h3>Soutenabilité</h3>
          <p>Une approche éthique, responsable financièrement, et sobre en carbone.</p>
        </div>
      </div>
    </div>

    <div class="wrap section-sub">
      <span class="kicker">Notre approche</span>
      <h2>Le projet scientifique : augmenter le parcours patient</h2>
      <p class="lede">
        BOPA2 (2025-2030) améliore la qualité et la sécurité des soins à
        chaque étape de la chirurgie.
      </p>
      <div class="pipeline">
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-1); --reveal-delay: 0s">
          <div class="pipeline-dot">1</div>
          <h3>Pré-opératoire</h3>
          <p>De l'importance de la communication.</p>
        </div>
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-2); --reveal-delay: 0.1s">
          <div class="pipeline-dot">2</div>
          <h3>Per-opératoire</h3>
          <p>De l'importance de l'analyse du réel.</p>
        </div>
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-3); --reveal-delay: 0.2s">
          <div class="pipeline-dot">3</div>
          <h3>Post-opératoire</h3>
          <p>De l'importance du suivi.</p>
        </div>
      </div>
    </div>

    <div class="wrap section-sub">
      <span class="kicker">Notre approche</span>
      <h2>La méthode</h2>
      <p class="lede">
        Trois degrés de maturité pour travailler avec la Chaire, dans un
        espace de 158 m² incluant un bloc opératoire factice, mis à
        disposition par l'hôpital Paul-Brousse AP-HP. Les solutions
        finalisées sont validées au bloc opératoire du Centre
        Hépato-Biliaire.
      </p>
      <div class="card-grid">
        <div class="card">
          <h3>Prototyper</h3>
          <p>Concevoir des preuves de concept (POC).</p>
        </div>
        <div class="card">
          <h3>Codévelopper</h3>
          <p>Construire de nouvelles solutions avec la Chaire.</p>
        </div>
        <div class="card">
          <h3>Tester</h3>
          <p>Évaluer des solutions existantes : α-test, β-test, test d'acceptance et test clinique.</p>
        </div>
      </div>
      <div class="stat-row">
        <div class="stat">
          <span class="stat-value" data-reveal>1.6M€</span>
          <span class="stat-label">Mécénat collecté depuis 2020</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.1s">50</span>
          <span class="stat-label">Publications scientifiques</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.2s">2</span>
          <span class="stat-label">Start-up créées (DOTs, Uncovr)</span>
        </div>
      </div>
    </div>
  </section>

  <section id="projets" class="section-block dark">
    <div class="wrap" data-reveal>
      <span class="kicker">Innovations</span>
      <h2>Nos projets et réalisations</h2>
      <p class="lede">
        Des chiffres à l'impact concret : ce que la Chaire a bâti, et ce
        qu'elle construit aujourd'hui à chaque étape du parcours patient.
      </p>
    </div>

    <div class="wrap accordion">
      <details class="accordion-item accordion-item-lg">
        <summary>
          <svg class="accordion-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <path d="M4 24h20M6 24V11l8-6 8 6v13M11 24v-7h6v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="accordion-title">Les réalisations institutionnelles</span>
          <svg class="accordion-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="accordion-panel">
          <div class="accordion-subgrid">
            <details class="accordion-subitem">
              <summary>
                <span class="accordion-subtitle">Le tiers-lieu d'expérimentation BOPEX</span>
                <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="accordion-subpanel">
                <p>
                  Créé en 2023, situé à l'hôpital Broussais à côté du Campus
                  chirurgical du Grand Paris, BOPEX accélère le
                  développement d'innovations numériques et technologiques
                  pour le bloc opératoire : start-up, entreprises tech,
                  innovateurs internes AP-HP et professionnels de santé y
                  testent leurs solutions en conditions réelles.
                </p>
                <p>
                  Trois piliers d'accompagnement : <strong>derisking</strong>
                  (validation experte de la pertinence clinique et
                  technique), <strong>codéveloppement</strong> (conception de
                  l'interface, structuration des études cliniques) et
                  <strong> test</strong> (utilisabilité, acceptabilité,
                  impact organisationnel).
                </p>
              </div>
            </details>
            <details class="accordion-subitem">
              <summary>
                <span class="accordion-subtitle">La plateforme BOPTECH</span>
                <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="accordion-subpanel">
                <p>
                  Plateforme technologique et scientifique unique, au sein
                  même du bloc opératoire du Centre Hépato-Biliaire :
                  chirurgie guidée par l'image, endoscopie, oncologie
                  hépato-bilio-pancréatique. Financée par l'AP-HP, le Paris
                  Saclay Cancer Cluster et BPI France.
                </p>
                <p>
                  Sa salle hybride, équipée du système Philips Azurion 7 et
                  de capacités IA, sera opérationnelle en juillet 2026.
                  Son modèle préclinique <strong>In Machina</strong>{' '}
                  maintient des foies humains en conditions
                  quasi-physiologiques plusieurs jours, pour tester des
                  innovations avant les essais cliniques - avec l'accès
                  privilégié qu'offrent les 200 transplantations et 150
                  hépatectomies réalisées chaque année au CHB.
                </p>
              </div>
            </details>
          </div>
        </div>
      </details>

      <details class="accordion-item accordion-item-lg">
        <summary>
          <svg class="accordion-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <circle cx="14" cy="14" r="3" stroke="currentColor" stroke-width="1.6" />
            <circle cx="5" cy="21" r="2.2" stroke="currentColor" stroke-width="1.6" />
            <circle cx="23" cy="21" r="2.2" stroke="currentColor" stroke-width="1.6" />
            <circle cx="14" cy="5" r="2.2" stroke="currentColor" stroke-width="1.6" />
            <path d="M14 8v3M11.5 15.8 6.6 19.3M16.5 15.8l4.9 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <span class="accordion-title">Des exemples de projets innovants made in BOPA</span>
          <svg class="accordion-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="accordion-panel">
          <div class="phase-grid">
            <details class="phase-card" style="--step-color: var(--color-step-1)">
              <summary>
                <span class="phase-title">Préopératoire</span>
                <span class="phase-subtitle">Communiquer</span>
              </summary>
              <div class="accordion-subpanel">
                <div class="project-entry">
                  <h4>LiverSight</h4>
                  <p>
                    Communication médecin-patient en 3D avant l'opération. En
                    partenariat avec Toys Films, sous la supervision du Dr
                    Oriana Ciacio et du Pr Éric Vibert.
                  </p>
                </div>
                <div class="project-entry">
                  <h4>PancreasSight</h4>
                  <p>
                    La même approche appliquée à la chirurgie pancréatique,
                    en partenariat avec Toys Films et le Dr Gabriella Pittau.
                  </p>
                </div>
              </div>
            </details>
            <details class="phase-card" style="--step-color: var(--color-step-2)">
              <summary>
                <span class="phase-title">Peropératoire</span>
                <span class="phase-subtitle">Assister le chirurgien</span>
              </summary>
              <div class="accordion-subpanel">
                <div class="project-entry">
                  <h4>BOPCAM</h4>
                  <p>
                    Un casque qui filme les mains du chirurgien en chirurgie
                    ouverte : analyse d'images en direct, compte-rendu
                    opératoire augmenté, télé-expertise.
                  </p>
                </div>
                <div class="project-entry">
                  <h4>Henri</h4>
                  <p>
                    Un assistant conçu pour accompagner le chirurgien pendant
                    l'opération : informations fiables sur le patient,
                    checklist, antécédents.
                  </p>
                </div>
                <div class="project-entry">
                  <h4>De l'analyse d'image à la start-up</h4>
                  <p>
                    Le travail sur l'analyse d'images au bloc opératoire a
                    donné naissance à <strong>Uncovr</strong>, une start-up
                    née d'un besoin de terrain identifié par les équipes.
                  </p>
                </div>
              </div>
            </details>
            <details class="phase-card" style="--step-color: var(--color-step-3)">
              <summary>
                <span class="phase-title">Postopératoire</span>
                <span class="phase-subtitle">Suivre les patients</span>
              </summary>
              <div class="accordion-subpanel">
                <div class="project-entry">
                  <h4>Colette</h4>
                  <p>
                    Un chatbot qui accompagne 24h/24 les patients
                    transplantés du foie, né d'un besoin identifié
                    directement par les soignants.
                  </p>
                </div>
                <div class="project-entry">
                  <h4>Suivi longitudinal et valeur en santé</h4>
                  <p>
                    Aligné sur l'axe VBHC de l'AP-HP : évaluer la qualité de
                    vie du patient via des questionnaires PROM et PREM, pour
                    identifier des leviers d'amélioration des soins.
                  </p>
                </div>
                <div class="project-entry">
                  <h4>Quelle place pour le ressenti du chirurgien ?</h4>
                  <p>
                    Corréler l'état émotionnel du chirurgien au résultat
                    clinique et au ressenti du patient, pour en faire un
                    levier d'action à part entière.
                  </p>
                </div>
              </div>
            </details>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section id="equipe" class="section-block">
    <div class="wrap" data-reveal>
      <span class="kicker">La Chaire</span>
      <h2>Notre équipe</h2>
      <p class="lede">
        Des soignants AP-HP, des ingénieurs IMT &amp; INRIA et des
        chercheurs Paris-Saclay &amp; CNAM, réunis autour d'un même terrain.
      </p>
    </div>
    {team.map((group) => (
      <div class="wrap team-group">
        <h3>{group.group}</h3>
        <div class="card-grid">
          {group.people.map((person) => (
            <div class="card person-card">
              <p class="person-name">{person.name}</p>
              <p class="person-role">{person.role}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section id="soutenir" class="section-block dark donate">
    <div class="wrap" data-reveal>
      <h2>Nous soutenir</h2>
      <p class="lede">
        La Chaire fonctionne par mécénat - 1,6 M€ collectés depuis sa
        création en 2020. Ce soutien finance la recherche, le
        développement de nos outils et l'équipement du bloc opératoire.
        Chaque don accélère la recherche et l'innovation.
      </p>
      <div class="btn-row">
        <a class="btn" href="https://soutenir.fondationaphp.fr/BOPA/" target="_blank" rel="noopener">Faire un don</a>
      </div>
    </div>

    <div class="wrap">
      <div class="soutenir-form-card" data-reveal style="--reveal-delay: 0.15s">
        <h3>Nous contacter</h3>
        <p>Une question, un projet à proposer ? Écrivez-nous directement.</p>
        <form id="soutenir-form" class="contact-form" novalidate>
          <div class="form-field">
            <label for="nom">Nom</label>
            <input type="text" id="nom" name="nom" required />
          </div>
          <div class="form-field">
            <label for="prenom">Prénom</label>
            <input type="text" id="prenom" name="prenom" required />
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn">Envoyer</button>
          <p class="form-note">
            En cliquant sur Envoyer, votre messagerie s'ouvre avec ce
            message prérempli, adressé directement à la Chaire.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('soutenir-form') as HTMLFormElement | null;

    form?.addEventListener('submit', (event) => {
      event.preventDefault();

      const nom = (document.getElementById('nom') as HTMLInputElement).value;
      const prenom = (document.getElementById('prenom') as HTMLInputElement).value;
      const message = (document.getElementById('message') as HTMLTextAreaElement).value;

      const subject = `Contact - ${prenom} ${nom}`;
      const body = [`Nom : ${nom}`, `Prénom : ${prenom}`, '', message].join('\n');

      const mailto = `mailto:charles.hellec@aphp.fr?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailto;
    });

    // Accordions: closing sibling <details> when one opens, so only one
    // panel per level is expanded at a time (keeps the page scannable).
    const closeSiblings = (el: HTMLDetailsElement) => {
      const parent = el.parentElement;
      if (!parent) return;
      [...parent.children].forEach((sibling) => {
        if (sibling !== el && sibling instanceof HTMLDetailsElement) sibling.open = false;
      });
    };

    document.querySelectorAll<HTMLDetailsElement>('.accordion-item, .accordion-subitem, .phase-card').forEach((el) => {
      el.addEventListener('toggle', () => {
        if (el.open) closeSiblings(el);
      });
    });
  </script>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 1;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    align-items: flex-end;
    text-align: left;
  }

  @media (max-width: 40rem) {
    .hero {
      aspect-ratio: auto;
      min-height: 24rem;
    }
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: url('/photos/hero-bloc-op-v5.jpg') center / contain no-repeat;
  }

  .hero .wrap {
    position: relative;
    z-index: 3;
    margin: 0;
    padding-left: var(--space-3);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    max-width: 56rem;
    margin: 0;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--bopa-blue-4);
  }

  .hero .lede {
    font-size: 1.2rem;
    margin: var(--space-3) 0 0;
    max-width: 40rem;
  }

  .hero-actions {
    justify-content: flex-start;
    margin-top: var(--space-4);
  }

  .hero-actions .btn {
    background: transparent;
    color: #fff;
    box-shadow: inset 0 0 0 1px #fff;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    text-transform: none;
    letter-spacing: normal;
  }

  .hero-actions .btn:hover {
    background: var(--bopa-blue-4);
    color: #fff;
    box-shadow: inset 0 0 0 1px var(--bopa-blue-4);
  }

  .scroll-cue {
    position: absolute;
    z-index: 3;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-dark-ink);
    text-decoration: none;
    font-size: var(--text-sm);
    opacity: 0.85;
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
