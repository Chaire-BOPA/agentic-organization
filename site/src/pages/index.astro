    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 700;
    line-height: 1;
  }
  .about-v2__team-marker-divider {
    width: 2px;
    height: 2.1rem;
    background: rgba(8, 31, 74, 0.4);
    flex-shrink: 0;
  }
  .about-v2__team-marker-title {
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .about-v2__team-intro p {
    margin: 0;
    color: var(--about-ink);
