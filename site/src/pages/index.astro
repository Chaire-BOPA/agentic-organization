  }
  .about-v2__support-logos {
    display: grid;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  .about-v2__support-logos--foundations {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 52rem;
  }
  .about-v2__support-logo {
    min-height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: .8rem 2rem;
  }
  .about-v2__support-logo + .about-v2__support-logo { border-left: 1px solid var(--about-line); }
  .about-v2__support-logo img {
    display: block;
    max-width: 12rem;
