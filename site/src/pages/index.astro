---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';

// Any image dropped into site/public/images/equipe/ becomes a gallery
// slide automatically - see source/brand/assets/equipe/README.md for
// where the owner drops originals. process.cwd() (not import.meta.url)
// because the build bundles this file elsewhere, breaking a
// URL-relative path that only worked in dev. The folder itself may not
// exist (e.g. every photo removed) - same try/catch as team-photos below.
let teamPhotos: { src: string; alt: string }[] = [];
try {
  teamPhotos = readdirSync(join(process.cwd(), 'public', 'images', 'equipe'))
    .filter((file) => /\.(jpe?g|png|webp)$/i.test(file))
    .sort()
    .map((file) => ({
      src: `/images/equipe/${file}`,
      alt: "Un instant avec l'équipe de la Chaire Innovation BOPA.",
    }));
} catch {
  // Folder doesn't exist - no gallery photos dropped in currently.
}

const partnerLogos = [
  { src: '/logos/partenaires/logo-aphp.png', alt: 'AP-HP - Assistance Publique-Hôpitaux de Paris' },
  { src: '/logos/partenaires/logo-imt.png', alt: 'Institut Mines-Télécom', scale: 0.85 },
  { src: '/logos/partenaires/logo-upsaclay.png', alt: 'Université Paris-Saclay' },
  { src: '/logos/partenaires/logo-faphp.png', alt: 'Fondation AP-HP' },
  { src: '/logos/partenaires/logo-fondation-imt.png', alt: 'Fondation Mines-Télécom', scale: 1.15 },
  { src: '/logos/partenaires/logo-fondation-upsaclay.png', alt: "Fondation de l'Université Paris-Saclay", scale: 1.15 },
  { src: '/logos/partenaires/logo-relyens.png', alt: 'Relyens' },
  { src: '/logos/partenaires/logo-vermon.png', alt: 'Vermon', scale: 0.85 },
];

// Real headshots are optional, dropped into site/public/images/team-photos/
// (see source/brand/assets/team-photos/README.md) named after the person's
// slug - a card falls back to initials until a matching file shows up, never
// a fabricated stock photo standing in for a named person.
let teamPhotoFiles: string[] = [];
try {
  teamPhotoFiles = readdirSync(join(process.cwd(), 'public', 'images', 'team-photos')).filter((file) =>
    /\.(jpe?g|png|webp)$/i.test(file)
  );
} catch {
  // Folder doesn't exist yet - no headshots dropped in so far.
}

const slugify = (name: string) =>
  name
    .replace(/^(Pr|Dr)\s+/i, '')
    .normalize('NFD')
    .replace(/[\u0300-\u036F]/g, '')
    .toLowerCase()
    .trim()
    .replace(/\s+/g, '-');

const team = [
  { name: 'Pr Éric Vibert', credentials: 'MD, PhD', role: 'Chirurgien, Centre Hépato‑Biliaire - initiateur de la Chaire', linkedin: 'https://www.linkedin.com/in/eric-vibert-md-phd-iko-koh-bab30469/' },
  { name: 'Charles Hellec', credentials: 'PhD', role: 'Directeur de la Chaire BOPA', linkedin: 'https://www.linkedin.com/in/charles-hellec/' },
  { name: 'Elie Farah', credentials: 'MD', role: 'Directeur de la plateforme BOPtech', linkedin: 'https://www.linkedin.com/in/elie-farha-md/' },
  { name: 'Axelle Piguet', role: 'Ingénieure', linkedin: 'https://fr.linkedin.com/in/axelle-piguet' },
].map((person) => {
  const slug = slugify(person.name);
  const photoFile = teamPhotoFiles.find((file) => file.replace(/\.[^.]+$/, '') === slug);
  return {
    ...person,
    initials: person.name
      .replace(/^(Pr|Dr)\s+/i, '')
      .split(/\s+/)
      .map((word) => word[0])
      .join('')
      .toUpperCase(),
    photo: photoFile ? `/images/team-photos/${photoFile}` : null,
  };
});

// "Qui sommes-nous" (about-v2) - réutilise les mêmes assets réels que
// partnerLogos/team ci-dessus. Chiffres et intitulés validés par la
// propriétaire (pack CLAUDE-INTEGRATION.md, 2026-08-27) ; les liens
// BOpEx/BOPTECH et la photo du CHB sont les vraies ressources du projet,
// jamais les placeholders du pack.
const founders = partnerLogos.slice(0, 3);
const foundationLogos = partnerLogos.slice(3, 6);
const patronLogos = partnerLogos.slice(6, 8);

// Descriptions pour les cartes de la section "Nous soutenir" - alignées
// par index sur foundationLogos/patronLogos ci-dessus.
const foundationDescriptions = [
  "Soutenir l'innovation et la recherche au sein de l'AP-HP pour améliorer la santé de demain.",
  "Accompagner les innovations numériques et technologiques au service de l'intérêt général.",
  "Soutenir la recherche, la formation et l'innovation dans une dynamique interdisciplinaire et collaborative.",
];
const patronDescriptions = [
  "Relyens soutient les projets innovants de la Chaire BOPA au service des patients et des professionnels de santé.",
  "Vermon accompagne la Chaire BOPA dans le développement de solutions innovantes pour la chirurgie de demain.",
];

const researchStats = [
  { value: '55', label: 'Publications' },
  { value: '51', label: 'Communications orales' },
  { value: '7', label: 'Doctorants' },
  { value: '8', label: 'Étudiants en Master' },
];

// Pictogrammes du bandeau bleu "01" - même langage graphique fin/24x24
// que les icônes du bandeau institutionnel sous le Hero (#environnement).
const bandIcons = [
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 8h8M8 12h8M8 16h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M6 11a6 6 0 0 0 12 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 17v4M9 21h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4 2 9l10 5 10-5-10-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 10v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 20c0-3 2.5-5 5.5-5s5.5 2 5.5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="17" cy="9" r="2.4" stroke="currentColor" stroke-width="1.6"/><path d="M15 20c.2-2.2 1.8-3.8 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
];

// "De la recherche à l'impact" (2026-08-28) - remplace les anciens
// blocs "De la recherche au terrain"/"Faire sortir l'innovation du
// laboratoire" (BOpEx/BOPTECH + impactStats), dont le contenu est
// repris et développé ici. Colette/MesGardes sont citées en texte
// (checklist), jamais en logo - aucun asset validé pour ces deux
// projets, conformément à la consigne du pack.
const researchResults = [
  { title: '2 start-ups créées', text: 'pour porter et développer des innovations de rupture' },
  { title: '2 logiciels médicaux déployés', text: 'au plus près des besoins des professionnels de santé' },
  { title: "Colette, chatbot d'éducation thérapeutique", text: 'pour les patients greffés' },
  { title: 'MesGardes, application facilitant la gestion', text: 'des gardes au bloc opératoire' },
];

const impactCheckIcon =
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M8 12.3l2.6 2.6L16.2 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const impactCardIcons = [
  // Fusée - "Des résultats concrets au service du terrain"
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5c2.8 2 4.5 5.6 4.5 9.3 0 2-.8 3.9-1.9 5.1l-.9 2.8-1.7-1.9-1.7 1.9-.9-2.8c-1.1-1.2-1.9-3.1-1.9-5.1 0-3.7 1.7-7.3 4.5-9.3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="10.5" r="1.9" stroke="currentColor" stroke-width="1.6"/><path d="M8.3 16.5l-1.8 2.7M15.7 16.5l1.8 2.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
  // Hôpital - même pictogramme que le bandeau institutionnel sous le Hero
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="9" width="14" height="12" rx="1" stroke="currentColor" stroke-width="1.6" /><path d="M9 3h6v6H9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M12 13v4M10 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>',
];

const clinicalStats = [
  { value: '1 500', label: 'actes au bloc par an' },
  { value: '180', label: 'hépatectomies' },
  { value: '50', label: 'pancréatectomies' },
  { value: '180', label: 'transplantations hépatiques' },
];

// Déposée une fois dans public/photos/centre-hepato-biliaire.(jpg|png|webp),
// la vraie photo apparaît ici automatiquement - même mécanisme que
// team-photos/ ci-dessus. Tant qu'aucun fichier réel n'est présent, la
// section garde un fond uni, jamais une photo générée ou de stock.
const chbPhotoFile = ['jpg', 'jpeg', 'png', 'webp']
  .map((ext) => `centre-hepato-biliaire.${ext}`)
  .find((file) => existsSync(join(process.cwd(), 'public', 'photos', file)));
const chbPhoto = chbPhotoFile ? `/photos/${chbPhotoFile}` : null;
---

<Base
  title="BOPA - Chaire Innovation Bloc OPératoire Augmenté"
  description="La Chaire Innovation BOPA invente la chirurgie hépato-bilio-pancréatique de demain, au sein de l'hôpital Paul-Brousse AP-HP."
>
  <section id="accueil" class="section-block dark hero">
    <!-- 1. Photo brute, intacte : object-fit cover + object-position pour
         cadrer, jamais de filter/blur/scale dessus. -->
    <img
      class="hero-photo"
      src="/photos/hero-bloc-op-natural.jpg"
      alt="Une équipe chirurgicale au bloc opératoire, autour d'un ordinateur affichant une modélisation 3D du foie"
      width="2800"
      height="1758"
    />
    <!-- 2. Calques de teinte : uniquement dégradés/opacités, jamais un filter sur la photo. -->
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="hero-gradient" aria-hidden="true"></div>
    <div class="hero-vignette" aria-hidden="true"></div>
    <!-- 3. Flou de lisibilité, limité à la zone du texte (gauche). -->
    <div class="hero-text-blur" aria-hidden="true"></div>
    <canvas id="hero-network" class="hero-network" aria-hidden="true"></canvas>
    <div class="wrap" data-reveal>
      <h1>Nous façonnons<br />le bloc opératoire<br /><em>de demain.</em></h1>
      <p class="lede">
        La Chaire Innovation BOPA développe des solutions numériques
        innovantes pour améliorer la qualité, la sécurité et l'expérience
        des patients en chirurgie <span class="nowrap">hépato-bilio-pancréatique</span>.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn btn-outline-premium" href="/nos_innovations">Découvrir nos projets</a>
        <a class="btn btn-filled-premium" href="https://soutenir.fondationaphp.fr/BOPA/" target="_blank" rel="noopener">Nous soutenir</a>
      </div>
    </div>
  </section>

  <!-- Bandeau institutionnel : répond en un coup d'œil à "pourquoi
       l'environnement de BOPA est propice à l'innovation" (lieu, proximité
       clinique, accès terrain, co-construction) - jamais la productivité
       scientifique (publications/thèses/projets), qui a sa place plus bas
       dans la page (section Nos projets, section Nous soutenir). Section
       normale dans le flux, aucune marge négative : ne chevauche jamais
       le Hero. -->
  <section id="environnement" class="section-block context-band">
    <div class="context-band-row" data-reveal>
      <div class="context-item">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="5" y="9" width="14" height="12" rx="1" stroke="currentColor" stroke-width="1.6" />
          <path d="M9 3h6v6H9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M12 13v4M10 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <p class="context-text"><span class="context-line">Au cœur de l'hôpital</span><span class="context-line"><strong>Paul-Brousse AP-HP</strong></span></p>
      </div>
      <div class="context-item">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <p class="context-text"><span class="context-line">À proximité immédiate du <strong class="context-nowrap">Centre Hépato-Biliaire</strong></span><span class="context-line"><strong>~180 transplantations hépatiques/an</strong></span></p>
      </div>
      <div class="context-item">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12h13M13 7l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="context-text"><span class="context-line"><strong>Accès direct</strong></span><span class="context-line">au terrain clinique</span></p>
      </div>
      <div class="context-item">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="9" cy="12" r="5" stroke="currentColor" stroke-width="1.6" />
          <circle cx="15" cy="12" r="5" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <p class="context-text"><span class="context-line"><strong>100 %</strong> des projets</span><span class="context-line">co-construits avec les soignants</span></p>
      </div>
    </div>
  </section>

  <section id="notre-mission" class="bopa-mission-v2" aria-labelledby="mission-title">
    <div class="bopa-mission-v2__inner">
      <p class="bopa-eyebrow">Notre mission</p>
      <h2 id="mission-title">Améliorer la chirurgie, grâce au numérique</h2>
      <p class="bopa-mission-v2__intro">
        Nous développons et intégrons des technologies innovantes pour accompagner chaque étape du parcours
        patient en chirurgie, améliorer l'implication des malades, la sécurité de l'acte chirurgical et le
        suivi des patients après l'opération.
      </p>

      <div class="bopa-mission-v2__timeline" role="list" aria-label="Les trois temps du parcours chirurgical">
        <div class="bopa-mission-v2__timeline-line" aria-hidden="true"></div>
        <article class="bopa-mission-v2__step" role="listitem">
          <div class="bopa-mission-v2__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="15" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="32" cy="32" r="5" stroke="currentColor" stroke-width="2.5"/>
              <path d="M32 10v9M32 45v9M10 32h9M45 32h9M17 17l6.5 6.5M40.5 40.5 47 47M47 17l-6.5 6.5M23.5 40.5 17 47" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Préopératoire</h3>
          <p>Mieux comprendre<br />pour mieux planifier</p>
        </article>

        <article class="bopa-mission-v2__step" role="listitem">
          <div class="bopa-mission-v2__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none">
              <path d="M11 34h10l6-16 10 31 7-22 5 7h5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Peropératoire</h3>
          <p>Mieux voir, mieux décider,<br />mieux opérer</p>
        </article>

        <article class="bopa-mission-v2__step bopa-mission-v2__step--postop" role="listitem">
          <div class="bopa-mission-v2__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none">
              <path d="M15 47V34M25 47V24M35 47V38M45 47V17M55 47V29" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M12 50h46" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3>Postopératoire</h3>
          <p>Mieux suivre<br />pour mieux guérir</p>
        </article>
      </div>
    </div>
  </section>

  <section id="innovations-bopa" class="bopa-projects-v2" aria-labelledby="projects-title">
    <div class="bopa-projects-v2__inner">
      <div class="bopa-projects-v2__intro">
        <p class="bopa-eyebrow">Nos innovations</p>
        <h2 id="projects-title">Des projets pensés pour transformer la chirurgie</h2>
        <p>
          De la planification à la récupération, nos projets apportent des réponses concrètes aux défis
          d'aujourd'hui pour préparer la chirurgie de demain.
        </p>
        <a class="bopa-projects-v2__cta" href="/nos_innovations">
          Découvrir nos projets
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="bopa-projects-v2__rail" tabindex="0" aria-label="Projets phares - défilement horizontal sur petit écran">
        <a class="bopa-project-card" href="https://www.youtube.com/watch?v=MF1ysshoNVM" target="_blank" rel="noopener">
          <div class="bopa-project-card__media">
            <img src="/images/projets-v2/liversight.png" alt="Présentation du projet LiverSight" loading="lazy" />
          </div>
          <div class="bopa-project-card__body">
            <h3>LiverSight</h3>
            <p>Un logiciel développé par BOPA pour faciliter les échanges entre le chirurgien et son patient avant une chirurgie du foie, mieux comprendre l'intervention et rendre le patient acteur de sa prise en charge.</p>
          </div>
        </a>

        <a class="bopa-project-card" href="/nos_innovations">
          <div class="bopa-project-card__media">
            <img src="/images/projets-v2/bopcam.png" alt="Présentation du projet BOPCAM" loading="lazy" />
          </div>
          <div class="bopa-project-card__body">
            <h3>BOPCAM</h3>
            <p>Un dispositif « made in BOPA » pour filmer au plus près les mains et les gestes du chirurgien en chirurgie ouverte.</p>
          </div>
        </a>

        <a class="bopa-project-card" href="/nos_innovations">
          <div class="bopa-project-card__media">
            <img src="/images/projets-v2/goldfinger.png" alt="Présentation du projet Goldfinger" loading="lazy" />
          </div>
          <div class="bopa-project-card__body">
            <h3>Goldfinger</h3>
            <p>Interagir simplement et à distance avec les images médicales, sans jamais rompre la stérilité.</p>
          </div>
        </a>

        <a class="bopa-project-card" href="/nos_innovations">
          <div class="bopa-project-card__media">
            <img src="/images/projets-v2/colette.png" alt="Présentation du projet Colette" loading="lazy" />
          </div>
          <div class="bopa-project-card__body">
            <h3>Colette</h3>
            <p>Une IA conversationnelle pour accompagner le patient greffé 24 h/24 et 7 j/7.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section id="notre-vision" class="bopa-vision-v4" aria-labelledby="bopa-vision-v4-title">
    <div class="bopa-vision-v4__network bopa-vision-v4__network--left" aria-hidden="true">
      <svg viewBox="0 0 260 230">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M10 180 52 112 98 153 144 82 196 120 246 42"/>
          <path d="M52 112 144 82M98 153l98-33M144 82l102-40M10 180l88-27"/>
        </g>
        <g fill="currentColor">
          <circle cx="10" cy="180" r="3"/><circle cx="52" cy="112" r="3"/>
          <circle cx="98" cy="153" r="3"/><circle cx="144" cy="82" r="3"/>
          <circle cx="196" cy="120" r="3"/><circle cx="246" cy="42" r="3"/>
        </g>
      </svg>
    </div>

    <div class="bopa-vision-v4__network bopa-vision-v4__network--right" aria-hidden="true">
      <svg viewBox="0 0 260 230">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M10 180 52 112 98 153 144 82 196 120 246 42"/>
          <path d="M52 112 144 82M98 153l98-33M144 82l102-40M10 180l88-27"/>
        </g>
        <g fill="currentColor">
          <circle cx="10" cy="180" r="3"/><circle cx="52" cy="112" r="3"/>
          <circle cx="98" cy="153" r="3"/><circle cx="144" cy="82" r="3"/>
          <circle cx="196" cy="120" r="3"/><circle cx="246" cy="42" r="3"/>
        </g>
      </svg>
    </div>

    <div class="bopa-vision-v4__inner">
      <p class="bopa-vision-v4__eyebrow">Notre vision</p>
      <h2 id="bopa-vision-v4-title">De l'innovation au progrès</h2>

      <p class="bopa-vision-v4__intro">
        <strong>Notre ambition n'est pas d'innover pour innover, mais de transformer l'innovation en progrès pour tous.</strong><br />
        Une innovation, aussi performante soit-elle, ne transforme les pratiques que si elle peut être réellement adoptée et déployée.
        BOPA développe ses projets autour de trois conditions essentielles pour faire passer l'innovation du prototype au progrès partagé.
      </p>

      <div class="bopa-vision-v4__timeline" role="list" aria-label="De l'innovation au progrès pour tous">

        <article class="bopa-vision-v4__step bopa-vision-v4__step--endpoint bopa-vision-v4__step--endpoint-start" role="listitem">
          <div class="bopa-vision-v4__icon" aria-hidden="true">
            <svg viewBox="0 0 64 64">
              <path d="M22 43h20M25 49h14M26 55h12"/>
              <path d="M21 28c0-7 5-13 11-13s11 6 11 13c0 5-2 8-6 12-2 2-3 3-3 6h-4c0-3-1-4-3-6-4-4-6-7-6-12Z"/>
              <path d="M32 9V5M15 16l-3-3M49 16l3-3"/>
            </svg>
          </div>
          <p class="bopa-vision-v4__endpoint-label">Innovation</p>
        </article>

        <article class="bopa-vision-v4__step" role="listitem">
