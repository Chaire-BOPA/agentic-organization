    margin: 0;
    color: var(--mp-blue-bright);
    text-transform: uppercase;
    letter-spacing: .035em;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 800;
  }
  .bopa-support__group-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    font-size: 1.65rem;
