  .bopa-support__grid { display: grid; gap: 18px; }
  .bopa-support__grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .bopa-support__grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }

