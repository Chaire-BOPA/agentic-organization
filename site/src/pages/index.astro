  .about-v2__clinical-stat + .about-v2__clinical-stat { border-left: 1px solid rgba(255,255,255,.3); }
  .about-v2__clinical-stat strong {
    display: block;
    color: var(--mp-blue-bright);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    line-height: 1;
  }
  .about-v2__clinical-stat span {
    display: block;
    margin-top: .55rem;
    color: #fff;
    font-size: .76rem;
    line-height: 1.35;
  }
  .about-v2__clinical-photo,
  .about-v2__clinical-photo-placeholder { min-height: 33rem; overflow: hidden; }
  .about-v2__clinical-photo img {
    width: 100%;
    height: 100%;
    min-height: 33rem;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .about-v2__clinical-photo-placeholder {
