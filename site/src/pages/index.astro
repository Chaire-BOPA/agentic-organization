---
import Base from '../layouts/Base.astro';

const partnerLogos = [
  { src: '/logos/partenaires/logo-aphp.png', alt: 'AP-HP - Assistance Publique-Hôpitaux de Paris' },
  { src: '/logos/partenaires/logo-imt.png', alt: 'Institut Mines-Télécom' },
  { src: '/logos/partenaires/logo-upsaclay.png', alt: 'Université Paris-Saclay' },
  { src: '/logos/partenaires/logo-faphp.png', alt: 'Fondation AP-HP' },
  { src: '/logos/partenaires/logo-fondation-imt.png', alt: 'Fondation Mines-Télécom' },
  { src: '/logos/partenaires/logo-fondation-upsaclay.png', alt: "Fondation de l'Université Paris-Saclay" },
  { src: '/logos/partenaires/logo-relyens.png', alt: 'Relyens' },
  { src: '/logos/partenaires/logo-vermon.png', alt: 'Vermon' },
  { src: '/logos/partenaires/logo-toys-films.png', alt: 'Toys Films' },
];
---

<Base
  title="BOPA - Chaire Innovation Bloc OPératoire Augmenté"
  description="La Chaire Innovation BOPA invente la chirurgie hépato-bilio-pancréatique de demain, au sein de l'hôpital Paul-Brousse AP-HP."
>
  <section id="accueil" class="section-block dark hero">
    <div class="hero-overlay"></div>
    <div class="wrap" data-reveal>
      <h1>Nous façonnons<br />le bloc opératoire<br />de demain.</h1>
      <p class="lede">
        La Chaire Innovation BOPA développe des solutions numériques
        innovantes pour améliorer la qualité, la sécurité et l'expérience
        des patients en chirurgie hépato-bilio-pancréatique.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn" href="/projets">Découvrez nos projets</a>
        <a class="btn" href="/collaborer">Collaborer avec nous</a>
        <a class="btn" href="https://soutenir.fondationaphp.fr/BOPA/" target="_blank" rel="noopener">Nous soutenir</a>
      </div>
    </div>
    <a href="#mission" class="scroll-cue" aria-label="Découvrir la suite">
      <span>Découvrir</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 1v13M2 8l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section id="mission" class="section-block">
    <div class="wrap split-grid">
      <div data-reveal>
        <span class="kicker">La Chaire</span>
        <h2>Notre approche</h2>
        <p>
          La Chaire Innovation BOPA identifie les besoins et les points
          d'amélioration à chaque étape du parcours patient, pour les
          transformer en défis pour les acteurs de l'innovation.
        </p>
        <p>
          Méthodes d'innovation, données, financements, terrain
          d'expérimentation et expertise de haut niveau : la Chaire
          accompagne le passage de l'idée à l'innovation, et de
          l'innovation au progrès.
        </p>
      </div>
      <div class="placeholder-media mission-media" data-reveal style="--reveal-delay: 0.15s"><span>Photo à venir</span></div>
    </div>
    <div class="wrap">
      <div class="pipeline">
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-1); --reveal-delay: 0s">
          <div class="pipeline-dot">1</div>
          <h3>Pré-opératoire</h3>
        </div>
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-2); --reveal-delay: 0.1s">
          <div class="pipeline-dot">2</div>
          <h3>Per-opératoire</h3>
        </div>
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-3); --reveal-delay: 0.2s">
          <div class="pipeline-dot">3</div>
          <h3>Post-opératoire</h3>
        </div>
      </div>
    </div>
  </section>

  <section id="equipe" class="section-block compact">
    <div class="wrap" data-reveal>
      <span class="kicker">La Chaire</span>
      <h2>BOPA 2 - Horizon 2030</h2>
      <p class="lede">
        Portée par ses membres fondateurs - l'AP-HP, l'Institut
        Mines-Télécom et l'Université Paris-Saclay - la Chaire poursuit son
        développement avec le programme BOPA 2, horizon 2030, porté par des
        équipes fondatrice, opérationnelle et scientifique aux compétences
        complémentaires : santé, data science, développement, mathématiques,
        design et sciences humaines.
      </p>
    </div>
  </section>

  <section id="projets" class="section-block">
    <div class="wrap projects-layout">
      <div class="project-slider" id="project-slider" data-reveal>
        <div class="project-slide is-active">
          <div class="placeholder-media"><span>Photo à venir</span></div>
          <span class="phase-tag" style="--step-color: var(--color-step-1)">Pré-opératoire</span>
          <div class="project-slide-info">
            <h3>LiverSight</h3>
            <p>Communication médecin-patient en 3D avant l'opération.</p>
          </div>
        </div>
        <div class="project-slide">
          <div class="placeholder-media"><span>Photo à venir</span></div>
          <span class="phase-tag" style="--step-color: var(--color-step-2)">Per-opératoire</span>
          <div class="project-slide-info">
            <h3>Anyo</h3>
            <p>Optimisation de la répartition des gardes des chirurgiens.</p>
          </div>
        </div>
        <div class="project-slide">
          <div class="placeholder-media"><span>Photo à venir</span></div>
          <span class="phase-tag" style="--step-color: var(--color-step-3)">Post-opératoire</span>
          <div class="project-slide-info">
            <h3>Colette</h3>
            <p>Chatbot d'accompagnement des patients transplantés du foie.</p>
          </div>
        </div>
        <div class="project-slide">
          <div class="placeholder-media"><span>Photo à venir</span></div>
          <span class="phase-tag">À venir</span>
          <div class="project-slide-info">
            <h3>PancreaSight</h3>
            <p>Détails à venir.</p>
          </div>
        </div>
        <div class="project-slide">
          <div class="placeholder-media"><span>Photo à venir</span></div>
          <span class="phase-tag">À venir</span>
          <div class="project-slide-info">
            <h3>HEPAT-GREEN</h3>
            <p>Détails à venir.</p>
          </div>
        </div>
        <div class="project-slider-dots">
          <button type="button" class="is-active" aria-label="Projet 1 : LiverSight"></button>
          <button type="button" aria-label="Projet 2 : Anyo"></button>
          <button type="button" aria-label="Projet 3 : Colette"></button>
          <button type="button" aria-label="Projet 4 : PancreaSight"></button>
          <button type="button" aria-label="Projet 5 : HEPAT-GREEN"></button>
        </div>
      </div>

      <div class="projects-side" data-reveal style="--reveal-delay: 0.15s">
        <span class="kicker">Innovations</span>
        <h2>Nos projets</h2>
        <p class="lede">
          Les idées se transforment en solutions : nos projets s'attaquent
          directement aux défis du bloc opératoire, à chaque étape du
          parcours patient.
        </p>
        <div class="btn-row">
          <a class="btn" href="/projets">Découvrir nos projets</a>
          <a class="btn btn-outline" href="#publications">Voir nos publications</a>
        </div>
      </div>
    </div>
  </section>

  <section id="publications" class="section-block">
    <div class="wrap">
      <span class="kicker">Innovations</span>
      <h2>Publications</h2>
      <div class="stat-row">
        <div class="stat">
          <span class="stat-value" data-reveal>46</span>
          <span class="stat-label">Articles scientifiques</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.1s">48</span>
          <span class="stat-label">Présentations en congrès</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.2s">3</span>
          <span class="stat-label">Axes de recherche</span>
        </div>
      </div>
      <p>
        Les recherches menées au sein de la Chaire s'organisent autour de
        trois axes : les données du bloc opératoire, les jumeaux numériques
        anatomiques et hémodynamiques, et les sciences humaines appliquées à
        la collaboration entre soignants et machines.
      </p>
    </div>
  </section>

  <section id="partenaires" class="section-block">
    <div class="wrap" data-reveal>
      <span class="kicker">La Chaire</span>
      <h2>Nos partenaires</h2>
      <p class="lede partenaires-lede">
        La Chaire bénéficie du soutien de ses membres fondateurs, des
        fondations qui leur sont rattachées, et de la générosité
        d'entreprises mécènes partenaires.
      </p>
    </div>
    <div class="logo-marquee">
      <div class="logo-marquee-track">
        {partnerLogos.map((logo) => <img src={logo.src} alt={logo.alt} loading="lazy" />)}
        {partnerLogos.map((logo) => <img src={logo.src} alt="" aria-hidden="true" loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="section-block dark donate">
    <div class="wrap" data-reveal>
      <h2>Soutenir la Chaire BOPA</h2>
      <p class="lede">
        Chaque don accélère la recherche et l'innovation au bloc opératoire.
      </p>
      <div class="btn-row">
        <a class="btn" href="https://soutenir.fondationaphp.fr/BOPA/" target="_blank" rel="noopener">Faire un don</a>
        <a class="btn btn-outline" href="/contact">Nous contacter</a>
      </div>
    </div>
  </section>

  <script>
    // Auto-advancing project slider: one project at a time, restarts its
    // timer on manual dot clicks, pauses on hover/focus. Keeps advancing
    // even with reduced motion requested — .project-slide's transition is
    // dropped in that case (see site.css) so slides cut instead of fade.
    const slider = document.getElementById('project-slider');
    const slides = slider?.querySelectorAll<HTMLElement>('.project-slide');
    const dots = slider?.querySelectorAll<HTMLButtonElement>('.project-slider-dots button');

    if (slider && slides && dots && slides.length > 0) {
      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      };

      const stop = () => timer && clearInterval(timer);

      // Idempotent: always clears any running timer first. Without this,
      // a mouseleave/focusout firing without a matching prior
      // mouseenter/focusin (reachable if the pointer is already resting
      // over the slider when the page loads) stacked a second interval,
      // which is what made the slider appear to skip a slide.
      const start = () => {
        stop();
        timer = setInterval(() => show(index + 1), 4500);
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          stop();
          start();
        });
      });

      slider.addEventListener('mouseenter', stop);
      slider.addEventListener('mouseleave', start);
      slider.addEventListener('focusin', stop);
      slider.addEventListener('focusout', start);

      start();
    }
  </script>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 60vh;
    padding-top: var(--space-6);
    display: flex;
    align-items: flex-end;
    text-align: left;
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: -20px;
    background: url('/photos/hero-bloc-op.jpg') 50% 85% / cover no-repeat;
  }

  .hero::before {
    z-index: 0;
  }

  .hero::after {
    z-index: 1;
    filter: blur(6px);
    -webkit-mask-image: linear-gradient(to right, black 0%, transparent 22%);
    mask-image: linear-gradient(to right, black 0%, transparent 22%);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(45% 65% at 88% 32%, rgba(45, 185, 227, 0.4), transparent 70%),
      linear-gradient(to right, rgba(2, 24, 49, 0.94) 0%, rgba(4, 38, 77, 0.7) 45%, rgba(3, 82, 156, 0.4) 100%);
  }

  .hero .wrap {
    position: relative;
    z-index: 3;
    margin: 0;
    padding-left: var(--space-3);
  }

  .hero h1 {
    font-size: clamp(2.75rem, 6vw, 5rem);
    max-width: 56rem;
    margin: 0;
  }

  .hero .lede {
    margin: var(--space-3) 0 0;
    max-width: 34rem;
  }

  .hero-actions {
    justify-content: flex-start;
  }

  .hero-actions .btn {
    background: transparent;
    color: #fff;
    box-shadow: inset 0 0 0 1px #fff;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    text-transform: none;
    letter-spacing: normal;
  }

  .hero-actions .btn:hover {
    background: var(--bopa-blue-4);
    color: #fff;
    box-shadow: inset 0 0 0 1px var(--bopa-blue-4);
  }

  .scroll-cue {
    position: absolute;
    z-index: 3;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-dark-ink);
    text-decoration: none;
    font-size: var(--text-sm);
    opacity: 0.85;
    animation: bob 2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-5);
    align-items: center;
  }

  .mission-media {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 16rem;
    margin-left: auto;
  }

  .section-block.compact {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .projects-side .btn-row {
    margin-top: var(--space-5);
  }

  .donate {
    text-align: center;
    background:
      linear-gradient(120deg, var(--bopa-blue-1), var(--bopa-blue-2) 50%, var(--bopa-blue-3));
  }

  .donate .lede {
    margin: var(--space-2) auto 0;
  }

  .donate .btn-row {
    justify-content: center;
  }

  .donate .btn.btn-outline {
    box-shadow: inset 0 0 0 1.5px #ffffff;
    color: #ffffff;
  }

  .donate .btn:not(.btn-outline) {
    background: #ffffff;
    color: var(--color-accent);
  }

  .partenaires-lede {
    max-width: none;
    margin-bottom: var(--space-5);
  }

  @media (max-width: 48rem) {
    .split-grid {
      grid-template-columns: 1fr;
    }

    .mission-media {
      order: -1;
      max-width: 100%;
      margin-left: 0;
    }
  }
</style>
