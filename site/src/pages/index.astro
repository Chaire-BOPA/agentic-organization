  .hero-text-blur {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: min(48%, 44rem);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    mask-image: linear-gradient(to right, black 0%, black 55%, transparent 100%);
