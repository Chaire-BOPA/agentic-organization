  }
  .about-v2__support-head p {
    max-width: 47rem;
    margin: 0 auto;
    color: var(--about-ink);
    font-size: .98rem;
    line-height: 1.7;
  }
  .about-v2__support-groups {
    display: grid;
    gap: clamp(2.6rem, 5vw, 4rem);
  }
  .about-v2__support-group h4 {
