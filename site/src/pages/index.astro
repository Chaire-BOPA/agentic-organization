---
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';

// Any image dropped into site/public/images/equipe/ becomes a gallery
// slide automatically - see source/brand/assets/equipe/README.md for
// where the owner drops originals. process.cwd() (not import.meta.url)
// because the build bundles this file elsewhere, breaking a
// URL-relative path that only worked in dev.
const teamPhotos = readdirSync(join(process.cwd(), 'public', 'images', 'equipe'))
  .filter((file) => /\.(jpe?g|png|webp)$/i.test(file))
  .sort()
  .map((file) => ({
    src: `/images/equipe/${file}`,
    alt: "Un instant avec l'équipe de la Chaire Innovation BOPA.",
  }));

const partnerLogos = [
  { src: '/logos/partenaires/logo-aphp.png', alt: 'AP-HP - Assistance Publique-Hôpitaux de Paris' },
  { src: '/logos/partenaires/logo-imt.png', alt: 'Institut Mines-Télécom', scale: 0.85 },
  { src: '/logos/partenaires/logo-upsaclay.png', alt: 'Université Paris-Saclay' },
  { src: '/logos/partenaires/logo-faphp.png', alt: 'Fondation AP-HP' },
  { src: '/logos/partenaires/logo-fondation-imt.png', alt: 'Fondation Mines-Télécom', scale: 1.15 },
  { src: '/logos/partenaires/logo-fondation-upsaclay.png', alt: "Fondation de l'Université Paris-Saclay", scale: 1.15 },
  { src: '/logos/partenaires/logo-relyens.png', alt: 'Relyens' },
  { src: '/logos/partenaires/logo-vermon.png', alt: 'Vermon', scale: 0.85 },
];

const team = [
  {
    group: 'Ceux qui font BOPA tous les jours',
    people: [
      { name: 'Charles Hellec', role: 'Directeur de la Chaire BOPA' },
      { name: 'Elie Farah', role: 'Directeur de la plateforme BOPtech' },
    ],
  },
  {
    group: "L'équipe soignante du CHB",
    people: [{ name: 'Pr Éric Vibert', role: 'Chirurgien, Centre Hépato-Biliaire - initiateur de la Chaire' }],
  },
  {
    group: 'Collaborateurs ingénieurs et sciences humaines',
    people: [{ name: 'Axelle Piguet', role: 'Ingénieure' }],
  },
];
---

<Base
  title="BOPA - Chaire Innovation Bloc OPératoire Augmenté"
  description="La Chaire Innovation BOPA invente la chirurgie hépato-bilio-pancréatique de demain, au sein de l'hôpital Paul-Brousse AP-HP."
>
  <section id="accueil" class="section-block dark hero">
    <!-- 1. Photo brute, intacte : object-fit cover + object-position pour
         cadrer, jamais de filter/blur/scale dessus. -->
    <img
      class="hero-photo"
      src="/photos/hero-bloc-op-natural.jpg"
      alt="Une équipe chirurgicale au bloc opératoire, autour d'un ordinateur affichant une modélisation 3D du foie"
      width="2800"
      height="1758"
    />
    <!-- 2. Calques de teinte : uniquement dégradés/opacités, jamais un filter sur la photo. -->
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="hero-gradient" aria-hidden="true"></div>
    <div class="hero-vignette" aria-hidden="true"></div>
    <!-- 3. Flou de lisibilité, limité à la zone du texte (gauche). -->
    <div class="hero-text-blur" aria-hidden="true"></div>
    <canvas id="hero-network" class="hero-network" aria-hidden="true"></canvas>
    <div class="wrap" data-reveal>
      <h1>Nous façonnons<br />le bloc opératoire<br /><em>de demain.</em></h1>
      <p class="lede">
        La Chaire Innovation BOPA développe des solutions numériques
        innovantes pour améliorer la qualité, la sécurité et l'expérience
        des patients en chirurgie <span class="nowrap">hépato-bilio-pancréatique</span>.
      </p>
      <div class="btn-row hero-actions">
        <a class="btn btn-outline-premium" href="/innovations">Découvrir nos projets</a>
        <a class="btn btn-filled-premium" href="https://soutenir.fondationaphp.fr/BOPA/" target="_blank" rel="noopener">Nous soutenir</a>
      </div>
    </div>
    <a href="#qui-sommes-nous" class="scroll-cue" aria-label="Découvrir la suite">
      <span>Découvrir</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 1v13M2 8l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <section id="qui-sommes-nous" class="section-block fade-from-navy">
    <div class="mesh-echo" aria-hidden="true" style="opacity: 0.045;"></div>
    <div class="ambient-halo" aria-hidden="true" style="width: 24rem; height: 24rem; bottom: -4rem; right: -6rem;"></div>
    <div class="wrap" data-reveal>
      <span class="kicker">La Chaire</span>
      <h2>Qui sommes-nous ?</h2>
      <p class="lede">
        La Chaire Innovation BOPA améliore la qualité et la sécurité des
        soins au bloc opératoire, en chirurgie hépato-bilio-pancréatique, en
        concevant, développant et déployant des solutions numériques basées
        sur l'IA et les jumeaux numériques.
      </p>
      <p>
        Portée par trois membres fondateurs - l'AP-HP, l'Institut
        Mines-Télécom et l'Université Paris-Saclay - elle est installée au
        sein de l'hôpital Paul-Brousse (GHU AP-HP Université Paris-Saclay),
        à proximité directe du Centre Hépato-Biliaire (CHB), 1er centre de
        transplantation hépatique et chirurgie hépato-bilio-pancréatique en
        France.
      </p>
      <p class="text-muted">
        Un enjeu qui reste entier : six mois après une transplantation
        hépatique, la mortalité avoisine encore les 10 %.
      </p>
    </div>
    <div class="wrap partners-block" data-reveal style="--reveal-delay: 0.1s">
      <div class="partners-text">
        <p class="partners-tagline">Ensemble, innovons sans limites</p>
        <p class="partners-label">Nos membres fondateurs et partenaires</p>
      </div>
      <div class="logo-marquee">
        <div class="logo-marquee-track">
          {partnerLogos.map((logo) => (
            <img src={logo.src} alt={logo.alt} loading="lazy" style={`--logo-scale: ${logo.scale ?? 1}`} />
          ))}
          {partnerLogos.map((logo) => (
            <img src={logo.src} alt="" aria-hidden="true" loading="lazy" style={`--logo-scale: ${logo.scale ?? 1}`} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="approche" class="section-block">
    <div class="mesh-echo" aria-hidden="true"></div>
    <div class="ambient-halo" aria-hidden="true" style="width: 26rem; height: 26rem; top: -6rem; right: -4rem;"></div>
    <div class="wrap approche-intro" data-reveal>
      <div>
        <span class="kicker">Notre approche</span>
        <h2>La vision : changer les pratiques du bloc opératoire</h2>
        <p class="lede">
          Une conviction de sciences humaines guide chaque projet : une
          innovation n'a de valeur que si elle est adoptée. Trois exigences
          cadrent tout ce que la Chaire construit.
        </p>
      </div>
      <div class="value-column">
        <div class="value-item" style="--step-color: var(--color-step-1)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
            <path d="M8 12.5l2.5 2.5L16 9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <div>
            <p>Des solutions numériques co-construites et validées par les soignants.</p>
          </div>
        </div>
        <div class="value-item" style="--step-color: var(--color-step-2)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 2.5v4M15 2.5v4M7 6.5h10v3.5a5 5 0 01-10 0V6.5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M12 15v3.5M9.5 21.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <div>
            <p>Des systèmes capables de s'intégrer partout.</p>
          </div>
        </div>
        <div class="value-item" style="--step-color: var(--color-step-3)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 18c-1-6 2-11 12-12 0 10-5 13-11 13-1 0-1.5-0.3-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M7.5 16.5c2-3 4.5-5.5 7-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <div>
            <p>Une approche éthique, responsable financièrement, et sobre en carbone.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="wrap section-sub">
      <h2>Le projet scientifique : augmenter le parcours patient</h2>
      <p class="lede">
        BOPA2 (2025-2030) améliore la qualité et la sécurité des soins à
        chaque étape de la chirurgie.
      </p>
      <div class="pipeline">
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-1); --reveal-delay: 0s">
          <div class="pipeline-dot">1</div>
          <h3>Pré-opératoire</h3>
          <p>Communiquer pour rassurer le patient.</p>
        </div>
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-2); --reveal-delay: 0.1s">
          <div class="pipeline-dot">2</div>
          <h3>Per-opératoire</h3>
          <p>Des analyses en temps réel pour de meilleurs résultats.</p>
        </div>
        <div class="pipeline-step" data-reveal style="--step-color: var(--color-step-3); --reveal-delay: 0.2s">
          <div class="pipeline-dot">3</div>
          <h3>Post-opératoire</h3>
          <p>Des outils numériques pour un meilleur suivi.</p>
        </div>
      </div>
    </div>

    <div class="wrap section-sub">
      <h2>La méthode</h2>
      <p class="lede">
        Trois degrés de maturité pour travailler avec la Chaire, dans un
        espace de 158 m² incluant un bloc opératoire factice, mis à
        disposition par l'hôpital Paul-Brousse AP-HP. Cet accès direct au
        bloc permet des échanges réguliers avec les praticiens et un
        travail en commun. Les solutions finalisées sont validées au bloc
        opératoire du Centre Hépato-Biliaire.
      </p>
      <div class="card-grid">
        <div class="card">
          <h3>Prototyper</h3>
          <p>Concevoir des preuves de concept (POC).</p>
        </div>
        <div class="card">
          <h3>Codévelopper</h3>
          <p>Construire de nouvelles solutions avec la Chaire.</p>
        </div>
        <div class="card">
          <h3>Tester</h3>
          <p>Évaluer des solutions existantes : α-test, β-test, test d'acceptance et test clinique.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="projets" class="section-block">
    <div class="mesh-echo" aria-hidden="true" style="opacity: 0.04;"></div>
    <div class="ambient-halo" aria-hidden="true" style="width: 30rem; height: 30rem; bottom: -8rem; left: -6rem;"></div>
    <div class="wrap" data-reveal>
      <span class="kicker">Innovations</span>
      <h2>Nos projets et réalisations</h2>
      <p class="lede">
        Des chiffres à l'impact concret : ce que la Chaire a bâti, et ce
        qu'elle construit aujourd'hui à chaque étape du parcours patient.
      </p>
      <div class="stat-row">
        <div class="stat">
          <span class="stat-value" data-reveal>1.6M€</span>
          <span class="stat-label">Mécénat collecté depuis 2020</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.1s">50</span>
          <span class="stat-label">Publications scientifiques</span>
        </div>
        <div class="stat">
          <span class="stat-value" data-reveal style="--reveal-delay: 0.2s">2</span>
          <span class="stat-label">Start-up créées (DOTs, Uncovr)</span>
        </div>
      </div>
    </div>

    <div class="wrap section-sub" data-reveal>
      <h3 class="institutional-subtitle">Les réalisations institutionnelles</h3>
      <div class="accordion-subgrid">
        <details class="accordion-subitem">
          <summary>
            <span class="accordion-subtitle">Le tiers-lieu d'expérimentation BOPEX</span>
            <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="accordion-subpanel">
            <p>
              Créé en 2023, situé à l'hôpital Broussais à côté du Campus
              chirurgical du Grand Paris, BOPEX accélère le développement
              d'innovations numériques et technologiques pour le bloc
              opératoire : start-up, entreprises tech, innovateurs internes
              AP-HP et professionnels de santé y testent leurs solutions en
              conditions réelles.
            </p>
            <p>
              Trois piliers d'accompagnement : <strong>derisking</strong>
              (validation experte de la pertinence clinique et technique),
              <strong> codéveloppement</strong> (conception de l'interface,
              structuration des études cliniques) et
              <strong> test</strong> (utilisabilité, acceptabilité, impact
              organisationnel).
            </p>
          </div>
        </details>
        <details class="accordion-subitem">
          <summary>
            <span class="accordion-subtitle">La plateforme BOPTECH</span>
            <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="accordion-subpanel">
            <p>
              Plateforme technologique et scientifique unique, au sein même
              du bloc opératoire du Centre Hépato-Biliaire : chirurgie
              guidée par l'image, endoscopie, oncologie
              hépato-bilio-pancréatique. Financée par l'AP-HP, le Paris
              Saclay Cancer Cluster et BPI France.
            </p>
            <p>
              Sa salle hybride, équipée du système Philips Azurion 7 et de
              capacités IA, sera opérationnelle en juillet 2026. Son modèle
              préclinique <strong>In Machina</strong>{' '}
              maintient des foies humains en conditions quasi-physiologiques
              plusieurs jours, pour tester des innovations avant les essais
              cliniques - avec l'accès privilégié qu'offrent les 200
              transplantations et 150 hépatectomies réalisées chaque année
              au CHB.
            </p>
          </div>
        </details>
      </div>
    </div>

    <div class="wrap section-sub carousel-wrap" data-reveal style="--reveal-delay: 0.1s">
      <div class="project-slider" id="project-slider">
        <a
          class="project-slide is-active"
          href="https://www.youtube.com/watch?v=MF1ysshoNVM"
          target="_blank"
          rel="noopener"
          style="--step-color: var(--color-step-1)"
        >
          <img class="project-slide-photo" src="/images/projets/liversight-video.jpg" alt="Vidéo de présentation de LiverSight" loading="lazy" />
          <span class="phase-tag">Préopératoire</span>
          <span class="play-badge" aria-hidden="true">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
              <circle cx="28" cy="28" r="27" fill="rgba(4, 20, 33, 0.45)" stroke="#fff" stroke-width="1.5" />
              <path d="M23 18.5v19l16-9.5-16-9.5z" fill="#fff" />
            </svg>
          </span>
          <div class="project-slide-info">
            <h3>LiverSight</h3>
            <p>Communication médecin-patient en 3D avant l'opération - voir la vidéo sur YouTube.</p>
          </div>
        </a>
        <a class="project-slide" href="/innovations" style="--step-color: var(--color-step-1)">
          <img class="project-slide-photo" src="/images/projets/pancreasight.jpg" alt="Modélisation 3D interactive PancreasSight" loading="lazy" />
          <span class="phase-tag">Préopératoire</span>
          <div class="project-slide-info">
            <h3>PancreasSight</h3>
            <p>La même approche appliquée à la chirurgie pancréatique.</p>
          </div>
        </a>
        <a class="project-slide" href="/innovations" style="--step-color: var(--color-step-2)">
          <img class="project-slide-photo" src="/images/projets/bopcam.jpg" alt="Casque BOPCAM porté par un chirurgien au bloc opératoire" loading="lazy" />
          <span class="phase-tag">Peropératoire</span>
          <div class="project-slide-info">
            <h3>BOPCAM</h3>
            <p>Un casque qui filme les mains du chirurgien : analyse en direct, télé-expertise.</p>
          </div>
        </a>
        <a class="project-slide" href="/innovations" style="--step-color: var(--color-step-2)">
          <img class="project-slide-photo" src="/images/projets/henri.png" alt="Illustration d'Henri, l'assistant IA du chirurgien, aux côtés de l'équipe au bloc opératoire" loading="lazy" />
          <span class="phase-tag">Peropératoire</span>
          <div class="project-slide-info">
            <h3>Henri</h3>
            <p>Un assistant pour accompagner le chirurgien : informations patient, checklist, antécédents.</p>
          </div>
        </a>
        <a class="project-slide" href="/innovations" style="--step-color: var(--color-step-2)">
          <img class="project-slide-photo" src="/images/projets/goldfinger.png" alt="Chirurgien manipulant sans contact un modèle 3D de foie affiché à l'écran, en salle d'opération" loading="lazy" />
          <span class="phase-tag">Peropératoire</span>
          <div class="project-slide-info">
            <h3>Goldfinger</h3>
            <p>Manipuler un modèle 3D de foie sans contact, sans compromettre la stérilité du bloc.</p>
          </div>
        </a>
        <a class="project-slide" href="/innovations" style="--step-color: var(--color-step-3)">
          <img class="project-slide-photo" src="/images/projets/colette.jpg" alt="Le chatbot Colette sur un téléphone" loading="lazy" />
          <span class="phase-tag">Postopératoire</span>
          <div class="project-slide-info">
            <h3>Colette</h3>
            <p>Un chatbot qui accompagne 24h/24 les patients transplantés du foie.</p>
          </div>
        </a>
        <div class="project-slider-dots">
          <button type="button" class="is-active" aria-label="Projet 1 : LiverSight"></button>
          <button type="button" aria-label="Projet 2 : PancreasSight"></button>
          <button type="button" aria-label="Projet 3 : BOPCAM"></button>
          <button type="button" aria-label="Projet 4 : Henri"></button>
          <button type="button" aria-label="Projet 5 : Goldfinger"></button>
          <button type="button" aria-label="Projet 6 : Colette"></button>
        </div>
      </div>
      <p class="carousel-more">
        <a href="/innovations">
          En savoir plus : tous nos projets, phase par phase
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </p>
    </div>
  </section>

  <section id="equipe" class="section-block fade-to-navy">
    <div class="mesh-echo" aria-hidden="true" style="opacity: 0.045;"></div>
    <div class="ambient-halo" aria-hidden="true" style="width: 22rem; height: 22rem; top: -2rem; left: -5rem;"></div>
    <div class="wrap" data-reveal>
      <span class="kicker">La Chaire</span>
      <h2>Notre équipe</h2>
      <p class="lede">
        Des soignants AP-HP, des ingénieurs IMT &amp; INRIA et des
        chercheurs Paris-Saclay &amp; CNAM, réunis autour d'un même terrain.
      </p>
    </div>
    {team.map((group) => (
      <div class="wrap team-group">
        <h3>{group.group}</h3>
        <div class="card-grid">
          {group.people.map((person) => (
            <div class="card person-card">
              <p class="person-name">{person.name}</p>
              <p class="person-role">{person.role}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
    {teamPhotos.length > 0 && (
      <div class="wrap team-gallery-wrap" data-reveal>
        <div class="team-gallery-slider" id="team-gallery">
          {teamPhotos.map((photo, i) => (
            <div class:list={['team-gallery-slide', { 'is-active': i === 0 }]}>
              <img src={photo.src} alt={photo.alt} loading="lazy" />
            </div>
          ))}
          {teamPhotos.length > 1 && (
            <div class="team-gallery-dots">
              {teamPhotos.map((_, i) => (
                <button type="button" class:list={{ 'is-active': i === 0 }} aria-label={`Photo ${i + 1}`}></button>
              ))}
            </div>
          )}
        </div>
      </div>
    )}
  </section>

  <section id="soutenir" class="section-block dark donate">
    <div class="mesh-echo" aria-hidden="true" style="opacity: 0.06; --mesh-color: rgba(225, 242, 255, 0.9);"></div>
    <div class="wrap" data-reveal>
      <h2>Nous soutenir</h2>
      <p class="lede">
        La Chaire fonctionne par mécénat - 1,6 M€ collectés depuis sa
        création en 2020. Ce soutien finance la recherche, le
        développement de nos outils et l'équipement du bloc opératoire.
        Chaque don accélère la recherche et l'innovation.
      </p>
      <div class="btn-row">
        <a class="btn btn-outline-premium" href="https://soutenir.fondationaphp.fr/BOPA/" target="_blank" rel="noopener">Faire un don</a>
      </div>
    </div>

    <div class="wrap" id="contact" style="scroll-margin-top: var(--space-5);">
      <div class="soutenir-form-card" data-reveal style="--reveal-delay: 0.15s">
        <h3>Nous contacter</h3>
        <p>Une question, un projet à proposer ? Écrivez-nous directement.</p>
        <form id="soutenir-form" class="contact-form" novalidate>
          <input type="hidden" name="access_key" value="89ce7ec3-0341-4abe-a95e-b0f99be8b0d5" />
          <input type="hidden" name="subject" value="Nouveau message depuis le site BOPA" />
          <input type="checkbox" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off" />
          <div class="form-field">
            <label for="nom">Nom</label>
            <input type="text" id="nom" name="nom" required />
          </div>
          <div class="form-field">
            <label for="prenom">Prénom</label>
            <input type="text" id="prenom" name="prenom" required />
          </div>
          <div class="form-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn">Envoyer</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Envoi direct via Web3Forms : le visiteur n'a plus besoin de sa
    // propre messagerie, le message part depuis le formulaire.
    const form = document.getElementById('soutenir-form') as HTMLFormElement | null;
    const statusEl = form?.querySelector('.form-status') as HTMLElement | null;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submitBtn || !statusEl) return;

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi...';
      statusEl.textContent = '';
      statusEl.classList.remove('is-error', 'is-success');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json();

        if (result.success) {
          form.reset();
          statusEl.textContent = 'Message envoyé. Merci, nous revenons vers vous rapidement.';
          statusEl.classList.add('is-success');
        } else {
          throw new Error(result.message ?? 'Échec de l\'envoi');
        }
      } catch {
        statusEl.textContent = 'Le message n\'a pas pu être envoyé. Réessayez ou écrivez-nous directement à charles.hellec@aphp.fr.';
        statusEl.classList.add('is-error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });

    // Accordions: closing sibling <details> when one opens, so only one
    // panel per level is expanded at a time (keeps the page scannable).
    const closeSiblings = (el: HTMLDetailsElement) => {
      const parent = el.parentElement;
      if (!parent) return;
      [...parent.children].forEach((sibling) => {
        if (sibling !== el && sibling instanceof HTMLDetailsElement) sibling.open = false;
      });
    };

    document.querySelectorAll<HTMLDetailsElement>('.accordion-item, .accordion-subitem, .phase-card').forEach((el) => {
      el.addEventListener('toggle', () => {
        if (el.open) closeSiblings(el);
      });
    });

    // Auto-advancing project carousel: one project at a time, restarts its
    // timer on manual dot clicks, pauses on hover/focus. start() always
    // clears any running timer first - without that, a mouseleave/focusout
    // firing without a matching prior mouseenter/focusin (reachable if the
    // pointer is already resting over the slider on page load) stacks a
    // second interval and the slider appears to randomly skip a slide.
    const slider = document.getElementById('project-slider');
    const slides = slider?.querySelectorAll<HTMLElement>('.project-slide');
    const dots = slider?.querySelectorAll<HTMLButtonElement>('.project-slider-dots button');

    if (slider && slides && dots && slides.length > 0) {
      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
      };

      const stop = () => timer && clearInterval(timer);
      const start = () => {
        stop();
        timer = setInterval(() => show(index + 1), 2500);
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          stop();
          start();
        });
      });

      slider.addEventListener('mouseenter', stop);
      slider.addEventListener('mouseleave', start);
      slider.addEventListener('focusin', stop);
      slider.addEventListener('focusout', start);

      start();
    }

    // Same pattern for the team photo gallery - no-ops on 0-1 photo.
    const gallery = document.getElementById('team-gallery');
    const gallerySlides = gallery?.querySelectorAll<HTMLElement>('.team-gallery-slide');
    const galleryDots = gallery?.querySelectorAll<HTMLButtonElement>('.team-gallery-dots button');

    if (gallery && gallerySlides && gallerySlides.length > 1) {
      let galleryIndex = 0;
      let galleryTimer: ReturnType<typeof setInterval> | undefined;

      const showGallery = (next: number) => {
        galleryIndex = (next + gallerySlides.length) % gallerySlides.length;
        gallerySlides.forEach((slide, i) => slide.classList.toggle('is-active', i === galleryIndex));
        galleryDots?.forEach((dot, i) => dot.classList.toggle('is-active', i === galleryIndex));
      };

      const stopGallery = () => galleryTimer && clearInterval(galleryTimer);
      const startGallery = () => {
        stopGallery();
        galleryTimer = setInterval(() => showGallery(galleryIndex + 1), 3000);
      };

      galleryDots?.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          showGallery(i);
          stopGallery();
          startGallery();
        });
      });

      gallery.addEventListener('mouseenter', stopGallery);
      gallery.addEventListener('mouseleave', startGallery);
      gallery.addEventListener('focusin', stopGallery);
      gallery.addEventListener('focusout', startGallery);

      startGallery();
    }
  </script>

  <script>
    // ---------------------------------------------------------------------
    // Maillage numérique du hero : nuage de points reliés par de fines
    // lignes, posé au-dessus de la photo (jamais superposé au texte grâce
    // au z-index, jamais bloquant grâce à pointer-events: none sur le
    // canvas). Purement décoratif : n'ajoute ni organe, ni texte, ni forme
    // reconnaissable, juste des points + lignes.
    // ---------------------------------------------------------------------

    // ---- Réglages principaux : à ajuster ici, rien d'autre à toucher ----
    const NETWORK_CONFIG = {
      pointCountDesktop: 80, // nombre de points sur grand écran
      pointCountMobile: 32, // nombre de points sur mobile (perf)
      mobileBreakpoint: 640, // largeur (px) en dessous de laquelle on est "mobile"

      opacityMin: 0.32, // opacité minimale au repos (respiration) - nettement plus visible
      opacityMax: 0.75, // opacité maximale au repos (respiration)
      breatheSpeed: 0.0006, // vitesse de la respiration (plus petit = plus lent)

      driftSpeed: 0.0004, // vitesse du léger déplacement de certains points
      driftAmount: 3, // amplitude du déplacement (px)
      driftPointRatio: 0.35, // proportion de points qui dérivent un peu (les autres restent fixes)

      connectionDistance: 120, // distance max (px) pour relier deux points par une ligne
      lineOpacityMax: 0.38, // opacité max d'une ligne (à distance nulle)
      lineWidth: 0.8, // épaisseur des lignes (px)

      mouseRadius: 200, // rayon (px) d'influence de la souris autour d'un point
      mouseBoost: 0.4, // opacité supplémentaire max apportée par la proximité de la souris
      mouseDisplace: 7, // déplacement max (px) d'un point proche du curseur
      mouseConnectionBoost: 1.4, // multiplicateur de connectionDistance près du curseur
      mouseEase: 0.08, // vitesse de rappel/suivi vers la position cible (0-1, plus petit = plus doux)

      dotSizeMin: 2, // taille mini d'un point (px)
      dotSizeMax: 4, // taille maxi d'un point (px)
      glowBlur: 15, // flou du halo autour des points (shadowBlur) - halo bien plus présent

      dotColor: '225, 242, 255', // couleur des points, "r, g, b" (blanc légèrement bleuté, plus lumineux)
      lineColor: '225, 242, 255', // couleur des lignes, même teinte
    };

    const canvas = document.getElementById('hero-network') as HTMLCanvasElement | null;
    const heroSection = canvas?.closest('.hero') as HTMLElement | null;

    if (canvas && heroSection) {
      const ctx = canvas.getContext('2d');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (ctx) {
        type Point = {
          baseX: number;
          baseY: number;
          x: number;
          y: number;
          targetOffsetX: number;
          targetOffsetY: number;
          offsetX: number;
          offsetY: number;
          phase: number;
          drifts: boolean;
          fade: number; // facteur d'opacité selon la position (fondu à droite)
          size: number;
        };

        let points: Point[] = [];
        let width = 0;
        let height = 0;
        let dpr = Math.min(window.devicePixelRatio || 1, 2);
        let mouseX = -9999;
        let mouseY = -9999;
        let mouseActive = false;
        let animationFrame = 0;

        // Fondu du maillage vers la droite de l'image.
        // Poids de présence selon la position (0-1) : fort en bas à gauche,
        // fort en bas, fort à droite ; nettement plus discret au centre de
        // l'image pour ne jamais gêner la lecture du texte ni la scène.
        function presenceWeight(xRatio: number, yRatio: number) {
          const bottom = yRatio; // 0 en haut, 1 en bas
          const left = 1 - xRatio; // 1 au bord gauche
          const right = xRatio; // 1 au bord droit

          const bottomLeft = left * bottom;
          const bottomEdge = Math.pow(bottom, 1.4) * 0.75;
          const rightEdge = Math.pow(right, 1.6) * 0.85;

          let weight = Math.max(bottomLeft, bottomEdge, rightEdge);

          // Suppression additionnelle au centre géométrique de l'image.
          const dx = xRatio - 0.5;
          const dy = yRatio - 0.42; // le centre "utile" est un peu plus haut que le milieu
          const distFromCenter = Math.sqrt(dx * dx + dy * dy) / 0.5;
          const centerFactor = Math.min(1, 0.25 + 0.9 * distFromCenter);

          return Math.min(1, weight * centerFactor);
        }

        // Génère les points par échantillonnage pondéré : on tire des
        // positions uniformes et on ne garde que celles dont le poids de
        // présence "gagne" un tirage aléatoire, jusqu'à atteindre le
        // nombre de points visés.
        function createPoints() {
          const isMobile = width < NETWORK_CONFIG.mobileBreakpoint;
          const count = isMobile ? NETWORK_CONFIG.pointCountMobile : NETWORK_CONFIG.pointCountDesktop;
          const next: Point[] = [];
          const maxAttempts = count * 40;
          let attempts = 0;

          while (next.length < count && attempts < maxAttempts) {
            attempts++;
            const xRatio = Math.random();
            const yRatio = Math.random();
            const weight = presenceWeight(xRatio, yRatio);
            if (Math.random() > weight) continue;

            const baseX = xRatio * width;
            const baseY = yRatio * height;

            next.push({
              baseX,
              baseY,
              x: baseX,
              y: baseY,
              targetOffsetX: 0,
              targetOffsetY: 0,
              offsetX: 0,
              offsetY: 0,
              phase: Math.random() * Math.PI * 2,
              drifts: Math.random() < NETWORK_CONFIG.driftPointRatio,
              fade: 0.55 + weight * 0.45, // un peu de variation, jamais trop pâle
              size: NETWORK_CONFIG.dotSizeMin + Math.random() * (NETWORK_CONFIG.dotSizeMax - NETWORK_CONFIG.dotSizeMin),
            });
          }

          points = next;
        }

        // Redimensionne le canvas à la taille exacte de son conteneur.
        function resize() {
          const rect = heroSection.getBoundingClientRect();
          width = rect.width;
          height = rect.height;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          createPoints();
        }

        function onPointerMove(clientX: number, clientY: number) {
          const rect = heroSection.getBoundingClientRect();
          mouseX = clientX - rect.left;
          mouseY = clientY - rect.top;
          mouseActive = true;
        }

        heroSection.addEventListener('mousemove', (e) => onPointerMove(e.clientX, e.clientY));
        heroSection.addEventListener('mouseleave', () => {
          mouseActive = false;
          mouseX = -9999;
          mouseY = -9999;
        });

        function drawFrame(time: number) {
          ctx.clearRect(0, 0, width, height);

          for (const p of points) {
            // Respiration lente de l'opacité (indépendante par point via phase).
            const breathe =
              NETWORK_CONFIG.opacityMin +
              (NETWORK_CONFIG.opacityMax - NETWORK_CONFIG.opacityMin) *
                (0.5 + 0.5 * Math.sin(time * NETWORK_CONFIG.breatheSpeed + p.phase));

            // Léger déplacement, seulement pour une partie des points.
            if (p.drifts) {
              p.x = p.baseX + Math.sin(time * NETWORK_CONFIG.driftSpeed + p.phase) * NETWORK_CONFIG.driftAmount;
              p.y = p.baseY + Math.cos(time * NETWORK_CONFIG.driftSpeed + p.phase * 1.3) * NETWORK_CONFIG.driftAmount;
            } else {
              p.x = p.baseX;
              p.y = p.baseY;
            }

            // Interaction souris : halo plus lumineux + léger déplacement,
            // avec retour progressif quand le curseur s'éloigne.
            let mouseInfluence = 0;
            if (mouseActive) {
              const dx = p.x - mouseX;
              const dy = p.y - mouseY;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < NETWORK_CONFIG.mouseRadius) {
                mouseInfluence = 1 - dist / NETWORK_CONFIG.mouseRadius;
                const angle = Math.atan2(dy, dx);
                p.targetOffsetX = Math.cos(angle) * NETWORK_CONFIG.mouseDisplace * mouseInfluence;
                p.targetOffsetY = Math.sin(angle) * NETWORK_CONFIG.mouseDisplace * mouseInfluence;
              } else {
                p.targetOffsetX = 0;
                p.targetOffsetY = 0;
              }
            } else {
              p.targetOffsetX = 0;
              p.targetOffsetY = 0;
            }

            // Interpolation douce vers la cible (pas de saut brusque).
            p.offsetX += (p.targetOffsetX - p.offsetX) * NETWORK_CONFIG.mouseEase;
            p.offsetY += (p.targetOffsetY - p.offsetY) * NETWORK_CONFIG.mouseEase;

            const drawX = p.x + p.offsetX;
            const drawY = p.y + p.offsetY;
            const opacity = Math.min(1, breathe + NETWORK_CONFIG.mouseBoost * mouseInfluence) * p.fade;

            ctx.beginPath();
            ctx.fillStyle = `rgba(${NETWORK_CONFIG.dotColor}, ${opacity})`;
            ctx.shadowColor = `rgba(${NETWORK_CONFIG.dotColor}, ${opacity * 0.8})`;
            ctx.shadowBlur = NETWORK_CONFIG.glowBlur;
            ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
            ctx.fill();

            // Stocke la position dessinée pour le calcul des lignes ci-dessous.
            (p as any)._drawX = drawX;
            (p as any)._drawY = drawY;
            (p as any)._mouseInfluence = mouseInfluence;
          }

          ctx.shadowBlur = 0;

          // Lignes entre points proches (+ connexions temporaires élargies
          // près du curseur).
          for (let i = 0; i < points.length; i++) {
            const a = points[i] as any;
            for (let j = i + 1; j < points.length; j++) {
              const b = points[j] as any;
              const dx = a._drawX - b._drawX;
              const dy = a._drawY - b._drawY;
              const dist = Math.sqrt(dx * dx + dy * dy);

              const nearMouse = Math.max(a._mouseInfluence, b._mouseInfluence) > 0;
              const maxDist = nearMouse
                ? NETWORK_CONFIG.connectionDistance * NETWORK_CONFIG.mouseConnectionBoost
                : NETWORK_CONFIG.connectionDistance;

              if (dist < maxDist) {
                const lineOpacity =
                  (1 - dist / maxDist) * NETWORK_CONFIG.lineOpacityMax * Math.min(a.fade, b.fade);
                if (lineOpacity <= 0.005) continue;
                ctx.beginPath();
                ctx.strokeStyle = `rgba(${NETWORK_CONFIG.lineColor}, ${lineOpacity})`;
                ctx.lineWidth = NETWORK_CONFIG.lineWidth;
                ctx.moveTo(a._drawX, a._drawY);
                ctx.lineTo(b._drawX, b._drawY);
                ctx.stroke();
              }
            }
          }

          animationFrame = requestAnimationFrame(drawFrame);
        }

        // Personnes sensibles au mouvement : un seul rendu statique et discret,
        // pas de boucle d'animation, pas de suivi de souris.
        function drawStaticFrame() {
          ctx.clearRect(0, 0, width, height);
          const midOpacity = (NETWORK_CONFIG.opacityMin + NETWORK_CONFIG.opacityMax) / 2;
          for (const p of points) {
            ctx.beginPath();
            ctx.fillStyle = `rgba(${NETWORK_CONFIG.dotColor}, ${midOpacity * p.fade})`;
            ctx.arc(p.baseX, p.baseY, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        let resizeTimeout: ReturnType<typeof setTimeout>;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
            resize();
            if (reduceMotion) drawStaticFrame();
          }, 150);
        });

        resize();

        if (reduceMotion) {
          drawStaticFrame();
        } else {
          animationFrame = requestAnimationFrame(drawFrame);
        }
      }
    }
  </script>
</Base>

<style>
  /* =======================================================================
     HERO - variables : tout ce qu'on ajuste habituellement vit ici, rien
     d'autre à toucher pour retoucher le rendu.
     ======================================================================= */
  .hero {
    --hero-blue-dark: #081f4a; /* bleu marine profond et saturé (bord gauche du dégradé) - jamais noir */
    --hero-blue-light: #4fb8e0; /* bleu clair (bord droit, légèrement teinté, pas transparent) */
    --hero-wash-opacity: 0.35; /* colorisation froide uniforme sur toute la photo */
    --hero-vignette-opacity: 0.55; /* intensité de la vignette (jamais noire) */
    --hero-text-max-width: min(50vw, 41rem); /* largeur du bloc de texte */
    --hero-image-position-y: 82%; /* cadrage vertical de la photo (object-position) */
    --hero-height-ratio: 3; /* ratio largeur/hauteur du hero (aspect-ratio) */

    position: relative;
    overflow: hidden;
    aspect-ratio: var(--hero-height-ratio) / 1;
    /* Le ratio 3/1 seul rend le bloc trop bas pour son propre contenu
       (titre + texte + boutons) sur à peu près tout le spectre "tablette
       à ordinateur portable" (~640-1590px) : au ratio, la hauteur y est
       plus courte que le contenu, qui se fait alors couper net par
       l'overflow:hidden - jusqu'à 130px de boutons invisibles aux
       largeurs les plus étroites de cette plage. Ce plancher garantit
       assez de place quel que soit le nombre de lignes du titre ; au-delà
       d'environ 1590px, le ratio dépasse déjà ce plancher et reprend la main. */
    min-height: 35rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    align-items: center;
    text-align: left;
  }

  @media (max-width: 40rem) {
    .hero {
      aspect-ratio: auto;
      min-height: 24rem;
      /* Filtre légèrement renforcé sur mobile : le texte a moins de place
         pour respirer loin de la photo, il faut plus de contraste. */
      --hero-wash-opacity: 0.42;
    }
  }

  /* 1. La photo, intacte : pas de filter, pas de blur, pas de scale().
     object-fit: cover garde le niveau de zoom constant quel que soit
     object-position ; seule la fenêtre de cadrage se déplace. */
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--hero-image-position-y);
  }

  /* 2a. Colorisation froide légère, uniforme : donne l'impression d'une
     lumière naturellement bleutée plutôt qu'un voile plaqué dessus. */
  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--hero-blue-dark);
    opacity: var(--hero-wash-opacity);
    mix-blend-mode: color;
    pointer-events: none;
  }

  /* 2b. Le grand dégradé horizontal : nuit profonde à gauche (contraste
     pour le texte), transition douce, bleu clair à droite qui laisse la
     photo se révéler presque nature. */
  .hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--hero-blue-dark) 99%, transparent) 0%,
      color-mix(in srgb, var(--hero-blue-dark) 90%, transparent) 48%,
      color-mix(in srgb, var(--hero-blue-light) 40%, transparent) 78%,
      color-mix(in srgb, var(--hero-blue-light) 22%, transparent) 100%
    );
    pointer-events: none;
  }

  /* 2c. Vignette discrète, toujours dans les tons bleu nuit (jamais noire). */
  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      130% 130% at 50% 50%,
      transparent 55%,
      color-mix(in srgb, var(--hero-blue-dark) 60%, transparent) 100%
    );
    opacity: var(--hero-vignette-opacity);
    pointer-events: none;
  }

  /* 3. Flou de lisibilité : seulement une bande à gauche, derrière le
     texte, en flou dégressif (jamais un bord net) ; backdrop-filter
     floute ce qu'il y a dessous (la photo), pas la photo elle-même. */
  .hero-text-blur {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: min(48%, 44rem);
    backdrop-filter: blur(16px);
    mask-image: linear-gradient(to right, black 0%, black 55%, transparent 100%);
    pointer-events: none;
  }

  /* Separate rules, not extra declarations above: the build's CSS
     minifier treats a standard/-webkit- pair in the same block as
     redundant duplicates and silently drops one (see the identical fix
     on .site-header.is-scrolled in site.css for the full story). */
  @supports not (backdrop-filter: blur(1px)) {
    .hero-text-blur {
      -webkit-backdrop-filter: blur(16px);
    }
  }

  @supports not (mask-image: linear-gradient(black, black)) {
    .hero-text-blur {
      -webkit-mask-image: linear-gradient(to right, black 0%, black 55%, transparent 100%);
    }
  }

  /* Canvas du maillage : dernière couche visuelle, au-dessus du texte.
     pointer-events: none pour ne jamais bloquer les clics/liens - la
     distribution des points évite le centre pour ne jamais gêner la
     lecture même si le canvas passe visuellement par-dessus. */
  .hero-network {
    position: absolute;
    inset: 0;
    z-index: 7;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero .wrap {
    position: relative;
    z-index: 6;
    margin: 0;
    max-width: var(--hero-text-max-width);
    padding-left: clamp(1.5rem, 5vw, 5rem);
  }

  .hero h1 {
    font-size: clamp(1.73rem, 3.16vw, 2.72rem); /* -6% : titre plus discret, laisse respirer le reste */
    line-height: 1.2;
    margin: 0;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--bopa-blue-4);
  }

  .hero .lede {
    font-size: var(--text-base);
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.85);
    margin: var(--space-3) 0 0;
    /* Assez large pour que "hépato-bilio-pancréatique" (voir la balise
       .nowrap dessus) tienne sur 3 lignes sans se retrouver seul sur une
       4e ; suit le même ratio vw que .hero-text-blur pour ne jamais
       déborder de la zone floutée/lisible. */
    max-width: min(42vw, 36rem);
  }

  .hero .lede .nowrap {
    white-space: nowrap;
  }

  /* --hero-text-max-width and .lede's own max-width above are vw-based
     to track the desktop blur zone - on a narrow phone that same ratio
     caps the text at half the screen for no reason (there's no second
     column to leave room for). Full width instead, with a matching
     right inset. Placed after the base rules above so it actually wins
     the cascade (equal specificity, source order decides). */
  @media (max-width: 40rem) {
    .hero .wrap {
      max-width: none;
      padding-right: clamp(1.5rem, 5vw, 5rem);
    }

    .hero .lede {
      max-width: none;
    }
  }

  .hero-actions {
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-4);
    margin-top: calc(var(--space-4) + var(--space-2)); /* un peu plus d'air avant les boutons */
  }

  /* La couleur/animation vient des classes partagées .btn-outline-premium
     et .btn-filled-premium (site.css) ; ici on ne fixe que la taille,
     propre au contexte du hero. */
