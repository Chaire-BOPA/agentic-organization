  <script>
    // Envoi direct via Web3Forms : le visiteur n'a plus besoin de sa
    // propre messagerie, le message part depuis le formulaire.
    const form = document.getElementById('soutenir-form') as HTMLFormElement | null;
    const statusEl = form?.querySelector('.form-status') as HTMLElement | null;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!submitBtn || !statusEl) return;

      const originalLabel = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi...';
      statusEl.textContent = '';
      statusEl.classList.remove('is-error', 'is-success');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json();

        if (result.success) {
          form.reset();
          statusEl.textContent = 'Message envoyé. Merci, nous revenons vers vous rapidement.';
          statusEl.classList.add('is-success');
        } else {
          throw new Error(result.message ?? 'Échec de l\'envoi');
        }
      } catch {
        statusEl.textContent = 'Le message n\'a pas pu être envoyé. Réessayez ou écrivez-nous directement à charles.hellec@aphp.fr.';
        statusEl.classList.add('is-error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });

    // Accordions: closing sibling <details> when one opens, so only one
    // panel per level is expanded at a time (keeps the page scannable).
    const closeSiblings = (el: HTMLDetailsElement) => {
      const parent = el.parentElement;
      if (!parent) return;
      [...parent.children].forEach((sibling) => {
        if (sibling !== el && sibling instanceof HTMLDetailsElement) sibling.open = false;
      });
    };

    document.querySelectorAll<HTMLDetailsElement>('.accordion-item, .accordion-subitem, .phase-card').forEach((el) => {
      el.addEventListener('toggle', () => {
        if (el.open) closeSiblings(el);
      });
    });

  </script>

  <script>
    // ---------------------------------------------------------------------
    // Maillage numérique du hero : nuage de points reliés par de fines
    // lignes, posé au-dessus de la photo (jamais superposé au texte grâce
    // au z-index, jamais bloquant grâce à pointer-events: none sur le
    // canvas). Purement décoratif : n'ajoute ni organe, ni texte, ni forme
    // reconnaissable, juste des points + lignes.
    // ---------------------------------------------------------------------

    // ---- Réglages principaux : à ajuster ici, rien d'autre à toucher ----
    const NETWORK_CONFIG = {
      pointCountDesktop: 80, // nombre de points sur grand écran
      pointCountMobile: 32, // nombre de points sur mobile (perf)
      mobileBreakpoint: 640, // largeur (px) en dessous de laquelle on est "mobile"

      opacityMin: 0.32, // opacité minimale au repos (respiration) - nettement plus visible
      opacityMax: 0.75, // opacité maximale au repos (respiration)
      breatheSpeed: 0.0006, // vitesse de la respiration (plus petit = plus lent)

      driftSpeed: 0.0004, // vitesse du léger déplacement de certains points
      driftAmount: 3, // amplitude du déplacement (px)
      driftPointRatio: 0.35, // proportion de points qui dérivent un peu (les autres restent fixes)

      connectionDistance: 120, // distance max (px) pour relier deux points par une ligne
      lineOpacityMax: 0.38, // opacité max d'une ligne (à distance nulle)
      lineWidth: 0.8, // épaisseur des lignes (px)

      mouseRadius: 200, // rayon (px) d'influence de la souris autour d'un point
      mouseBoost: 0.4, // opacité supplémentaire max apportée par la proximité de la souris
      mouseDisplace: 7, // déplacement max (px) d'un point proche du curseur
      mouseConnectionBoost: 1.4, // multiplicateur de connectionDistance près du curseur
      mouseEase: 0.08, // vitesse de rappel/suivi vers la position cible (0-1, plus petit = plus doux)

      dotSizeMin: 2, // taille mini d'un point (px)
      dotSizeMax: 4, // taille maxi d'un point (px)
      glowBlur: 15, // flou du halo autour des points (shadowBlur) - halo bien plus présent

      dotColor: '225, 242, 255', // couleur des points, "r, g, b" (blanc légèrement bleuté, plus lumineux)
      lineColor: '225, 242, 255', // couleur des lignes, même teinte
    };

    const canvas = document.getElementById('hero-network') as HTMLCanvasElement | null;
    const heroSection = canvas?.closest('.hero') as HTMLElement | null;

    if (canvas && heroSection) {
      const ctx = canvas.getContext('2d');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (ctx) {
        type Point = {
          baseX: number;
          baseY: number;
          x: number;
          y: number;
          targetOffsetX: number;
          targetOffsetY: number;
          offsetX: number;
          offsetY: number;
          phase: number;
          drifts: boolean;
          fade: number; // facteur d'opacité selon la position (fondu à droite)
          size: number;
        };

        let points: Point[] = [];
        let width = 0;
        let height = 0;
        let dpr = Math.min(window.devicePixelRatio || 1, 2);
        let mouseX = -9999;
        let mouseY = -9999;
        let mouseActive = false;
        let animationFrame = 0;

        // Fondu du maillage vers la droite de l'image.
        // Poids de présence selon la position (0-1) : fort en bas à gauche,
        // fort en bas, fort à droite ; nettement plus discret au centre de
        // l'image pour ne jamais gêner la lecture du texte ni la scène.
        function presenceWeight(xRatio: number, yRatio: number) {
          const bottom = yRatio; // 0 en haut, 1 en bas
          const left = 1 - xRatio; // 1 au bord gauche
          const right = xRatio; // 1 au bord droit

          const bottomLeft = left * bottom;
          const bottomEdge = Math.pow(bottom, 1.4) * 0.75;
          const rightEdge = Math.pow(right, 1.6) * 0.85;

          let weight = Math.max(bottomLeft, bottomEdge, rightEdge);

          // Suppression additionnelle au centre géométrique de l'image.
          const dx = xRatio - 0.5;
          const dy = yRatio - 0.42; // le centre "utile" est un peu plus haut que le milieu
          const distFromCenter = Math.sqrt(dx * dx + dy * dy) / 0.5;
          const centerFactor = Math.min(1, 0.25 + 0.9 * distFromCenter);

          return Math.min(1, weight * centerFactor);
        }

        // Génère les points par échantillonnage pondéré : on tire des
        // positions uniformes et on ne garde que celles dont le poids de
        // présence "gagne" un tirage aléatoire, jusqu'à atteindre le
        // nombre de points visés.
        function createPoints() {
          const isMobile = width < NETWORK_CONFIG.mobileBreakpoint;
          const count = isMobile ? NETWORK_CONFIG.pointCountMobile : NETWORK_CONFIG.pointCountDesktop;
          const next: Point[] = [];
          const maxAttempts = count * 40;
          let attempts = 0;

          while (next.length < count && attempts < maxAttempts) {
            attempts++;
            const xRatio = Math.random();
            const yRatio = Math.random();
            const weight = presenceWeight(xRatio, yRatio);
            if (Math.random() > weight) continue;

            const baseX = xRatio * width;
            const baseY = yRatio * height;

            next.push({
              baseX,
              baseY,
              x: baseX,
              y: baseY,
              targetOffsetX: 0,
              targetOffsetY: 0,
              offsetX: 0,
              offsetY: 0,
              phase: Math.random() * Math.PI * 2,
              drifts: Math.random() < NETWORK_CONFIG.driftPointRatio,
              fade: 0.55 + weight * 0.45, // un peu de variation, jamais trop pâle
              size: NETWORK_CONFIG.dotSizeMin + Math.random() * (NETWORK_CONFIG.dotSizeMax - NETWORK_CONFIG.dotSizeMin),
            });
          }

          points = next;
        }

        // Redimensionne le canvas à la taille exacte de son conteneur.
        function resize() {
          const rect = heroSection.getBoundingClientRect();
          width = rect.width;
          height = rect.height;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          createPoints();
        }

        function onPointerMove(clientX: number, clientY: number) {
          const rect = heroSection.getBoundingClientRect();
          mouseX = clientX - rect.left;
          mouseY = clientY - rect.top;
          mouseActive = true;
        }

        heroSection.addEventListener('mousemove', (e) => onPointerMove(e.clientX, e.clientY));
        heroSection.addEventListener('mouseleave', () => {
          mouseActive = false;
          mouseX = -9999;
          mouseY = -9999;
        });

        function drawFrame(time: number) {
          ctx.clearRect(0, 0, width, height);

          for (const p of points) {
            // Respiration lente de l'opacité (indépendante par point via phase).
            const breathe =
              NETWORK_CONFIG.opacityMin +
              (NETWORK_CONFIG.opacityMax - NETWORK_CONFIG.opacityMin) *
                (0.5 + 0.5 * Math.sin(time * NETWORK_CONFIG.breatheSpeed + p.phase));

            // Léger déplacement, seulement pour une partie des points.
            if (p.drifts) {
              p.x = p.baseX + Math.sin(time * NETWORK_CONFIG.driftSpeed + p.phase) * NETWORK_CONFIG.driftAmount;
              p.y = p.baseY + Math.cos(time * NETWORK_CONFIG.driftSpeed + p.phase * 1.3) * NETWORK_CONFIG.driftAmount;
            } else {
              p.x = p.baseX;
              p.y = p.baseY;
            }

            // Interaction souris : halo plus lumineux + léger déplacement,
            // avec retour progressif quand le curseur s'éloigne.
            let mouseInfluence = 0;
            if (mouseActive) {
              const dx = p.x - mouseX;
              const dy = p.y - mouseY;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < NETWORK_CONFIG.mouseRadius) {
                mouseInfluence = 1 - dist / NETWORK_CONFIG.mouseRadius;
                const angle = Math.atan2(dy, dx);
                p.targetOffsetX = Math.cos(angle) * NETWORK_CONFIG.mouseDisplace * mouseInfluence;
                p.targetOffsetY = Math.sin(angle) * NETWORK_CONFIG.mouseDisplace * mouseInfluence;
              } else {
                p.targetOffsetX = 0;
                p.targetOffsetY = 0;
              }
            } else {
              p.targetOffsetX = 0;
              p.targetOffsetY = 0;
            }

            // Interpolation douce vers la cible (pas de saut brusque).
            p.offsetX += (p.targetOffsetX - p.offsetX) * NETWORK_CONFIG.mouseEase;
            p.offsetY += (p.targetOffsetY - p.offsetY) * NETWORK_CONFIG.mouseEase;

            const drawX = p.x + p.offsetX;
            const drawY = p.y + p.offsetY;
            const opacity = Math.min(1, breathe + NETWORK_CONFIG.mouseBoost * mouseInfluence) * p.fade;

            ctx.beginPath();
            ctx.fillStyle = `rgba(${NETWORK_CONFIG.dotColor}, ${opacity})`;
            ctx.shadowColor = `rgba(${NETWORK_CONFIG.dotColor}, ${opacity * 0.8})`;
            ctx.shadowBlur = NETWORK_CONFIG.glowBlur;
            ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
            ctx.fill();

            // Stocke la position dessinée pour le calcul des lignes ci-dessous.
            (p as any)._drawX = drawX;
            (p as any)._drawY = drawY;
            (p as any)._mouseInfluence = mouseInfluence;
          }

          ctx.shadowBlur = 0;

          // Lignes entre points proches (+ connexions temporaires élargies
          // près du curseur).
          for (let i = 0; i < points.length; i++) {
            const a = points[i] as any;
            for (let j = i + 1; j < points.length; j++) {
              const b = points[j] as any;
              const dx = a._drawX - b._drawX;
              const dy = a._drawY - b._drawY;
              const dist = Math.sqrt(dx * dx + dy * dy);

              const nearMouse = Math.max(a._mouseInfluence, b._mouseInfluence) > 0;
              const maxDist = nearMouse
                ? NETWORK_CONFIG.connectionDistance * NETWORK_CONFIG.mouseConnectionBoost
                : NETWORK_CONFIG.connectionDistance;

              if (dist < maxDist) {
                const lineOpacity =
                  (1 - dist / maxDist) * NETWORK_CONFIG.lineOpacityMax * Math.min(a.fade, b.fade);
                if (lineOpacity <= 0.005) continue;
                ctx.beginPath();
                ctx.strokeStyle = `rgba(${NETWORK_CONFIG.lineColor}, ${lineOpacity})`;
                ctx.lineWidth = NETWORK_CONFIG.lineWidth;
                ctx.moveTo(a._drawX, a._drawY);
                ctx.lineTo(b._drawX, b._drawY);
                ctx.stroke();
              }
            }
          }

          animationFrame = requestAnimationFrame(drawFrame);
        }

        // Personnes sensibles au mouvement : un seul rendu statique et discret,
        // pas de boucle d'animation, pas de suivi de souris.
        function drawStaticFrame() {
          ctx.clearRect(0, 0, width, height);
          const midOpacity = (NETWORK_CONFIG.opacityMin + NETWORK_CONFIG.opacityMax) / 2;
          for (const p of points) {
            ctx.beginPath();
            ctx.fillStyle = `rgba(${NETWORK_CONFIG.dotColor}, ${midOpacity * p.fade})`;
            ctx.arc(p.baseX, p.baseY, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        let resizeTimeout: ReturnType<typeof setTimeout>;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(() => {
            resize();
            if (reduceMotion) drawStaticFrame();
          }, 150);
        });

        resize();

        if (reduceMotion) {
          drawStaticFrame();
        } else {
          animationFrame = requestAnimationFrame(drawFrame);
        }
      }
    }
  </script>
</Base>

<style>
  /* =======================================================================
     HERO - variables : tout ce qu'on ajuste habituellement vit ici, rien
     d'autre à toucher pour retoucher le rendu.
     ======================================================================= */
  .hero {
    --hero-blue-dark: #081f4a; /* bleu marine profond et saturé (bord gauche du dégradé) - jamais noir */
    --hero-blue-light: #4fb8e0; /* bleu clair (bord droit, légèrement teinté, pas transparent) */
    --hero-wash-opacity: 0.35; /* colorisation froide uniforme sur toute la photo */
    --hero-vignette-opacity: 0.55; /* intensité de la vignette (jamais noire) */
    --hero-text-max-width: max(35rem, min(54vw, 43rem)); /* largeur du bloc de texte - plancher fixe ajouté (2026-08-27) pour garder le lede en 3 lignes après l'harmonisation typographique, y compris aux largeurs où la police reste bloquée à son minimum */
    --hero-image-position-y: 82%; /* cadrage vertical de la photo (object-position) */
    --hero-height-ratio: 3; /* ratio largeur/hauteur du hero (aspect-ratio) */

    position: relative;
    overflow: hidden;
    aspect-ratio: var(--hero-height-ratio) / 1;
    /* Le ratio 3/1 seul rend le bloc trop bas pour son propre contenu
       (titre + texte + boutons) sur à peu près tout le spectre "tablette
       à ordinateur portable" (~640-1590px) : au ratio, la hauteur y est
       plus courte que le contenu, qui se fait alors couper net par
       l'overflow:hidden - jusqu'à 130px de boutons invisibles aux
       largeurs les plus étroites de cette plage. Ce plancher garantit
       assez de place quel que soit le nombre de lignes du titre ; au-delà
       d'environ 1590px, le ratio dépasse déjà ce plancher et reprend la main. */
    min-height: 35rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    display: flex;
    align-items: center;
    text-align: left;
  }

  @media (max-width: 40rem) {
    .hero {
      aspect-ratio: auto;
      min-height: 24rem;
      /* Filtre légèrement renforcé sur mobile : le texte a moins de place
         pour respirer loin de la photo, il faut plus de contraste. */
      --hero-wash-opacity: 0.42;
    }
  }

  /* 1. La photo, intacte : pas de filter, pas de blur, pas de scale().
     object-fit: cover garde le niveau de zoom constant quel que soit
     object-position ; seule la fenêtre de cadrage se déplace. */
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center var(--hero-image-position-y);
  }

  /* 2a. Colorisation froide légère, uniforme : donne l'impression d'une
     lumière naturellement bleutée plutôt qu'un voile plaqué dessus. */
  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--hero-blue-dark);
    opacity: var(--hero-wash-opacity);
    mix-blend-mode: color;
    pointer-events: none;
  }

  /* 2b. Le grand dégradé horizontal : nuit profonde à gauche (contraste
     pour le texte), transition douce, bleu clair à droite qui laisse la
     photo se révéler presque nature. */
  .hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--hero-blue-dark) 99%, transparent) 0%,
      color-mix(in srgb, var(--hero-blue-dark) 90%, transparent) 48%,
      color-mix(in srgb, var(--hero-blue-light) 40%, transparent) 78%,
      color-mix(in srgb, var(--hero-blue-light) 22%, transparent) 100%
    );
    pointer-events: none;
  }

  /* 2c. Vignette discrète, toujours dans les tons bleu nuit (jamais noire). */
  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      130% 130% at 50% 50%,
      transparent 55%,
      color-mix(in srgb, var(--hero-blue-dark) 60%, transparent) 100%
    );
    opacity: var(--hero-vignette-opacity);
    pointer-events: none;
  }

  /* 3. Flou de lisibilité : seulement une bande à gauche, derrière le
     texte, en flou dégressif (jamais un bord net) ; backdrop-filter
     floute ce qu'il y a dessous (la photo), pas la photo elle-même. */
  .hero-text-blur {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: max(37rem, min(56vw, 45rem)); /* élargi (2026-08-27) pour suivre --hero-text-max-width, avec ~2rem de marge */
    backdrop-filter: blur(16px);
    mask-image: linear-gradient(to right, black 0%, black 55%, transparent 100%);
    pointer-events: none;
  }

  /* Separate rules, not extra declarations above: the build's CSS
     minifier treats a standard/-webkit- pair in the same block as
     redundant duplicates and silently drops one (see the identical fix
     on .site-header.is-scrolled in site.css for the full story). */
  @supports not (backdrop-filter: blur(1px)) {
    .hero-text-blur {
      -webkit-backdrop-filter: blur(16px);
    }
  }

  @supports not (mask-image: linear-gradient(black, black)) {
    .hero-text-blur {
      -webkit-mask-image: linear-gradient(to right, black 0%, black 55%, transparent 100%);
    }
  }

  /* Canvas du maillage : dernière couche visuelle, au-dessus du texte.
     pointer-events: none pour ne jamais bloquer les clics/liens - la
     distribution des points évite le centre pour ne jamais gêner la
     lecture même si le canvas passe visuellement par-dessus. */
  .hero-network {
    position: absolute;
    inset: 0;
    z-index: 7;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero .wrap {
    position: relative;
    z-index: 6;
    margin: 0;
    max-width: var(--hero-text-max-width);
    padding-left: clamp(1.5rem, 5vw, 5rem);
  }

  /* Harmonisation typographique Niveau 1 (2026-08-27) : mêmes métriques
     que le H2 de Notre Mission (étalon), quel que soit ce que la
     règle de base h1/h2/h3 (site.css) impose par ailleurs. */
  .hero h1 {
    font-size: clamp(2rem, 3.1vw, 3.15rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--bopa-blue-4);
  }

  /* Harmonisation typographique Niveau 2 (2026-08-27) : mêmes métriques
     que le lede de Notre Mission (étalon). */
  .hero .lede {
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    margin: var(--space-3) 0 0;
    /* Assez large pour que "hépato-bilio-pancréatique" (voir la balise
       .nowrap dessus) tienne sur 3 lignes sans se retrouver seul sur une
       4e ; suit le même ratio vw que .hero-text-blur pour ne jamais
       déborder de la zone floutée/lisible. Un simple ratio vw (même
       généreux) ne suffisait pas : entre ~640px et ~1230px la police
       reste bloquée à son minimum (clamp), donc la largeur disponible
       continuait de rétrécir avec le viewport sans que le texte
       rétrécisse - d'où le plancher fixe (34rem) qui garantit 3 lignes
       même dans cette zone, vérifié à 700/768/1024/1150/1440px. */
    max-width: max(34rem, min(53vw, 42rem));
  }

  .hero .lede .nowrap {
    white-space: nowrap;
  }

  /* --hero-text-max-width and .lede's own max-width above are vw-based
     to track the desktop blur zone - on a narrow phone that same ratio
     caps the text at half the screen for no reason (there's no second
     column to leave room for). Full width instead, with a matching
     right inset. Placed after the base rules above so it actually wins
     the cascade (equal specificity, source order decides). */
  @media (max-width: 40rem) {
    .hero .wrap {
      max-width: none;
      padding-right: clamp(1.5rem, 5vw, 5rem);
    }

    .hero .lede {
      max-width: none;
    }
  }

  .hero-actions {
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-4);
    margin-top: calc(var(--space-4) + var(--space-2)); /* un peu plus d'air avant les boutons */
  }

  /* La couleur/animation vient des classes partagées .btn-outline-premium
     et .btn-filled-premium (site.css) ; ici on ne fixe que la taille,
     propre au contexte du hero. */
  .hero-actions .btn {
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    text-transform: none;
    letter-spacing: normal;
    font-size: 0.93rem; /* +6% sur var(--text-sm) (correctif 2026-08-27) */
  }

  @media (max-width: 40rem) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      /* Le padding horizontal desktop (var(--space-5), 64px) était pensé
         pour un bouton qui ne fait que la largeur de son texte - une fois
         étiré pleine largeur (align-items: stretch ci-dessus), il laissait
         le texte écrasé au centre avec deux grandes zones vides de
         chaque côté. */
      padding: var(--space-3) var(--space-4);
      text-align: center;
    }
  }

  /* Bandeau institutionnel juste sous le Hero : section normale dans le
     flux (aucune marge négative, jamais de superposition sur le Hero),
     fond blanc à peine teinté de bleu, une bordure basse fine pour créer
     une vraie rupture visuelle avec la section suivante - sobre, pas de
     grosse carte flottante ni d'ombre marquée. */
  .text-muted {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .section-sub {
    margin-top: var(--space-4);
  }

  /* "Les réalisations institutionnelles" used to be its own big
     click-to-expand accordion trigger; now it's just a heading (its
     BOPEX/BOPTECH children stay small accordions, that level of detail
     still benefits from being collapsed). */
  .institutional-subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }

  /* Own class on the carousel's wrap so it can override .section-sub's
     generic margin-top (8rem) - a tighter gap right above the carousel
     reads better than the rhythm used between the bigger sub-blocks. */
  .carousel-wrap {
    margin-top: var(--space-4);
  }

  .carousel-more {
    text-align: center;
    margin-top: var(--space-3);
  }

  .carousel-more a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .carousel-more a:hover {
    color: var(--color-accent);
  }

  .carousel-more svg {
    transition: transform 0.2s ease;
  }

  .carousel-more a:hover svg {
    transform: translateX(2px);
  }

  /* mission -> projets -> vision s'enchaînent directement. Vision ajoutée
     ici 2026-08-27 (harmonisation V4) : c'est ce qui donne à Mission son
     padding réel de 64px (pas les clamp() de .bopa-mission-v2, qui sont
     silencieusement battus par cet id sur la spécificité) - Vision doit
     avoir exactement le même padding réel, pas seulement la même formule
     de clamp(), pour rester identique à Mission à toutes les largeurs. */
  #notre-mission,
  #innovations-bopa,
  #notre-vision {
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
  }

  .team-gallery-wrap {
    margin-top: var(--space-5);
  }

  /* Owner found the single full-width crossfade slide "too big" and hard
     to browse (small corner dots, easy to miss) - a plain grid shows
     every photo at once, smaller, with nothing to navigate. Any number of
     photos: auto-fit wraps to more rows as the folder grows. */
  .team-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
  }

  .team-gallery-photo {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 40px -20px rgba(4, 35, 56, 0.25);
  }

  .team-gallery-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Accordion: wide category triggers, native <details>/<summary> so
     open/close and keyboard behavior come free from the browser. */
  .accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .accordion-item-lg > summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .accordion-item-lg > summary::-webkit-details-marker {
    display: none;
  }

  .accordion-item-lg > summary:hover {
    background: var(--color-bg-tint);
    box-shadow: 0 8px 20px rgba(4, 35, 56, 0.08);
    transform: translateY(-2px);
  }

  .accordion-icon {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .accordion-title {
    flex: 1;
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .accordion-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .accordion-item[open] > summary .accordion-chevron,
  .accordion-subitem[open] > summary .accordion-chevron,
  .phase-card[open] > summary .accordion-chevron {
    transform: rotate(180deg);
  }

  .accordion-panel {
    padding: var(--space-4) var(--space-2) 0;
  }

  .accordion-subgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-3);
    /* Grid items stretch to the row's tallest sibling by default, so
       opening BOPEX made the still-closed BOPTECH card grow to match -
       looked like both expanded together. Let each size to its own
       content instead, so they're visually independent. */
    align-items: start;
  }

  .accordion-subitem {
    background: var(--color-bg-tint);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow 0.25s ease;
  }

  .accordion-subitem:hover {
    box-shadow: 0 8px 20px rgba(4, 35, 56, 0.06);
  }

  .accordion-subitem > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }

  .accordion-subitem > summary::-webkit-details-marker {
    display: none;
  }

  .accordion-subpanel {
    padding: 0 var(--space-4) var(--space-4);
    color: var(--color-ink);
    opacity: 0.85;
  }

  .accordion-subpanel p + p {
    margin-top: var(--space-2);
  }

  .phase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
  }

  .phase-card {
    background: color-mix(in srgb, var(--step-color) 10%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--step-color) 22%, var(--color-line));
    border-top: 3px solid var(--step-color);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.25s ease;
  }

  .phase-card:hover {
    box-shadow: 0 8px 20px rgba(4, 35, 56, 0.07);
  }

  .phase-card > summary {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  .phase-card > summary::-webkit-details-marker {
    display: none;
  }

  .phase-title {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .phase-subtitle {
    font-size: var(--text-sm);
    color: var(--step-color);
    font-weight: 600;
    margin-top: var(--space-1);
  }

  .project-entry + .project-entry {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .project-entry h4 {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .project-entry p {
    color: var(--color-ink);
    opacity: 0.85;
    margin-top: var(--space-1);
  }

  @media (max-width: 48rem) {
    .accordion-item-lg > summary {
      padding: var(--space-3) var(--space-4);
    }

    .accordion-title {
      font-size: var(--text-base);
    }
  }

  /* ============================================================
     BOPA - Qui sommes-nous V2
     Réf. : CLAUDE-INTEGRATION.md + REFERENCE-QUI-SOMMES-NOUS.png (2026-08-27)
     Réutilise --mp-navy-deep/--mp-blue-bright (voir site.css, scope
     étendu à .about-v2) pour rester dans le même langage visuel que
     Mission/Projets/Innovations.
     ============================================================ */
  .about-v2 {
    --about-ink: var(--color-ink);
    --about-muted: var(--color-muted);
    --about-line: var(--color-line);
    --about-bg: var(--color-bg-tint);
    overflow: clip;
    background: var(--about-bg);
    color: var(--about-ink);
  }

  .about-v2 .wrap { max-width: var(--max-width); }
  .about-v2 h2,
  .about-v2 h3,
  .about-v2 h4,
  .about-v2 h5 { font-family: var(--font-display); letter-spacing: var(--tracking-tight); }
  .about-v2 p,
  .about-v2 span,
  .about-v2 a { font-family: var(--font-text); }

  /* Espace avant "QUI SOMMES-NOUS ?" harmonisé avec le début des autres
     grandes sections (2026-08-28, correctifs V4) : .about-v2 porte aussi
     .section-block, dont la règle générique (site.css) donne déjà un
     padding-top - .about-v2__intro ajoutait EN PLUS le sien par-dessus,
     doublant l'espace. Fix : une seule source, le même id-override que
     Mission/Innovations/Vision (var(--space-5), 64px), et
     .about-v2__intro n'a plus son propre padding-top. Seul le haut est
     repris ici - le bas de #qui-sommes-nous sert aux sous-sections 02/03,
     hors périmètre de ce correctif. */
  #qui-sommes-nous { padding-top: var(--space-5); }

  .about-v2__intro {
    text-align: center;
    padding-bottom: 0;
  }
  /* Spécificité : .section-block:not(.hero) h2 (site.css) a la même
     spécificité qu'une classe seule et gagnait sur .about-v2__intro-title,
     imposant --text-xl au lieu de l'échelle Mission/Innovations/Vision -
     préfixer par l'id #qui-sommes-nous pour trancher sans ambiguïté.
     margin-top à 0 (finitions V2, 2026-08-28) : le vrai écart
     eyebrow -> titre vient déjà de .about-v2__kicker (margin-bottom
     .85rem, identique à .bopa-eyebrow/.bopa-vision-v4__eyebrow) - un
     margin-top ici en plus doublait l'écart (31px mesuré au lieu des
     13.6px de Mission/Vision). */
  #qui-sommes-nous .about-v2__intro-title {
    margin: 0 auto;
    max-width: 49rem;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.1vw, 3.15rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-align: center;
  }
  #qui-sommes-nous .about-v2__intro-lede {
    margin: 1.45rem auto 0;
    max-width: 52rem;
    color: var(--about-ink);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    text-align: center;
  }
  /* Même langage graphique que .bopa-eyebrow (Mission/Innovations) et
     .bopa-vision-v4__eyebrow (Vision) - owner's explicit request,
     2026-08-27/28, refonte Chaire d'excellence : plus de soulignement
     décoratif, mêmes taille/graisse/espacement que les 3 autres.
     display:block + text-align:left (finitions V3, 2026-08-28) :
     reprend exactement le traitement de .bopa-vision-v4__eyebrow (bloc
     pleine largeur, aligné à gauche du même conteneur) - seul l'eyebrow
     passe à gauche, .about-v2__intro-title/-lede gardent leur propre
     text-align:center explicite juste en dessous. */
  .about-v2__kicker {
    display: block;
    text-align: left;
    margin-bottom: 0.85rem;
    color: var(--mp-blue-bright);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  /* ------------------------------------------------------------
     "Une Chaire d'excellence" (01) - correctifs V4, 2026-08-28 :
     harmonisation pure avec Mission/Innovations/Vision, pas de refonte.
     Plus de maillage/image décorative (retiré, non remplacé) ; plus de
     trait sous "01" ; plus de "CO-PORTÉE PAR" (les logos remontent) ;
     un nouveau niveau de hiérarchie interne (.about-v2__chaire-heading)
     partagé par les 3 titres de sous-bloc ; chiffres académiques et de
     valorisation ramenés à l'échelle de .about-v2__clinical-stat (02,
     juste en dessous) - plus élégante, moins "dashboard" que --text-2xl.
     Fond = --about-bg, texte = --about-ink/--color-navy, accent =
     --bopa-cyan - aucune nouvelle nuance. .about-v2__chaire-number
     reste PROPRE à cette sous-section (01) : .about-v2__chapter-number
     reste partagée par 02/03, non touchée par ce pack.
     L'espace avant "01" a été réduit deux fois (V3 puis V4, 2026-08-28) :
     valeur réelle de Mission -> var(--space-5) (64px, encore jugé trop
     grand) -> var(--space-4) (32px), le palier immédiatement en dessous
     dans l'échelle --space du projet - une "petite respiration
     éditoriale" plutôt qu'un grand vide, sans inventer de valeur hors
     de l'échelle. */
  .about-v2__chaire {
    padding-top: var(--space-4);
    padding-bottom: clamp(4.5rem, 7vw, 6.5rem);
  }

  .about-v2__chaire-marker {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .about-v2__chaire-number {
    color: var(--bopa-cyan);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 700;
    line-height: 1;
  }
  .about-v2__chaire-marker-divider {
    width: 1px;
    height: 2.1rem;
    background: var(--about-line);
    flex-shrink: 0;
  }
  .about-v2__chaire-marker-title {
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .about-v2__chaire-lede {
    max-width: 50rem;
    color: var(--about-ink);
    font-size: 1rem;
    line-height: 1.7;
  }
  .about-v2__chaire-lede + .about-v2__chaire-lede { margin-top: 1.1rem; }
  .about-v2__chaire-lede strong { color: var(--color-navy); font-weight: 700; }
  .about-v2__chaire-lede--narrow { max-width: 34rem; }
  .about-v2__chaire-highlight { color: var(--bopa-cyan); }

  /* Colonnes à largeur bornée (finitions V4-bis, 2026-08-28) - un vrai
     bug trouvé et corrigé ici : avec `minmax(0, 1fr)` la colonne de
     texte absorbait TOUT l'espace restant de la grille (952px mesuré),
     bien plus large que le texte réellement visible (max-width:50rem
     du paragraphe, ~800px) - un "espace mort" invisible de ~158px
     entre la fin réelle du texte et le début de la colonne logos, qui
     s'ajoutait au `gap` et rendait le rapprochement demandé invisible
     malgré un gap réduit. Fix : plafonner la colonne de texte à
     `minmax(0, 50rem)` (le même 50rem que .about-v2__chaire-lede) pour
     qu'elle épouse exactement la largeur réelle du texte, plus de
     colonne logos à largeur fixe (12.5rem, le max-width réel des
     logos - "auto" s'effondre à 0px tant que les <img loading="lazy">
     n'ont pas chargé). Le `gap` mesure maintenant vraiment la distance
     visible entre texte et logos, vérifié via getBoundingClientRect
     sur le texte (Range) et l'image plutôt que sur les cellules de
     grille. */
  .about-v2__chaire-foundation {
    display: grid;
    grid-template-columns: minmax(0, 50rem) 12.5rem;
    gap: 2.75rem;
    align-items: stretch;
  }

  /* Plus de barre verticale (finitions V2) - logos centrés sur leur
     propre axe optique (align-items:center, pas flex-start). */
  .about-v2__chaire-partners {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.1rem, 2vw, 1.5rem);
  }
  /* Le mécanisme reste le centrage exact sur les 2 paragraphes (grid
     align-items:stretch + justify-content:center, voir .about-v2__chaire-
     partners) - mais l'owner a explicitement redemandé de remonter le
     groupe au-delà de ce centre exact, en autorisant un chevauchement
     visuel avec ce qu'il y a au-dessus si nécessaire (2026-08-28, retour
     verbal, remonté une troisième fois). Nudge manuel assumé, pas une
     correction de bug - le centrage géométrique reste juste, ceci le
     décale volontairement. Décalage horizontal (8.5rem, dont seule la
     moitié se voit sur un flex item centré - voir design.md) pour
     centrer le groupe sur le chiffre "8" (dernier indicateur) du
     bandeau juste en dessous - calibré à la largeur desktop courante
     (~1440px), à revérifier si la largeur du bandeau change un jour. */
  .about-v2__chaire-partners-logos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: -2.25rem;
    margin-left: 8.5rem;
  }
  .about-v2__chaire-partners-logos img {
    max-width: 12.5rem;
    max-height: 4.1rem;
    width: auto;
    height: auto;
    object-fit: contain;
    transform: scale(var(--logo-scale, 1));
  }

  /* Bandeau bleu des 4 chiffres académiques (2026-08-28, pack "01 exact") -
     seul élément à casser le fond blanc dans cette sous-section, sur
     --mp-navy (même bleu marine que Notre Mission, aucune nouvelle
     nuance). Chiffres à l'échelle de .about-v2__clinical-stat (déjà la
     référence "élégante, non-dashboard" retenue lors des correctifs V4). */
  /* Largeur : pleine largeur du .wrap (revenu en arrière une fois vu en
     place plus étroit). Hauteur réduite une troisième fois (2026-08-28,
     retour verbal) - l'owner autorise cette fois à réduire aussi les
     pictos/chiffres pour y arriver, plutôt que le padding seul. */
  .about-v2__chaire-band {
    margin-top: clamp(2rem, 3.5vw, 3rem);
    display: flex;
    background: var(--mp-navy);
    border-radius: 1rem;
    padding: clamp(0.75rem, 1.4vw, 1.15rem) clamp(1.25rem, 3vw, 2rem);
  }
  .about-v2__chaire-band-stat {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 clamp(0.5rem, 2vw, 1.25rem);
  }
  .about-v2__chaire-band-stat + .about-v2__chaire-band-stat {
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .about-v2__chaire-band-icon {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--bopa-cyan);
    margin-bottom: 0.6rem;
  }
  .about-v2__chaire-band-icon svg { width: 1.05rem; height: 1.05rem; }
  .about-v2__chaire-band-stat strong {
    display: block;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    font-weight: 700;
    line-height: 1;
  }
  .about-v2__chaire-band-stat span {
    display: block;
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  /* ------------------------------------------------------------
     "De la recherche à l'impact" (2026-08-28) - directement sous le
     bandeau bleu (figé, non touché). Remplace les anciens blocs
     "De la recherche au terrain"/"Faire sortir l'innovation du
     laboratoire". Deux vraies cartes cette fois (fond blanc, bordure
     fine var(--about-line), coins arrondis) - contrairement au reste
     de la sous-section 01, volontairement sans carte jusqu'ici - la
     référence fournie les demande explicitement. Palette strictement
     BOPA (--color-navy/--bopa-cyan/--about-bg/blanc) : le modèle
     utilisait du orange pour différencier le 2e bloc, remplacé ici
     par le même cyan que le premier - aucune nouvelle teinte. Pas de
     logos Colette/MesGardes (aucun asset validé) : cités en texte
     dans la checklist seulement, à la demande explicite de l'owner.
     ------------------------------------------------------------ */
  .about-v2__impact { margin-top: clamp(3rem, 5vw, 4rem); }
  .about-v2__impact-title {
    position: relative;
    display: inline-block;
    margin: 0 0 1.1rem;
    padding-bottom: 0.75rem;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.6vw, 2.15rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .about-v2__impact-title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2.5rem;
    height: 2px;
    border-radius: 999px;
    background: var(--bopa-cyan);
  }
  /* Utilise toute la largeur disponible (2026-08-28, retour owner) -
     pas de max-width étroit comme .about-v2__chaire-lede--narrow. */
  .about-v2__impact-intro { max-width: none; }

  .about-v2__impact-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }
  .about-v2__impact-card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #fff, var(--about-bg));
    border: 1px solid var(--about-line);
    border-radius: 1rem;
    padding: clamp(1.15rem, 1.8vw, 1.4rem) clamp(1.5rem, 2.6vw, 1.9rem) clamp(1.4rem, 2.2vw, 1.65rem);
  }

  /* Picto + titre sur la même ligne de tête (pack "impact-cards-exact",
     2026-08-28) - point explicitement demandé par l'owner et par le
     visuel de référence, remplace l'ancien empilement vertical.
     Resserré (2026-08-28, retour owner "trop haut") : titre plus près
     du bord haut de la carte et espacements internes réduits partout. */
  .about-v2__impact-card-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .about-v2__impact-card-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--about-bg);
    border: 1px solid var(--about-line);
    color: var(--bopa-cyan);
  }
  .about-v2__impact-card-icon svg { width: 1.6rem; height: 1.6rem; }
  .about-v2__impact-card-title {
    position: relative;
    display: inline-block;
    margin: 0.15rem 0 0;
    padding-bottom: 0.65rem;
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .about-v2__impact-card-title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1.75rem;
    height: 2px;
    border-radius: 999px;
    background: var(--bopa-cyan);
  }
  .about-v2__impact-card-text {
    max-width: none;
    margin: 0 0 1rem;
    color: var(--about-ink);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* La carte est en colonne flex (voir .about-v2__impact-card) et la
     checklist grandit pour absorber tout l'espace restant (2026-08-28,
     retour owner : la carte de gauche laissait un vide en bas car son
     contenu était naturellement plus court que celui de droite) -
     justify-content:space-between répartit les 4 items sur toute la
     hauteur disponible plutôt que de les laisser groupés en haut. */
  .about-v2__impact-checklist {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-v2__impact-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.55rem 0;
  }
  .about-v2__impact-checklist li + li { border-top: 1px dashed var(--about-line); }
  .about-v2__impact-check {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.1rem;
    color: var(--bopa-cyan);
  }
  .about-v2__impact-check svg { width: 1.4rem; height: 1.4rem; }
  .about-v2__impact-result strong {
    display: block;
    color: var(--bopa-cyan);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .about-v2__impact-result-text {
    display: block;
    margin-top: 0.2rem;
    color: var(--about-muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  /* BOPEX/BOPTECH - logos "beaucoup plus grands" (pack, 2026-08-28) :
     vrais assets à leur propre ratio (BOpEx = wordmark large et plat,
     BOPTECH = badge circulaire) - tailles très différentes l'une de
     l'autre, volontairement, plutôt que forcées à une hauteur commune. */
  .about-v2__impact-partners {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
    margin-top: 1rem;
    text-align: center;
  }
  .about-v2__impact-partner:last-child {
    padding-left: clamp(1.5rem, 3vw, 2rem);
    border-left: 1px solid var(--about-line);
  }
  .about-v2__impact-partner-label {
    margin: 0 0 0.65rem;
    color: var(--color-navy);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: center;
  }
  /* Zone logo à hauteur fixe partagée (2026-08-28, retour owner) - BOpEx
     (wordmark large et plat) et BOPTECH (badge carré) ont des tailles
     très différentes ; sans cette réservation de hauteur commune, la
     description de chaque colonne démarrait à une hauteur différente
     selon la taille réelle du logo. Les deux logos sont centrés dans
     ce même espace, quelle que soit leur taille propre. */
  /* Alignés en haut (flex-start) plutôt que centrés (2026-08-28, retour
     owner) - BOPTECH (le plus grand des deux, 9rem) remonte au sommet
     du slot ; BOpEx (bien plus petit) s'aligne pareil, sur le même
     bord haut, plutôt que de flotter au milieu d'un espace réservé
     pour le plus grand des deux. Hauteur du slot ramenée à 9rem (pile
     la taille de BOPTECH, plus de marge inutile) et l'écart avant la
     description resserré - les deux descriptions démarrent toujours
     à la même hauteur, la hauteur du slot restant partagée. */
  .about-v2__impact-partner-logo {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    height: 9rem;
    margin-bottom: 0.4rem;
  }
