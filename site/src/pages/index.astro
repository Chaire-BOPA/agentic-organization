  }
  .about-v2__person-photo {
    width: 100%;
    aspect-ratio: 1.34 / 1;
    background: #edf2f8;
  }
  .about-v2__person-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .about-v2__photo-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #edf2f8, #f8fbff); }
  .about-v2__person-body { flex: 1; display: flex; flex-direction: column; padding: 1.25rem 1.25rem 1.4rem; }
  .about-v2__person-body h4 { margin: 0 0 .35rem; color: var(--color-navy); font-size: 1.1rem; font-weight: 700; }
  .about-v2__person-body .about-v2__credentials { margin: 0; min-height: 1.3em; color: var(--bopa-cyan); font-size: .95rem; font-weight: 700; line-height: 1.3; }
  .about-v2__person-divider { display: block; width: 1.75rem; height: 1px; margin: .75rem 0; background: var(--about-line); }
  .about-v2__person-role { margin: 0; min-height: 4.28rem; color: var(--about-ink); font-size: .92rem; line-height: 1.55; }
  .about-v2__linkedin { display: inline-flex; align-items: center; gap: .4rem; margin-top: .65rem; color: var(--color-accent); font-size: .9rem; font-weight: 700; }
  .about-v2__linkedin-icon { width: 1.35rem; height: 1.35rem; display: grid; place-items: center; border-radius: 3px; background: var(--color-accent); color: #fff; font-size: .7rem; font-weight: 800; }

