  @media (max-width: 980px) {
    .about-v2__eco-grid { grid-template-columns: 1fr; }
    .about-v2__eco-photo { max-width: 32rem; }
    .about-v2__team-row { grid-template-columns: 1fr; }
    .about-v2__team-intro { max-width: 36rem; }
    .about-v2__team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about-v2__support-head { max-width: 46rem; }
  }

  @media (max-width: 800px) {
    .about-v2__chaire-foundation { grid-template-columns: 1fr; gap: clamp(2rem, 6vw, 2.75rem); }
    /* Le décalage horizontal desktop (aligner sur le "8" du bandeau,
       qui n'a plus de sens une fois le bandeau replié en grille 2x2)
       et le chevauchement vertical n'ont plus lieu d'être en colonne
       unique - les logos redeviennent simplement centrés sous le texte. */
    .about-v2__chaire-partners-logos { margin-top: 0; margin-left: 0; }
    .about-v2__impact-cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 680px) {
    /* BOPEX resserré / BOPEX -> BOPTECH plus marqué (pack "Mobile-Qui-
       Sommes-Nous-Impact-BOPEX-Espacements-V1", 2026-09-04) - le `gap`
       de cette grille (1 seule valeur, puisqu'il n'y a que 2 éléments)
       devient exactement la coupure BOPEX -> BOPTECH une fois empilée en
       colonne unique : 1.5rem -> 3rem, une rupture nette plutôt qu'un
       espacement générique entre colonnes. BOPTECH lui-même (logo/texte/
       espacements internes) n'est touché nulle part dans ce bloc. */
    .about-v2__impact-partners { grid-template-columns: 1fr; gap: 3rem; }
    .about-v2__impact-partner:last-child { padding-left: 0; border-left: 0; }
    /* Le slot logo à hauteur fixe (9rem, `.about-v2__impact-partner-logo`
       de base) existe pour que BOpEx et BOPTECH démarrent leur texte à
       la MÊME hauteur en colonnes côte à côte (desktop) - une contrainte
       d'alignement HORIZONTAL qui n'a plus de raison d'être une fois les
       deux colonnes empilées verticalement. Sur mobile, resserrer le
       slot de BOpEx (`:first-child` seulement - jamais BOPTECH, gelé)
       à la taille réelle de son logo (max-height:3rem) au lieu du 9rem
       pensé pour BOPTECH : ça seul supprime le plus gros du vide perçu
       "trop espacé" (jusqu'à ~48px de vide au-dessus et en dessous du
       vrai logo, pour un logo centré dans un slot 3x trop grand). Taille
       du logo elle-même inchangée (max-height/max-width déjà définis
       ailleurs, non touchés ici). */
    .about-v2__impact-partner:first-child .about-v2__impact-partner-logo {
      height: 3.5rem;
      margin-bottom: 0.3rem;
    }
    .about-v2__impact-partner:first-child .about-v2__impact-partner-label {
      margin-bottom: 0.4rem;
    }
    .about-v2__impact-partner:first-child .about-v2__impact-partner-cta {
      margin-top: 0.4rem;
    }
    .about-v2__chaire-band { flex-wrap: wrap; row-gap: 1.75rem; }
    .about-v2__chaire-band-stat { flex: 1 1 calc(50% - .5rem); border-left: 0 !important; }
    .about-v2__eco-stats { grid-template-columns: repeat(2, 1fr); gap: 1.1rem 0; }
    .about-v2__eco-stat:nth-child(3) { border-left: 0; }
    .about-v2__eco-stat:nth-child(2n) { border-left: 1px solid rgba(8, 31, 74, 0.2); }
    .about-v2__eco-stat:nth-child(2n+1) { border-left: 0; }
    .about-v2__support-head { grid-template-columns: 1fr; gap: .7rem; }
    .about-v2__support-head > .about-v2__chapter-number { justify-self: center; }
    .about-v2__support-logos--foundations,
    .about-v2__support-logos--patrons { grid-template-columns: 1fr; }
    .about-v2__support-logo + .about-v2__support-logo { border-left: 0; border-top: 1px solid var(--about-line); }
    .about-v2__team-grid { grid-template-columns: 1fr; }
    .about-v2__eco-conclusion { flex-direction: column; text-align: center; gap: 0.75rem; padding: 1.25rem 1.4rem; }
  }

  /* ============================================================
     BOPA - Nous soutenir (v2, restructuration header/soutenir)
     Réf. : CLAUDE-INTEGRATION.md (Restructuration-Header-Soutenir) +
     REFERENCE-NOUS-SOUTENIR.png (2026-08-27). Remplace la version
     précédente (simple bandeau + CTA) par 3 cartes fondations + 2
     cartes mécènes + un encadré de don, comme "Ils nous soutiennent"
     déménagé ici depuis Qui sommes-nous. Reprend --mp-navy/--mp-blue-bright
     (même fond que Notre Mission/Notre vision, scope étendu dans site.css).
     ============================================================ */
  .bopa-support {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-tint);
    color: var(--color-ink);
    /* Haut ET bas fixés à var(--space-5) (owner, 2026-08-29 puis 2026-08-30) -
       pas des clamp() : même valeur exacte que #notre-vision (voir son
       propre override d'id plus haut dans ce fichier) en bas, et même
       espace eyebrow -> haut de section que Notre mission/Innovations/
       Vision/Qui sommes-nous/Nous contacter en haut (mesuré 99.8px avant
       ce correctif, contre 64px partout ailleurs) - un clamp() responsive
       ne pouvait matcher un fixe qu'à une seule largeur. */
    padding: var(--space-5) 0;
  }

  .bopa-support__inner {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* Titre "Nous soutenir" revenu au petit eyebrow standard (owner,
     2026-08-30) : le badge rond "05." (pack "Nous-Soutenir-COMPLET-Exact-V2",
     2026-08-29) est retiré - l'owner veut désormais exactement le même
     traitement que "Notre mission" (petit label majuscule + tiret cyan
     partagé, site.css), pas un H2 de grande taille avec un numéro. Le
     grand titre équivalent au H2 de Notre Mission vit maintenant dans
     l'encadré bleu juste en dessous ("Faites avancer l'innovation",
     .support-donation-panel h3). */
  /* Resserré franchement (owner, 2026-08-30, pack "CTA-Compact-Correctif-V4") :
     clamp(40px,4vw,56px) laissait un grand vide entre "Nous soutenir" et le
     CTA - la vraie source du vide (le seul enfant entre le titre et le CTA
     dans .bopa-support__inner, en flux normal). Réduit à une respiration
     courte, pas une marge négative bricolée. */
  .bopa-support__heading {
    margin-bottom: clamp(16px, 1.6vw, 22px);
  }

  .bopa-support__eyebrow {
    margin: 0 0 0.85rem;
    color: var(--mp-blue-bright);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  /* Remonté franchement sous le CTA (owner, 2026-08-30, pack
     "3-Fondations-Compact-V1") : 82px (clamp 54-82) mesuré en direct à
     1425px - beaucoup plus qu'une "petite respiration élégante". Seule
     source réelle du vide (rien d'autre ne sépare le CTA de ce groupe en
     flux normal), pas de marge négative bricolée. */
  .bopa-support__group { margin-top: clamp(28px, 2.6vw, 34px); }
  .bopa-support__group-title {
    display: flex;
    align-items: center;
    gap: 18px;
    /* Resserré (owner, 2026-08-30) : 24px collapsait déjà avec le
       margin-top du paragraphe (24px mesuré en direct, le max des deux) -
       trop pour "beaucoup moins de vide" entre le trait et le texte. */
    margin-bottom: 10px;
    color: var(--mp-blue-bright);
  }
  .bopa-support__group-title h3 {
    margin: 0;
    color: var(--mp-blue-bright);
    text-transform: uppercase;
    letter-spacing: .035em;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 800;
  }
  .bopa-support__group-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    font-size: 1.65rem;
  }
  /* Le glyphe ♡ est géométriquement centré dans sa boîte 34x34 (centre de
     boîte = centre de boîte du h3, écart 0px) mais son ENCRE ne l'est pas
     optiquement - translateY manuel par glyphe (owner, 2026-08-30 : "les
     pictos ne sont pas alignés sur leurs titres"). Le picto de "3 fondations
     partenaires" était le même genre de glyphe texte (◎) avec le même
     correctif ; l'owner l'a signalé de nouveau désaligné le 2026-09-03 -
     remplacé par un SVG dessiné dans les mêmes conventions que les icônes
     context-band (viewBox 24, stroke 1.6, currentColor) : son encre est
     intrinsèquement centrée dans sa propre boîte, donc plus besoin de
     nudge ni de dépendre du rendu glyphe/police de chaque OS/navigateur.
     Le nouveau picto "Ils nous accompagnent" (maillon, choisi par l'owner
     parmi 4 propositions, 2026-09-03) est un SVG pour la même raison. */
  .bopa-support__group-icon--heart { transform: translateY(-3px); }
  /* Filet de secours (owner a signalé le trait invisible, 2026-08-30) :
     un navigateur sans support de color-mix() ignore silencieusement la
     déclaration suivante et ignorerait tout aussi silencieusement le
     background entier - sans cette ligne, le trait resterait totalement
     transparent (aucune couleur de repli), invisible même si tout le reste
     du site s'affiche normalement. rgba() ci-dessous est l'équivalent
     figé de --bopa-cyan (#2db9e3) à 60% ; la ligne color-mix() suivante
     prend le relais avec la vraie variable dès qu'elle est supportée. */
  .bopa-support__rule {
    height: 1px;
    background: rgba(45, 185, 227, 0.6);
    background: color-mix(in srgb, var(--mp-blue-bright) 60%, transparent);
    flex: 1;
  }

  /* Texte explicatif au-dessus de la grille 8 logos (pack "Nous-Soutenir-
     Remerciements-Logos-2x4-V2", 2026-09-02). Initialement centré et
     largeur maîtrisée ; repassé au même traitement que
     `.bopa-support__group-intro` (fondations) juste en dessous - aligné à
     gauche, pleine largeur (owner, 2026-09-02 : d'abord "calle-toi sur la
     taille du texte fondations", puis "aligne ça à gauche") - les deux
     retours convergent vers le même traitement que le bloc fondations,
     donc plus de raison de garder un centrage/max-width différents.
     Bleu nuit = --color-ink (même token que le corps de texte du site,
     seule différence residuelle avec `.bopa-support__group-intro`, qui
     utilise --color-muted). */
  .bopa-support__patrons-intro {
    margin: 0;
    max-width: none;
    width: 100%;
    color: var(--color-ink);
    text-align: left;
    font-size: clamp(1rem, 1.15vw, 1.05rem);
    line-height: 1.6;
  }
  /* Remerciement déplacé SOUS la grille de logos (owner, 2026-09-02),
     toujours centré. Taille réduite (owner : "trop gros aussi") - reste
     un cran au-dessus du corps de texte (weight 600) pour garder un peu
     de présence, sans plus viser un "moment" aussi marqué qu'au premier
     jet. Aucun pictogramme (cœur/rayon/étoile) : l'impact vient
     uniquement de la graisse et du cyan sur "Un immense merci". */
  .bopa-support__patrons-thanks {
    margin: 28px auto 0;
    max-width: 42rem;
    /* --mp-navy (essayé d'abord, owner : "même bleu nuit que les fonds")
       se lisait comme un quasi-noir sur ce texte de petite taille - un
       aplat de fond profite du bleu, un texte fin beaucoup moins à cette
       profondeur. Owner, 2026-09-02, confirmé après vérification en
       direct : veut un bleu "plus visible/vif" plutôt que la correspondance
       exacte avec le fond. --color-accent (#03529c) est le bleu "emphase/
       liens" déjà établi du site (tokens.css) - nettement plus lisible
       comme bleu à cette taille, sans inventer une nouvelle valeur. */
    color: var(--color-accent);
    text-align: center;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 600;
    line-height: 1.45;
  }
  .bopa-support__patrons-thanks-accent {
    color: var(--bopa-cyan);
  }

  /* "Ils nous accompagnent" (pack "Ils-Nous-Accompagnent-V2", 2026-09-02) -
     même logique graphique que "Ils nous soutiennent" juste au-dessus,
     source de vérité gelée : classe séparée (pas de renommage de
     `.bopa-support__patrons-*`, pour ne pas toucher au bloc validé) mais
     valeurs COPIÉES à l'identique de `.bopa-support__patrons-intro`, pas
     réinventées. Aligné à gauche (owner : "texte ALIGNÉ À GAUCHE").
     Les deux phrases ont fusionné en UN seul paragraphe (owner, 2026-09-02 :
     "mets cette phrase à la suite... en respectant exactement la typo" du
     premier paragraphe) - l'ancien second paragraphe distinct
     (`.bopa-support__accompany-thanks`, gras + cyan sur "Leur implication…")
     est retiré : plus de mise en avant typographique différenciée, tout le
     texte partage désormais cette seule règle. */
  .bopa-support__accompany-intro {
    margin: 0;
    max-width: none;
    width: 100%;
    color: var(--color-ink);
    text-align: left;
    font-size: clamp(1rem, 1.15vw, 1.05rem);
    line-height: 1.6;
  }

  /* Toute la largeur utile du container HOME, plus le max-width éditorial
     de 54rem/864px (owner, 2026-08-30) - même conteneur que le reste de
     Nous soutenir (.bopa-support__inner), pas une nouvelle valeur.
     margin-top à 0 : avec .bopa-support__group-title resserré ci-dessus,
     c'est lui qui fixe déjà l'écart trait -> paragraphe (les marges
     adjacentes se combinent au plus grand des deux, pas en s'additionnant). */
  .bopa-support__group-intro {
    margin: 0;
    max-width: none;
    width: 100%;
    color: var(--color-muted);
    font-size: clamp(1rem, 1.15vw, 1.05rem);
    line-height: 1.6;
  }

  .bopa-support__grid { display: grid; gap: 18px; margin-top: 26px; }
  .bopa-support__grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  /* "Ils nous soutiennent" passé de 2 grandes cartes à 8 (pack "Nous-
     Soutenir-Logos-2x4-V1", 2026-09-02) - 4 colonnes x 2 lignes sur
     desktop, gap resserré pour rester aéré à cette densité. */
  .bopa-support__grid--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .support-partner-card {
    background: #ffffff;
    color: var(--color-ink);
    border-radius: var(--radius-md);
    padding: 34px 32px 31px;
    min-height: 270px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
  }
  /* Ancienne carte "grande" (2 logos Relyens/Vermon côte à côte) devenue
     `--patron` : 8 logos en grille 4x2 (pack "Nous-Soutenir-Logos-2x4-V1",
     2026-09-02) - padding horizontal réduit (32px -> 22px) pour rester
     confortable dans des colonnes deux fois plus étroites, même logique de
     centrage compact que `--foundation` juste en dessous. */
  .support-partner-card--patron {
    min-height: 0;
    padding: 22px;
    align-items: center;
    justify-content: center;
  }
  /* Cartes fondations ET cartes mécènes : logo seul, centré horizontalement
     et verticalement, aucun texte descriptif (pack V2, 2026-08-29 pour les
     fondations ; descriptions Relyens/Vermon retirées le 2026-08-30, owner :
     "enlève les textes dans les encadrés"). */
  /* Resserrées largement autour du logo (owner, 2026-08-30, pack
     "3-Fondations-Compact-V1") - min-height:270px (hérité de la base
     partagée avec les cartes mécènes ci-dessous, qui restent inchangées)
     forçait ces cartes à rester hautes bien au-delà du logo. Seul
     `--foundation` est touché ici, pas `.support-partner-card` ni
     `--patron` (ex-`--wide`) : largeur, logo, fond, bordure, radius
     restent ceux de la base partagée, seule la hauteur de CETTE variante
     change. */
  .support-partner-card--foundation {
    min-height: 0;
    padding-block: 22px;
    align-items: center;
    justify-content: center;
  }
  /* max-height ramené à 92px (owner, 2026-09-03 : "trop gros par rapport
     aux logos au-dessus") pour que la carte fondation fasse exactement la
     même hauteur que les cartes "Ils nous soutiennent"/"Ils nous
     accompagnent" (138px : padding 22px*2 + logo-wrap min-height:92px +
     bordures) - avant, 6.5rem/104px de plafond faisait dépasser la carte
     de 12px (150px). */
  .support-partner-card--foundation img {
    display: block;
    max-width: 72%;
    max-height: 92px;
    object-fit: contain;
  }
  /* AP-HP et Mines-Télécom réduits (owner, 2026-09-03) - Paris-Saclay non
     touché. La carte garde 138px (grid align-items:stretch par défaut),
     seul le logo à l'intérieur est plus petit. */
  /* AP-HP est plafonné par la largeur (72% -> 193px -> 58px de haut, sous
     les 76px de max-height ci-dessus) - réduire encore (owner, 2026-09-03)
     demande donc de resserrer max-width, pas max-height. */
  .support-partner-card--foundation img.support-partner-card__logo--faphp { max-height: 76px; max-width: 58%; }
  .support-partner-card--foundation img.support-partner-card__logo--fondation-imt { max-height: 76px; }
  /* Logo AP-HP - 3e round de correctifs (2026-08-30/31 puis 2026-09-03).
     Rounds précédents : translateX(7.2%) puis 3.5% VERS LA DROITE (théorie
     du centre de masse/encre pondérée, mesuré à 42.9% au lieu de 50% dans
     le fichier) - les deux jugés "encore trop à droite" par l'owner, d'où
     l'abandon au profit du centrage géométrique pur (transform:none).
     Round 2026-09-03 : après réduction de taille (max-width 72%->58%),
     l'owner signale à nouveau "trop à droite" - MAIS cette fois-ci vérifié
     explicitement via AskUserQuestion à 0% (centrage géométrique pur, donc
     AUCUN des deux essais précédents) : la réponse confirme "trop à droite"
     même sans aucun décalage. Puisque la théorie de l'encre pondérée
     pointait vers la droite (+7.2%) et que l'owner juge le résultat "trop à
     droite" à 0% ET aux deux essais vers la droite, le sens correct est
     inverse à la théorie : décalage vers la GAUCHE. Parti d'un essai
     modéré (-3.5%, symétrique au plus petit essai droit déjà tenté) - à
     confirmer en vrai, ce logo ayant un historique de désaccord avec toute
     prédiction théorique. */
  .support-partner-card--foundation img.support-partner-card__logo--recenter {
    transform: translateX(-3.5%);
  }
  .support-partner-card__logo-wrap {
    min-height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Plus de margin-bottom (owner, 2026-08-30 : "enlève les textes") -
       les descriptions Relyens/Vermon ont été retirées, le logo est
       désormais seul dans la carte, centré comme les cartes fondations. */
  }
  .support-partner-card__logo-wrap img {
    display: block;
    max-width: 100%;
    max-height: 76px;
    object-fit: contain;
    object-position: center;
  }
  /* Grille 4x2 "Ils nous soutiennent" (pack "Nous-Soutenir-Logos-2x4-V1",
     2026-09-02) : gabarit réduit proprement pour 8 logos au lieu de 2
     (base 44px, contre 76px générique / 84px Relyens ci-dessus). Poids
     visuel harmonisé PAR MARQUE, pas par simple hauteur partagée - même
     principe que Relyens/Vermon plus haut, mais poussé plus loin ici car
     les 8 fichiers vont d'un simple mot-symbole fin (Medtronic, ratio ~5.9,
     très peu d'encre par rapport à sa boîte) à un aplat plein (Orange,
     carré quasi 100% rempli) : à hauteur identique, un aplat plein pèse
     visuellement beaucoup plus qu'un mot-symbole fin, donc l'égalisation
     par simple hauteur ou même par aire de boîte engloutissante (utilisée
     pour les fondations, toutes des pictos+mots comparables) ne suffit
     plus ici - chaque hauteur ci-dessous est ajustée à l'œil pour un poids
     comparable. Sélecteur ancré sur les deux classes du wrap (spécificité
     0,2,1) pour battre la règle générique juste au-dessus sans dépendre de
     l'ordre dans le fichier - piège déjà rencontré sur ce même bloc.
     Ajusté une première fois après publication (owner, 2026-09-02) :
     Vermon et Medtronic réduits (26->22, 34->29), Relyens/Orange/Boston
     Scientific agrandis (48->54, 44->50, 40->46). Deuxième passe le même
     jour (owner : "grossit encore") : Orange/Boston Scientific/Richard
     Wolf agrandis une seconde fois (50->58, 46->54, 36->44). */
  .support-partner-card__logo-wrap.support-partner-card__logo-wrap--patron img {
    max-height: 44px;
  }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--relyens { max-height: 54px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--vermon { max-height: 22px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--jnj { max-height: 40px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--medtronic { max-height: 29px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--boston-scientific { max-height: 54px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--fujifilm { max-height: 28px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--orange { max-height: 58px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--richard-wolf { max-height: 44px; }
  /* "Ils nous accompagnent" : NVIDIA/Bayes Impact/Toys Films agrandis par
     rapport à la base 44px (owner, 2026-09-02) - S3NS non touché, reste à
     44px. Même sélecteur partagé que "Ils nous soutiennent" ci-dessus.
     Deuxième passe le même jour (owner : "augmente encore NVIDIA et Bayes
     Impact") : 52->60px pour ces deux-là. Troisième passe le même jour
     (owner : "agrandit encore NVIDIA, Bayes Impact et Toys Films") :
     60->68px pour NVIDIA/Bayes Impact, 52->60px pour Toys Films. */
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--nvidia { max-height: 68px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--bayes-impact { max-height: 68px; }
  .support-partner-card__logo-wrap--patron img.support-partner-card__logo--toys-films { max-height: 60px; }

  /* Compacté ~25% (owner, 2026-08-30, pack "CTA-Compact-Correctif-V4") :
     plus de min-height rigide - c'est justement lui (avec le min-height:430px
     jumeau sur l'image plus bas) qui forçait le bloc à rester haut même une
     fois le padding et les marges internes réduits. La hauteur vient
     maintenant uniquement du contenu + padding, responsive par nature. */
  .support-donation-panel {
    border: 1px solid color-mix(in srgb, var(--mp-blue-bright) 55%, transparent);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    /* Le radial-gradient cyan décoratif (centré à 76% - à peu près là où
       vit le visuel main+cœur) a été retiré (owner, 2026-08-30 : "je ne
       veux plus de grande auréole bleu ciel/bleu pétrole derrière le cœur
       et la main") - fond bleu nuit uni, le maillage du PNG repose
       directement dessus. Aligné sur le bleu nuit exact de "Nous
       contacter" (owner, 2026-08-30) : --mp-navy-deep (#041a3b) remplacé
       par --mp-navy (#071f46, `.bopa-contact`'s own background) - les deux
       teintes étaient proches mais pas identiques. */
    background: var(--mp-navy);
  }
  .support-donation-panel__content {
    padding: clamp(36px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
  /* Même typo exacte que le H2 de Notre Mission "Améliorer la chirurgie,
     grâce au numérique" (.bopa-mission-v2 h2, site.css) - owner, 2026-08-30.
     letter-spacing en dur (-0.035em, pas le token --tracking-tight/-0.02em)
     pour matcher au pixel près, comme Notre Mission le fait déjà. */
  .support-donation-panel h3 {
    margin: 0;
    max-width: 560px;
    color: #fff;
    font-family: var(--font-display, "Space Grotesk", system-ui, sans-serif);
    font-size: clamp(2rem, 3.1vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .support-donation-panel__content > p:not(.support-donation-panel__security) {
    margin: 14px 0 18px;
    max-width: 47ch;
    color: rgba(255,255,255,.9);
    line-height: 1.58;
  }
  /* Padding vertical réduit ~25% (17px -> 13px) pour un bouton nettement
     moins haut (owner, 2026-08-30) - horizontal inchangé, garde un bouton
     premium, pas une bannière. */
  .support-donation-panel__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-width: min(100%, 325px);
    padding: 13px 23px;
    background: var(--mp-blue-bright);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    border-radius: var(--radius-md);
    transition: transform 0.28s ease, background-color 0.28s ease, box-shadow 0.28s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .support-donation-panel__cta:hover { background: var(--bopa-blue-1); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(3, 82, 156, 0.35); }
  }
  .support-donation-panel__security {
    margin: 9px 0 0;
    color: rgba(255,255,255,.68);
    font-size: .82rem;
  }
  /* Respiration du bloc éditorial gauche (pack "CTA-Respiration-V1",
     2026-09-03, desktop uniquement - owner : "conserver le responsive
     existant" sur tablette/mobile) - la main+cœur et le ratio de grille
     (1.1fr/.9fr) NE SONT PAS touchés : à ≥1228px la colonne droite fait
     531px, tout juste au-dessus du seuil de 521.7px (480px / 92%) sous
     lequel l'image cesserait d'être plafonnée par son max-width:480px et
     rétrécirait - aucune marge pour toucher au ratio sans enfreindre "ne
     touche pas à l'image". Le décalage vers la droite (+30px de padding-
     left) et l'élargissement (padding-right réduit) jouent donc uniquement
     sur le padding et les marges internes de .support-donation-panel__content,
     jamais sur la grille. Padding vertical réduit de 21px de chaque côté
     pour financer exactement l'augmentation des 3 gaps ci-dessous (+8/+28/+4
     = +40, contre -42 de padding retiré) : la hauteur totale du bloc ne
     grandit pas (léger -2px), conformément à "NE PAS augmenter la hauteur
     globale de l'encadré". */
  @media (min-width: 901px) {
    .support-donation-panel__content {
      padding-left: calc(clamp(36px, 5vw, 64px) + 30px);
      padding-right: clamp(14px, 2vw, 20px);
      padding-top: calc(clamp(36px, 5vw, 64px) - 21px);
      padding-bottom: calc(clamp(36px, 5vw, 64px) - 21px);
    }
    /* Paragraphe élargi : ancien plafond 47ch sous-utilisait déjà la
       colonne (474px rendus sur ~520px disponibles) - 58ch est
       volontairement généreux, la largeur réelle s'auto-plafonne à la
       largeur de la colonne (align-items:flex-start, pas de stretch). */
    .support-donation-panel__content > p:not(.support-donation-panel__security) {
      margin-top: 22px;
      margin-bottom: 46px;
      max-width: 58ch;
    }
    /* Rapproché du bouton (owner, 2026-09-03 : "trop d'espace" avec les
       13px du pack V1) - 4px, nettement plus collé que même l'original
       (9px) avant ce pack. */
    .support-donation-panel__security { margin-top: 4px; }
  }
  .support-donation-panel__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    /* Hauteur calée sur la colonne texte (align-items:stretch hérité de la
       grille .support-donation-panel), plus de min-height:100% + image en
       min-height:430px qui forçaient la hauteur du bloc entier - voir plus
       haut (owner, 2026-08-30). */
    min-height: 220px;
  }
  /* Asset FINAL (owner, 2026-08-30, pack "Remplacement-Image-Transparent-
     FINAL") : hand-heart-bopa-final.png - l'image d'origine validée,
     nettoyée techniquement (fond noir et grande nappe/halo bleu diffus
     supprimés, maillage/traits/points conservés, vraie transparence).
     Remplace hand-heart-bopa-transparent.png, dont le halo restait visible.
     Ratio différent du précédent (1438x1094 ≈ 1.314 contre 1136x1094 ≈
     1.038) - ne doit recevoir AUCUNE transformation qui changerait son
     cadrage (pas de translate/scale/object-position/clip-path) : juste un
     ancrage à droite et un dimensionnement proportionnel qui respecte ses
     proportions naturelles. Le bleu nuit du panneau apparaît naturellement
     à travers la transparence.
     IMPORTANT : dimensionner via `width` (valeur définie, dérivée de la
     largeur - toujours définie - de la colonne grille), PAS via `height`
     couplée à un `max-width` de secours : testé en vrai sur ce moteur de
     rendu, "height défini + width:auto + max-width" ÉCRASE le ratio naturel
     dès que le max-width devient la contrainte active (colonne étroite,
     ~900-1150px de largeur d'écran) au lieu de recalculer les deux axes -
     l'image ressort visiblement déformée. Piloter par la largeur évite tout
     bras de fer entre contraintes puisque `min(92%, 480px)` est toujours
     ≤ 100% de la colonne : aucun filet de secours n'est jamais nécessaire. */
  .support-donation-panel__visual img {
    display: block;
    width: min(92%, 480px);
    height: auto;
    margin: 0;
  }

  @media (max-width: 900px) {
    /* Tablette : "2 + 1" plutôt qu'une colonne unique (pack V2, 2026-08-29,
       section RESPONSIVE) - la 3e carte fondation s'étend sur les deux
       colonnes. */
    .bopa-support__grid--three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bopa-support__grid--three > :last-child { grid-column: 1 / -1; }
    /* "Ils nous soutiennent" : 4x2 -> 2x4 (pack "Nous-Soutenir-Logos-2x4-V1",
       2026-09-02) - demandé explicitement ("tablette = 2x4 si nécessaire"),
       4 colonnes devenaient trop étroites pour les logos les plus larges
       (Medtronic, J&J) en dessous de ~900px. */
    .bopa-support__grid--four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .support-partner-card { min-height: 0; }
    /* Panneau empilé (image sous le texte) : asset transparent, déjà cadré -
       plus besoin d'object-fit:cover/recadrage, juste une hauteur plafonnée
       pour que l'image reste entièrement visible sans imposer sa propre
       hauteur au panneau. */
    .support-donation-panel { grid-template-columns: 1fr; }
    .support-donation-panel__visual { height: auto; min-height: 0; padding: 18px 0; }
    .support-donation-panel__visual img {
      height: 220px;
      width: auto;
      max-width: 100%;
    }
  }

  @media (max-width: 680px) {
    .bopa-support__grid--three { grid-template-columns: 1fr; }
    .bopa-support__grid--three > :last-child { grid-column: auto; }
  }

  @media (max-width: 560px) {
    .bopa-support__inner { width: min(calc(100% - 28px), 1180px); }
    .support-partner-card { padding: 27px 24px; }
    .bopa-support__group-title { gap: 11px; }
    .bopa-support__group-title h3 { font-size: .9rem; }
    .support-donation-panel__content { padding: 32px 24px 35px; }
  }

  .bopa-contact {
    position: relative;
    background: var(--mp-navy);
    color: rgba(255, 255, 255, 0.85);
    overflow: hidden;
  }

  /* Maillage cyan interactif, coin bas-gauche (pack "Nous-Contacter-Exact-V1",
     2026-08-29 ; rendu plus présent au correctif "Nous-Contacter-FINAL",
     même jour) - canvas 2D pur (site/src/scripts/contact-mesh.js), aucune
     librairie externe. Masqué en dégradé vers le haut pour ne jamais
     gêner le texte ; pointer-events:none pour ne jamais intercepter de clics.
     "Plus grand + plus lumineux + plus visible, jamais plus complexe" :
     emprise (hauteur + zone visible du masque) agrandie, `filter` ajoute un
     vrai glow cyan (drop-shadow peint une lueur même là où le trait/point
     source est à faible alpha, ce qu'un simple brightness/opacity ne peut
     pas faire) - le nombre de points et la logique interactive elle-même
     (site/src/scripts/contact-mesh.js) restent inchangés, seule leur
     opacité/taille de base a été relevée dans le script. */
  .bopa-contact__mesh {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: min(360px, 46%);
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 72%, transparent 100%);
    mask-image: linear-gradient(to top, #000 0%, #000 72%, transparent 100%);
    filter:
      brightness(1.18)
      saturate(1.18)
      drop-shadow(0 0 24px color-mix(in srgb, var(--bopa-cyan) 40%, transparent));
  }
  .bopa-contact__mesh canvas { display: block; width: 100%; height: 100%; }
  @media (max-width: 760px) {
    .bopa-contact__mesh {
      height: min(280px, 40%);
      filter:
        brightness(1.1)
        saturate(1.1)
        drop-shadow(0 0 16px color-mix(in srgb, var(--bopa-cyan) 30%, transparent));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bopa-contact__mesh { opacity: 0.72; }
  }

  .bopa-contact__inner {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    /* padding-top ET padding-bottom fixés à var(--space-5) (owner,
       2026-08-30, pack "Nous-Contacter-Equilibre-Haut-Bas-V5") : le haut
       (64px, inchangé depuis le 2026-08-30 précédent) reste la référence
       - le bas utilisait encore son propre clamp(72px,8vw,104px), qui
       résolvait à 102.4px à 1280px de large (mesuré en direct) contre
       64px en haut, donc visuellement asymétrique. Même valeur FIXE des
       deux côtés (pas juste un clamp ajusté pour matcher à une seule
       largeur) garantit A = B à toute largeur d'écran, pas seulement au
       point de mesure. Seul le padding-bottom change ici ; le cadre
       blanc lui-même ne bouge pas (padding-top intact). */
    padding: var(--space-5) 0;
    display: grid;
    /* Rééquilibré (owner, 2026-08-30, pack "Nous-Contacter-Compact-V2") :
       ~39%/61% (.78fr/1.22fr) avant correctif -> ~47%/53%, pour que les
       paragraphes de gauche s'étalent sur moins de lignes. Planchers
       ajustés dans le même esprit (colonne de texte plus large mérite un
       plancher un peu plus haut ; le formulaire, plus étroit, peut
       accepter un plancher plus bas qu'avant). */
    grid-template-columns: minmax(300px, .95fr) minmax(420px, 1.05fr);
    gap: clamp(48px, 7vw, 100px);
    /* Stretch réintroduit sciemment (owner, 2026-08-30, pack "Nous-
       Contacter-Equilibrage-Final-V3") : le formulaire reste la colonne
       la plus haute (sa propre hauteur ne dépend pas de ce stretch), mais
       la colonne de texte peut désormais s'étirer pour occuper la même
       hauteur et répartir ses 3 groupes dessus (voir .bopa-contact__intro
       juste en dessous) - contrairement au retrait du pack précédent, qui
       compensait la disparition du bloc adresse, cette fois le stretch
       sert un vrai objectif : mieux répartir un contenu qui reste plus
       court que le formulaire. */
    align-items: stretch;
  }

  /* Les 2 paragraphes lisaient comme "jetés" à deux hauteurs plutôt que
     comme un seul bloc éditorial une fois répartis individuellement via
     space-between (owner, 2026-08-30, pack "Nous-Contacter-Paragraphes-
     Groupe-Centre-V4") - corrigé en repassant à 2 groupes seulement :
     le bloc titre (fixe, en haut) et une zone restante `flex:1` qui
     centre verticalement le groupe des deux paragraphes (regroupés dans
     leur propre wrapper, voir `.bopa-contact__intro-middle`/`-group`
     juste plus bas) - plus de justify-content:space-between ici. */
  .bopa-contact__intro {
    display: flex;
    flex-direction: column;
  }

  /* Zone restante entre le bloc titre et le bas du formulaire (stretch
     hérité de `.bopa-contact__inner` juste au-dessus) : `flex:1` occupe
     tout l'espace non pris par `.intro-top`, `align-items:center` centre
     verticalement le groupe des paragraphes dedans - exactement la
     recommandation du pack (bloc titre en haut / zone flex:1 / groupe
     centré dedans), pas de margin-top ni de translateY arbitraires. */
  .bopa-contact__intro-middle {
    flex: 1;
    display: flex;
    align-items: center;
  }

  /* Les deux paragraphes forment un seul groupe éditorial : gap d'environ
     une ligne de texte (1.1em, dans la fourchette 1-1.2em demandée),
     plus le `margin-top:10px` fixe d'avant qui traitait les paragraphes
     comme deux blocs indépendants. */
  .bopa-contact__intro-group {
    display: flex;
    flex-direction: column;
    gap: 1.1em;
  }

  /* Titre principal : même échelle "Niveau 1" que "Améliorer la chirurgie,
     grâce au numérique" (.bopa-mission-v2 h2, la référence explicite du
     pack "Homogeneisation-Espaces-Titres-V1", 2026-09-03) - repris à
     l'identique, y compris le letter-spacing en dur (-0.035em) : ce titre
     utilisait jusqu'ici `var(--tracking-tight)` (-0.02em, la valeur de
     Notre Vision, pas de Notre Mission) - écart invisible à l'oeil mais
     réel, corrigé pour matcher pixel pour pixel la vraie référence.
     "Parlons-en." (ex-h2) devient la signature cyan juste dessous. */
  .bopa-contact h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.1vw, 3.15rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #fff;
  }

  .bopa-contact__kicker {
    margin: 6px 0 0;
    color: var(--mp-blue-bright);
    font-weight: 650;
    font-size: clamp(1.05rem, 1.4vw, 1.3rem);
    line-height: 1.3;
  }

  /* max-width élargi (owner, 2026-08-30, pack "Nous-Contacter-Compact-V2") :
     390px était déjà plus étroit que la colonne elle-même AVANT même le
     rééquilibrage des deux colonnes ci-dessus - élargir la colonne seule
     n'aurait donc rien changé au nombre de lignes, ce cap agissait comme
     goulot d'étranglement invisible. Élargi à 480px, en dessous de la
     largeur réelle de la colonne (~518px à 1280px de large) pour garder
     une longueur de ligne confortable, mais assez pour vraiment gagner
     les 1-2 lignes visées. */
  .bopa-contact__text {
    max-width: 480px;
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
  }
  /* Plus de margin-top fixe entre les deux paragraphes (owner, 2026-08-30,
     pack "Nous-Contacter-Equilibrage-Final-V3") : chaque paragraphe est
     maintenant son propre groupe flex direct de `.bopa-contact__intro`
     (voir markup), l'écart entre eux vient de `justify-content:
     space-between` sur la colonne entière, pas d'une marge arbitraire. */
  .bopa-contact__highlight { color: var(--bopa-cyan); }

  /* Formulaire compacté (correctif "Nous-Contacter-FINAL", 2026-08-29) :
     padding du bloc, hauteur des champs, espace label->champ et espace
     entre champs tous réduits - le formulaire se lisait trop haut et trop
     vide à côté de la colonne éditoriale. Toujours confortable (labels,
     tailles de police et focus visibles inchangés), juste moins massif. */
  .bopa-contact__form {
    background: rgba(255,255,255,.98);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: clamp(18px, 2.2vw, 26px);
    /* padding-bottom réduit une seconde fois (owner, 2026-08-30, pack
       "Nous-Contacter-Equilibrage-Final-V3") : la carte doit garder
       EXACTEMENT sa hauteur actuelle pendant que Message grandit - cette
       respiration, plus le margin-top du `.form-status` juste en dessous
       (voir plus bas), sont les deux seules sources de "vide" restant
       une fois les champs déjà compacts ; les deux sont resserrées pour
       financer la croissance de Message sans changer la hauteur totale
       de la carte. */
    padding-bottom: clamp(6px, .8vw, 9px);
    box-shadow: 0 18px 48px rgba(18,46,92,.09);
  }

  .bopa-contact__form > label,
  .bopa-contact__grid label {
    display: grid;
    gap: 5px;
    margin-bottom: 6px;
  }

  .bopa-contact__form label > span:first-child,
  .bopa-contact__grid label > span:first-child {
    font-size: .78rem;
    font-weight: 760;
    color: var(--color-navy);
  }

  .bopa-contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .bopa-contact input,
  .bopa-contact select,
  .bopa-contact textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-size: .92rem;
    padding: 9px 14px;
    outline: none;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .bopa-contact input:focus,
  .bopa-contact select:focus,
  .bopa-contact textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  /* Champs Nom/Prénom/Email/Sujet resserrés verticalement (owner,
     2026-08-30, pack "Nous-Contacter-Compact-Hauteur-V1") - padding-block
     seul touché, taille de police et padding-inline inchangés. */
  .bopa-contact input,
  .bopa-contact select {
    padding-block: 5px;
  }

  /* Message agrandi (owner, 2026-08-30, pack "Nous-Contacter-Equilibrage-
     Final-V3") : 96px -> 113px, financé intégralement par le padding-bottom
     de la carte et le margin-top du statut de formulaire resserrés
     juste au-dessus/plus bas - la hauteur totale de la carte blanche
     reste donc exactement la même, comme demandé explicitement, tout
     en faisant de Message le bloc vertical dominant du formulaire. */
  .bopa-contact textarea {
    resize: vertical;
    height: 113px;
    min-height: 113px;
    padding-block: 8px;
  }

  .bopa-contact__consent {
    display: flex !important;
    grid-template-columns: none !important;
    gap: 9px !important;
    align-items: flex-start;
    margin: 2px 0 0 !important;
    color: var(--color-muted);
    font-size: .78rem;
    line-height: 1.4;
  }

  .bopa-contact__consent input {
    width: 15px;
    height: 15px;
    padding: 0;
    margin: 2px 0 0;
    flex: 0 0 auto;
  }

  .bopa-contact__actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 8px;
  }

  /* Bouton corrigé (correctif "Nous-Contacter-FINAL", 2026-08-29) : largeur
     `fit-content` (plus de `min-width`/`gap` de flèche qui le poussaient à
     déborder sur 2 lignes), cyan BOPA exact à l'état actif (était
     `--color-navy` par erreur), gris/bleu-gris explicitement non cliquable
     tant que le consentement n'est pas coché - piloté par le vrai attribut
     `disabled` (script plus haut), pas seulement par une classe visuelle. */
  .bopa-contact__actions button {
    width: max-content;
    max-width: 100%;
    white-space: nowrap;
    min-height: 48px;
    padding: 0 28px;
    border: 0;
    border-radius: var(--radius);
    background: var(--bopa-cyan);
    color: #fff;
    font: inherit;
    font-weight: 720;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform .2s ease, background-color .2s ease, opacity .2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .bopa-contact__actions button:not(:disabled):hover {
      transform: translateY(-1px);
      background: var(--bopa-blue-1);
    }
  }

  .bopa-contact__actions button:disabled {
    background: color-mix(in srgb, var(--color-muted) 38%, white);
    color: rgba(255, 255, 255, .85);
    cursor: not-allowed;
    opacity: .85;
  }

  /* margin-top resserré (owner, 2026-08-30, pack "Nous-Contacter-
     Equilibrage-Final-V3") : finance une partie de la croissance du
     textarea Message sans changer la hauteur totale de la carte. */
  .bopa-contact .form-status { grid-column: 1 / -1; margin-top: 4px; }

  @media (max-width: 900px) {
    .bopa-contact__inner {
      grid-template-columns: 1fr;
    }
    /* Empilé en une seule colonne à cette largeur (owner, 2026-08-30,
       pack "Nous-Contacter-Paragraphes-Groupe-Centre-V4") : le centrage
       vertical de `.intro-middle` (hérité du stretch desktop) devient
       naturellement inerte ici puisqu'il n'y a plus de hauteur étirée à
       partager avec le formulaire (empilement normal) - juste un gap
       fluide entre le bloc titre et le groupe de paragraphes, pas de
       centrage vertical artificiel forcé. */
    .bopa-contact__intro {
      max-width: 620px;
      gap: clamp(18px, 3vh, 28px);
    }
  }

  @media (max-width: 620px) {
    .bopa-contact__inner {
      width: min(calc(100% - 32px), 1180px);
    }
    .bopa-contact__grid { grid-template-columns: 1fr; gap: 0; }
    .bopa-contact__actions { justify-content: stretch; }
    .bopa-contact__actions button { width: 100%; }
    .bopa-support h2 br { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .support-donation-panel__cta,
    .bopa-contact__actions button {
      transition: none;
    }
  }

  /* ============================================================
     BOPA - Notre vision V4
     Réf. : CLAUDE-INTEGRATION.md (Notre-Vision-V4) + REFERENCE-CODE-MISSION
     + REFERENCE-NOTRE-MISSION-A-HARMONISER.png (2026-08-27).
     Remplace la V3 (cercles ~166px, H2 jusqu'à 4rem+) : cette version
     reprend EXACTEMENT les métriques de .bopa-mission-v2 (vérifiées
     identiques au CSS actuel, pas seulement à ce que fournissait le
     pack) - même padding, largeur, eyebrow, H2, intro, cercles 5.25rem,
     SVG 3rem, ligne pointillée. Seule différence : 5 repères sur la
     frise au lieu de 3, donc grid-template-columns adapté en
     conséquence. Ne jamais regrossir ces valeurs pour "compenser" le
     texte plus long de Vision - la densité doit rester identique à
     Mission (demande explicite de la propriétaire).
     ============================================================ */
  .bopa-vision-v4 {
    width: 100%;
    overflow: hidden;
    position: relative;
    background: var(--mp-navy);
    color: #fff;
    padding: clamp(4.75rem, 7vw, 7rem) 2rem clamp(5.25rem, 8vw, 7.5rem);
  }

  .bopa-vision-v4 *,
  .bopa-vision-v4 *::before,
  .bopa-vision-v4 *::after {
    box-sizing: border-box;
  }

  /* Marges horizontales alignées sur "Qui sommes-nous" (owner, 2026-08-30) -
     width:min(1320px,100%) laissait le contenu toucher le bord du viewport
     dès que la largeur d'écran descendait sous 1320px (aucune marge
     propre, seulement le centrage du plafond de largeur), rendant Vision
     plus "étalée" que Mission/Qui sommes-nous à toute largeur
     intermédiaire. PAS la formule `calc(100% - 3rem)` du conteneur
     générique `.section-block .wrap` : `.bopa-vision-v4` a son PROPRE
     padding horizontal (2rem, ligne ci-dessus) - contrairement à
     `.about-v2` qui n'en a aucun - donc soustraire 3rem une seconde fois
     dans `__inner` double-comptait la marge (mesuré : 1152.8px au lieu de
     1184px visés à 1280px de large). Même correctif que
     `.bopa-mission-v2__inner` (qui partage exactement le même padding de
     section) : un plafond simple, sans soustraction supplémentaire. */
  .bopa-vision-v4__inner {
    width: min(var(--max-width), 100%);
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .bopa-vision-v4__eyebrow {
    margin: 0 0 0.85rem;
    color: var(--mp-blue-bright);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .bopa-vision-v4 h2 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.1vw, 3.15rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-tight);
  }

  .bopa-vision-v4__intro {
    width: min(860px, 100%);
    margin: 1.45rem auto 0;
    color: rgba(255,255,255,.88);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.55;
    text-align: center;
  }

  .bopa-vision-v4__intro strong {
    color: #fff;
    font-weight: 700;
  }

  .bopa-vision-v4__timeline {
    position: relative;
    display: grid;
    grid-template-columns:
      minmax(100px, .72fr)
      minmax(285px, 1fr)
      minmax(285px, 1fr)
      minmax(285px, 1fr)
      minmax(110px, .8fr);
    gap: clamp(1.15rem, 2.4vw, 2.5rem);
    margin-top: clamp(3.8rem, 6vw, 5.6rem);
    align-items: start;
  }

  /* Trajectoire directionnelle continue (2026-08-27, patch flèche) :
     remplace l'ancienne ligne pointillée par un trait plein, avec une
     seule pointe de flèche juste avant "Progrès pour tous" (::after
     ci-dessous) - Innovation est le départ, Progrès la destination,
     les trois piliers du milieu ne sont plus au même niveau visuel
     qu'un simple repère parmi d'autres. Rien d'autre dans la section
     n'a changé (tailles, cercles, icônes, textes, fond, espacements). */
  /* La ligne s'arrête désormais exactement à la pointe de la flèche
     (même valeur right que ::after ci-dessous), pas plus loin vers le
     cercle - avant ce correctif (2026-08-27, V2), la ligne continuait
     jusqu'à right:4.5% derrière la flèche (posée à 14%), donnant
     l'impression d'une trajectoire qui continue sous la flèche au lieu
     de s'arrêter net dessus. */
  .bopa-vision-v4__timeline::before {
    content: "";
    position: absolute;
    top: 31px;
    left: 4.5%;
    right: 11.7%;
    height: 2px;
    background: var(--mp-blue-bright);
    opacity: 0.9;
  }

  /* Pointe de flèche = vraie terminaison de la ligne (même right que
     ::before, 15.5% : la ligne s'arrête pile là où la flèche commence,
     plus de segment caché derrière). Laisse ~28-51px avant le cercle
     "Progrès pour tous" selon la largeur (mesuré de 1000px à 1920px) -
     un pourcentage pur ne peut pas tomber pile à 30-45px partout (le
     cercle final a une taille fixe, pas proportionnelle), donc cette
     valeur vise le milieu de la plage demandée plutôt qu'un seul point. */
  .bopa-vision-v4__timeline::after {
    content: "";
    position: absolute;
    top: 31px;
    right: 11.7%;
    width: 14px;
    height: 14px;
    border-top: 2px solid var(--mp-blue-bright);
    border-right: 2px solid var(--mp-blue-bright);
    transform: translateY(-50%) rotate(45deg);
    opacity: 0.9;
  }

  .bopa-vision-v4__step {
    position: relative;
    z-index: 1;
    min-width: 0;
    text-align: center;
  }

  .bopa-vision-v4__step::before {
    content: "";
    position: absolute;
    top: calc(31px - 4px);
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--mp-blue-bright);
    transform: translateX(-50%);
    z-index: -1;
  }

  /* Cercles harmonisés sur la DA de /innovations/ (2026-08-27, V4.1) :
     62px, contour 1.5px cyan, intérieur blanc, pictogramme cyan - même
     diamètre/épaisseur/finesse que la frise Pré/Per/Post d'/innovations/,
     seule la couleur du pictogramme diffère volontairement (cyan ici,
     encre sur /innovations/ qui est un fond clair). */
  .bopa-vision-v4__icon {
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    margin: 0 auto 20px;
    border: 1.5px solid var(--mp-blue-bright);
    border-radius: 999px;
    background: #fff;
    color: var(--mp-blue-bright);
  }

  .bopa-vision-v4__icon svg {
    width: 38px;
    height: 38px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bopa-vision-v4__step--endpoint .bopa-vision-v4__icon {
    border-color: color-mix(in srgb, var(--mp-blue-bright) 72%, transparent);
  }

  .bopa-vision-v4__step h3,
  .bopa-vision-v4__endpoint-label {
    margin: 0;
    color: var(--mp-blue-bright);
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  /* Les 3 piliers (Acceptabilité/Interopérabilité/Soutenabilité) centrés
     sous leur cercle (owner's request, 2026-08-27, correctif frises/Vision) :
     même largeur (215px, celle déjà utilisée par .copy) et même centrage
     pour les 3 blocs de texte (titre/accroche/paragraphe), pas seulement
     text-align:center - la boîte elle-même doit être centrée. Les
     étapes de fin (Innovation/Progrès pour tous, .endpoint-label) ne
     sont pas concernées, elles gardent leur propre traitement. */
  .bopa-vision-v4__step h3 {
    max-width: 285px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .bopa-vision-v4__endpoint-label {
    color: rgba(255,255,255,.95);
  }

  /* "Progrès pour tous" aligné sur le bord gauche du dernier cercle
     (owner's request, 2026-08-27) plutôt que sur celui de sa colonne :
     même largeur que l'icône (62px) et même centrage (margin:auto),
     donc leurs bords gauches coïncident - le texte est déjà en
     text-align:left (règle globale des paragraphes), il ne manquait
     que la largeur pour aligner correctement. */
  .bopa-vision-v4__step--endpoint-end .bopa-vision-v4__endpoint-label {
    width: 62px;
    margin: 0 auto;
  }

  .bopa-vision-v4__tagline {
    max-width: 285px;
    margin: 1.35rem auto 0;
    color: rgba(255,255,255,.94);
    font-size: 1.04rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }

  .bopa-vision-v4__copy {
    max-width: 285px;
    margin: 0.7rem auto 0;
    color: rgba(255,255,255,.72);
    font-size: 0.88rem;
    line-height: 1.52;
    text-align: center;
  }

  .bopa-vision-v4__network {
    position: absolute;
    width: 230px;
    opacity: 0.09;
    color: var(--mp-blue-bright);
    pointer-events: none;
  }
  .bopa-vision-v4__network--left { left: -70px; bottom: -55px; }
  .bopa-vision-v4__network--right { right: -70px; bottom: -55px; transform: scaleX(-1); }

  /* Seuil remonté de 980px à 1220px (2026-08-27, finitions V1) : les
     colonnes du milieu ont désormais un minimum de 285px (pour garantir
     2 lignes strictes aux sous-titres) - en dessous d'environ 1200px, ce
     minimum ne tient plus dans le layout desktop à 5 colonnes et débordait
     silencieusement (coupé par overflow:hidden). Le layout 3 colonnes /
     extrémités en pleine largeur ci-dessous absorbe cette plage sans
     problème (ses colonnes sont déjà bien plus larges que 285px). */
  @media (max-width: 1220px) {
    .bopa-vision-v4__timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
    .bopa-vision-v4__timeline::before,
    .bopa-vision-v4__timeline::after { display: none; }
    .bopa-vision-v4__step::before { display: none; }
    .bopa-vision-v4__step--endpoint-start { grid-column: 1 / -1; }
    .bopa-vision-v4__step--endpoint-end { grid-column: 1 / -1; }
    .bopa-vision-v4__step--endpoint .bopa-vision-v4__icon { margin-bottom: 1rem; }
    .bopa-vision-v4__step h3,
    .bopa-vision-v4__tagline,
    .bopa-vision-v4__copy { max-width: 285px; }
  }

  @media (max-width: 700px) {
    .bopa-vision-v4 { padding: 4rem 1.25rem 4.5rem; }

    /* Timeline verticale mobile (pack "Mobile-Notre-Vision-Timeline-
       Verticale-Modele-V1", 2026-09-04) - reproduction fidèle du PNG
       validé par l'owner (REFERENCE-VISUELLE-VALIDEE-NOTRE-VISION-
       MOBILE.png) : remplace l'ancien empilement centré (cercle, puis
       titre, puis accroche, puis paragraphe, tous centrés, sans ligne ni
       flèche - masquées dès 1220px) par un parcours vertical icône-à-
       gauche/texte-à-droite, avec une VRAIE ligne continue (pas des
       pointillés - contrairement à Notre Mission/Nos innovations, dont la
       référence desktop est déjà pointillée ; ici la référence desktop
       est un trait plein avec une pointe de flèche, donc le mobile
       reprend cette identité telle quelle) se terminant par une pointe de
       flèche juste avant le cercle "Progrès pour tous", exactement comme
       sur desktop. Cercles gardés à 62px (pas 54px comme l'ancienne
       version mobile) : la consigne "mêmes cercles" et la taille réelle
       du desktop (62px, inchangée) l'emportent sur l'ancien choix mobile
       plus petit, jamais demandé par l'owner à l'origine. */
    .bopa-vision-v4__timeline {
      grid-template-columns: 1fr;
      margin-top: 3.25rem;
      gap: 2.25rem;
    }

    .bopa-vision-v4__step--endpoint-start,
    .bopa-vision-v4__step--endpoint-end { grid-column: auto; }

    /* Icône-gauche/texte-droite pour TOUTES les étapes (bornes incluses) -
       chaque étape est son propre mini-grid à 2 colonnes. `align-items:
       center` par défaut (traitement "simple" des bornes Innovation/
       Progrès pour tous, consigne owner explicite) ; surchargé en
       `start` juste en dessous pour les 3 piliers seulement, qui doivent
       être "remontés". */
    .bopa-vision-v4__step {
      display: grid;
      grid-template-columns: 62px 1fr;
      column-gap: 18px;
      align-items: center;
      text-align: left;
    }

    /* Les 3 piliers (Acceptabilité/Interopérabilité/Soutenabilité)
       remontés par rapport au centre du cercle (consigne owner très
       explicite, calée sur le PNG) : `start` aligne le haut du titre cyan
       sur le haut du cercle plutôt que de centrer le bloc de texte sur
       toute sa hauteur - jamais appliqué aux bornes, qui gardent le
       centrage simple ci-dessus. */
    .bopa-vision-v4__step:not(.bopa-vision-v4__step--endpoint) {
      align-items: start;
    }

    .bopa-vision-v4__icon {
      width: 62px;
      height: 62px;
      margin: 0;
      position: relative;
      z-index: 1;
    }

    /* L'icône occupe les 3 lignes du texte (titre/accroche/paragraphe)
       pour les piliers uniquement - sur les bornes (1 seule ligne, le
       label), elle reste sur sa propre ligne implicite à côté du label,
       ce qui donne le traitement "simple" demandé. */
    .bopa-vision-v4__step:not(.bopa-vision-v4__step--endpoint) .bopa-vision-v4__icon {
      grid-row: 1 / 4;
    }

    /* Connecteur : VRAIE ligne pleine (pas de pointillés), un segment par
       étape (sauf la dernière) plutôt qu'une seule ligne sur toute la
       hauteur du conteneur - même technique que Notre Mission/Nos
       innovations mobile (voir leurs commentaires pour la dérivation
       complète) : la hauteur de chaque étape dépend du texte réel
       (variable, surtout pour les 3 piliers), donc pas de pourcentage
       fixe fiable pour toucher précisément chaque cercle. `top:62px`
       (bas de CE cercle) à `bottom:-(gap+31)px` (dépasse jusqu'au CENTRE
       du cercle suivant, caché derrière lui) ne dépend que du `gap` réel
       (2.25rem=36px) et du rayon (31px), jamais de la hauteur du texte. */
    .bopa-vision-v4__step:not(:last-child)::before {
      content: "";
      display: block;
      position: absolute;
      left: 31px;
      top: 62px;
      bottom: -67px;
      /* height:auto, largeur/fond/rayon à zéro/none explicites (pack
         "Mobile-Notre-Vision-Fleche-Continue-V2", 2026-09-04) : le
         connecteur ne devenait qu'un petit trait de 8px sous chaque
         cercle au lieu d'une vraie ligne continue - la règle desktop
         `.bopa-vision-v4__step::before` (plus bas, non scopée à ce media
         query) fixe `height:8px` pour son propre petit point caché
         derrière chaque cercle, et comme CETTE règle ne déclarait jamais
         `height` elle-même, la cascade retombait sur ce 8px par défaut,
         quelle que soit sa spécificité supérieure sur top/bottom - déjà
         vu et corrigé une fois ce jour-là pour `display`, raté ici sur
         `height`. Même leçon : toujours redéclarer explicitement une
         propriété qu'une règle plus large fixe ailleurs, plutôt que de
         supposer qu'une spécificité plus élevée sur d'autres propriétés
         suffit. */
      height: auto;
      width: 0;
      background: none;
      border-radius: 0;
      border-left: 2px solid var(--mp-blue-bright);
      opacity: 0.9;
      z-index: 0;
    }

    /* Dernier connecteur (Soutenabilité -> Progrès pour tous) : s'arrête
       AVANT le cercle suivant plutôt que de s'y superposer, pour laisser
       la place à une vraie pointe de flèche visible - exactement la
       même identité que la flèche desktop (bordure haut+droite tournée à
       45°), simplement tournée encore de 90° pour pointer vers le bas
       plutôt que vers la droite. */
    .bopa-vision-v4__step:nth-last-child(2)::before {
      bottom: -16px;
    }
    .bopa-vision-v4__step:nth-last-child(2)::after {
      content: "";
      position: absolute;
      left: 24px;
      top: calc(100% + 8px);
      width: 14px;
      height: 14px;
      border-top: 2px solid var(--mp-blue-bright);
      border-right: 2px solid var(--mp-blue-bright);
      opacity: 0.9;
      transform: rotate(135deg);
      z-index: 0;
    }

    /* Le petit point desktop (.step::before, un repère caché derrière
       chaque cercle, z-index:-1) n'a pas d'équivalent voulu ici - le PNG
       ne montre aucun point intermédiaire sur la ligne verticale, juste
       le trait plein et la flèche finale. Cette règle nue (spécificité
       0,1,0) masque ce point partout, y compris sur "Progrès pour tous"
       (:last-child, qui n'a pas de connecteur du tout) ; sur les 4 autres
       étapes, la règle du connecteur ci-dessus (`:not(:last-child)`,
       spécificité 0,2,0 - plus élevée car `:not()` compte comme un
       pseudo-classe de plus) l'emporte et réutilise ce même ::before pour
       la ligne réelle - display:none n'y a donc aucun effet, elle ne
       s'applique que là où rien de plus spécifique ne le contredit. */
    .bopa-vision-v4__step::before {
      display: none;
    }

    .bopa-vision-v4__step--endpoint .bopa-vision-v4__icon { margin: 0; }

    .bopa-vision-v4__step--endpoint-end .bopa-vision-v4__endpoint-label {
      width: auto;
      margin: 0;
    }

    /* Titre/accroche/paragraphe suivent désormais la largeur réelle de
       la colonne de texte (grid 1fr), pas un plafond pensé pour l'ancien
       bloc centré sous l'icône. */
    .bopa-vision-v4__step h3,
    .bopa-vision-v4__endpoint-label,
    .bopa-vision-v4__tagline,
    .bopa-vision-v4__copy {
      max-width: none;
      margin-left: 0;
      margin-right: 0;
      text-align: left;
    }

    .bopa-vision-v4__tagline { margin-top: 0.5rem; }
    .bopa-vision-v4__copy { margin-top: 0.6rem; }

    /* Les <br /> des accroches (Acceptabilité/Soutenabilité) sont calés sur
       l'étroite colonne centrée du desktop (215-285px) - dans la colonne
       texte plus large de ce nouveau layout mobile, ils forcent une
       coupure au mauvais endroit (un mot seul orphelin sur sa ligne) au
       lieu du retour naturel montré dans le PNG. Même technique déjà
       utilisée pour Nos innovations mobile : masquer le <br>, jamais
       réécrire le texte lui-même. */
    .bopa-vision-v4__tagline br {
      display: none;
    }

    .bopa-vision-v4__network { display: none; }
  }

  /* Empêche le header sticky de masquer le début de section après clic
     sur une ancre du menu. Une seule source de vérité : --bopa-header-height
     (site.css, calculé sur la hauteur réelle du header replié au scroll -
     voir son commentaire pour le détail) - plus d'offset approximatif ni
     de valeur dupliquée à un autre seuil (2026-08-27, correctif ancres). */
  #notre-mission,
  #innovations-bopa,
  #notre-vision,
  #qui-sommes-nous,
  #nous-contacter,
  #nous-soutenir {
    scroll-margin-top: var(--bopa-header-height);
  }
</style>

