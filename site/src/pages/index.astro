  }

  .phase-card {
    background: color-mix(in srgb, var(--step-color) 10%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--step-color) 22%, var(--color-line));
    border-top: 3px solid var(--step-color);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.25s ease;
  }

  .phase-card:hover {
    box-shadow: 0 8px 20px rgba(4, 35, 56, 0.07);
  }

  .phase-card > summary {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  .phase-card > summary::-webkit-details-marker {
    display: none;
  }

  .phase-title {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .phase-subtitle {
    font-size: var(--text-sm);
    color: var(--step-color);
    font-weight: 600;
    margin-top: var(--space-1);
  }

  .project-entry + .project-entry {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .project-entry h4 {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .project-entry p {
    color: var(--color-ink);
    opacity: 0.85;
    margin-top: var(--space-1);
  }

  @media (max-width: 48rem) {
    .accordion-item-lg > summary {
      padding: var(--space-3) var(--space-4);
    }

    .accordion-title {
      font-size: var(--text-base);
    }
  }

  /* ============================================================
     BOPA — Qui sommes-nous V2
     Réf. : CLAUDE-INTEGRATION.md + REFERENCE-QUI-SOMMES-NOUS.png (2026-08-27)
     Réutilise --mp-navy-deep/--mp-blue-bright (voir site.css, scope
     étendu à .about-v2) pour rester dans le même langage visuel que
     Mission/Projets/Innovations.
     ============================================================ */
  .about-v2 {
    --about-ink: var(--color-ink);
    --about-muted: var(--color-muted);
    --about-line: var(--color-line);
    --about-bg: var(--color-bg-tint);
    overflow: clip;
    background: var(--about-bg);
    color: var(--about-ink);
  }

  .about-v2 .wrap { max-width: var(--max-width); }
  .about-v2 h2,
  .about-v2 h3,
  .about-v2 h4,
  .about-v2 h5 { font-family: var(--font-display); letter-spacing: var(--tracking-tight); }
  .about-v2 p,
  .about-v2 span,
  .about-v2 a { font-family: var(--font-text); }

  .about-v2__intro {
    text-align: center;
    padding-top: clamp(4rem, 7vw, 6.75rem);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }
  .about-v2__kicker {
    display: inline-block;
    margin-bottom: 1.15rem;
    color: var(--mp-blue-bright);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .about-v2__kicker::after {
    content: "";
    display: block;
    width: 2.25rem;
    height: 2px;
    margin: .75rem auto 0;
    background: var(--mp-blue-bright);
  }
  .about-v2__intro h2 {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(2rem, 4vw, 3.45rem);
    line-height: 1.08;
    font-weight: 700;
  }

  .about-v2__institutional {
    padding: clamp(1rem, 2vw, 2rem) 0 clamp(4rem, 7vw, 6.25rem);
  }
  .about-v2__chapter-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1.05fr) minmax(18rem, .95fr);
