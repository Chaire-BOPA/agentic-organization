  .about-v2__team {
    display: grid;
    grid-template-columns: minmax(12rem, .72fr) minmax(0, 2.28fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: clamp(4.5rem, 7vw, 6.5rem);
  }
  .about-v2__team-intro h3 {
    margin: .8rem 0 1.5rem;
    color: var(--color-navy);
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: 1.04;
  }
  .about-v2__team-intro p {
    margin: 0;
    color: var(--about-ink);
    font-size: .88rem;
    line-height: 1.65;
  }
  .about-v2__team-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .about-v2__person {
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,.76);
    border: 1px solid var(--about-line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(3, 29, 67, .06);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  @media (hover:hover) and (pointer:fine) {
    .about-v2__person:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(3,29,67,.1); }
  }
  .about-v2__person-photo {
    aspect-ratio: 1.14 / 1;
    overflow: hidden;
    background: #edf2f8;
  }
  .about-v2__person-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .about-v2__photo-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #edf2f8, #f8fbff); }
  .about-v2__person-body { flex: 1; display: flex; flex-direction: column; padding: 1rem 1rem 1.15rem; }
  .about-v2__person-body h4 { margin: 0 0 .25rem; color: var(--color-navy); font-size: 1rem; }
  .about-v2__person-body > strong { display: block; color: var(--mp-blue-bright); font-size: .72rem; line-height: 1.3; }
  .about-v2__person-body .about-v2__credentials { margin: .35rem 0 0; color: var(--about-ink); font-size: .76rem; font-weight: 700; }
  .about-v2__linkedin { display: inline-flex; align-items: center; gap: .45rem; margin-top: auto; padding-top: 1rem; }
  .about-v2__linkedin-icon { width: 1.4rem; height: 1.4rem; display: grid; place-items: center; border-radius: 3px; background: var(--color-accent); color: #fff; font-size: .72rem; font-weight: 800; }

  .about-v2__support {
    padding: clamp(4rem, 7vw, 6.5rem) 0 clamp(4.5rem, 7vw, 6.5rem);
    border-top: 1px solid var(--about-line);
  }
  .about-v2__support-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.35rem;
    max-width: 56rem;
    margin: 0 auto clamp(3rem, 5vw, 4.25rem);
    text-align: center;
  }
  .about-v2__support-head > .about-v2__chapter-number { align-self: start; margin-top: .25rem; }
  .about-v2__support-kicker {
    display: block;
    margin-bottom: .7rem;
    color: var(--mp-blue-bright);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .about-v2__support-head h3 {
    margin: 0 0 1rem;
    color: var(--color-navy);
    font-size: clamp(1.85rem, 3.4vw, 2.9rem);
    line-height: 1.08;
  }
  .about-v2__support-head p {
    max-width: 47rem;
    margin: 0 auto;
    color: var(--about-ink);
    font-size: .98rem;
    line-height: 1.7;
  }
  .about-v2__support-groups {
    display: grid;
    gap: clamp(2.6rem, 5vw, 4rem);
  }
  .about-v2__support-group h4 {
    margin: 0 0 1.5rem;
    color: var(--color-accent);
    font-size: 1rem;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: .11em;
  }
  .about-v2__support-logos {
    display: grid;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  .about-v2__support-logos--foundations {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 52rem;
  }
  .about-v2__support-logo {
    min-height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: .8rem 2rem;
  }
  .about-v2__support-logo + .about-v2__support-logo { border-left: 1px solid var(--about-line); }
  .about-v2__support-logo img {
    display: block;
    max-width: 12rem;
    max-height: 3.8rem;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .about-v2__support-group--patrons {
    padding-top: 2.5rem;
    border-top: 1px solid var(--about-line);
  }
  .about-v2__support-thanks {
    margin: -.65rem auto 1.25rem;
    color: var(--about-muted);
    font-size: .9rem;
    text-align: center;
  }
  .about-v2__support-logos--patrons {
    grid-template-columns: repeat(2, minmax(11rem, 1fr));
    max-width: 34rem;
  }
  .about-v2__support-logo--patron { min-height: 6.5rem; }

  @media (max-width: 980px) {
    .about-v2__chapter-heading { grid-template-columns: auto 1fr; }
    .about-v2__chapter-heading > p { grid-column: 2; }
    .about-v2__proof-grid { grid-template-columns: 1fr; }
    .about-v2__research { padding-right: 0; border-right: 0; padding-bottom: 2rem; border-bottom: 1px solid var(--about-line); }
    .about-v2__clinical { grid-template-columns: 1fr; }
    .about-v2__clinical-inner { width: 100%; padding-left: max(1.5rem, calc((100vw - var(--max-width)) / 2)); padding-right: max(1.5rem, calc((100vw - var(--max-width)) / 2)); }
    .about-v2__clinical-photo, .about-v2__clinical-photo-placeholder { min-height: 25rem; }
    .about-v2__clinical-photo img { min-height: 25rem; }
    .about-v2__team { grid-template-columns: 1fr; }
    .about-v2__team-intro { max-width: 36rem; }
    .about-v2__team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about-v2__support-head { max-width: 46rem; }
  }

  @media (max-width: 680px) {
    .about-v2__intro h2 br { display: none; }
    .about-v2__chapter-heading { grid-template-columns: auto 1fr; gap: .9rem; }
    .about-v2__chapter-heading > p { grid-column: 1 / -1; }
    .about-v2__founder-grid { grid-template-columns: 1fr; }
    .about-v2__founder { min-height: 0; padding: 1.5rem .25rem; }
    .about-v2__founder + .about-v2__founder { border-left: 0; border-top: 1px solid var(--about-line); }
    .about-v2__research-square { grid-template-columns: 1fr 1fr; }
    .about-v2__research-stat { grid-template-columns: 1fr; text-align: center; }
    .about-v2__research-stat .about-v2__stat-icon { margin: 0 auto; }
    .about-v2__impact-row { grid-template-columns: 1fr; }
    .about-v2__impact-stat { grid-template-columns: 2.4rem 1fr; }
    .about-v2__impact-stat + .about-v2__impact-stat { border-left: 0; border-top: 1px solid var(--about-line); }
    .about-v2__clinical-stats { grid-template-columns: repeat(2, 1fr); gap: 1.25rem 0; }
    .about-v2__clinical-stat:nth-child(3) { border-left: 0; }
    .about-v2__clinical-photo, .about-v2__clinical-photo img, .about-v2__clinical-photo-placeholder { min-height: 19rem; }
    .about-v2__clinical-claim { flex-direction: column; }
    .about-v2__support-head { grid-template-columns: 1fr; gap: .7rem; }
    .about-v2__support-head > .about-v2__chapter-number { justify-self: center; }
    .about-v2__support-logos--foundations,
    .about-v2__support-logos--patrons { grid-template-columns: 1fr; }
    .about-v2__support-logo + .about-v2__support-logo { border-left: 0; border-top: 1px solid var(--about-line); }
    .about-v2__team-grid { grid-template-columns: 1fr; }
    .about-v2__person { display: grid; grid-template-columns: 8rem 1fr; }
    .about-v2__person-photo { aspect-ratio: auto; min-height: 11rem; }
  }

  /* ============================================================
     BOPA — Nous soutenir + Nous contacter
     Réf. : CLAUDE-INTEGRATION.md + REFERENCE-SOUTENIR-CONTACT.png (2026-08-27)
     Reprend --mp-navy-deep/--mp-blue-bright (voir site.css, scope étendu
     à .bopa-support/.bopa-contact) pour rester dans le même langage
     visuel que Qui sommes-nous/Mission/Projets/Innovations.
     ============================================================ */
  .bopa-support {
    position: relative;
    overflow: hidden;
    background: var(--mp-navy-deep);
    color: #fff;
  }

  .bopa-support__inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(380px, 1.1fr);
    align-items: center;
    gap: clamp(44px, 7vw, 110px);
    min-height: 455px;
    padding: clamp(72px, 8vw, 104px) 0;
  }

  .bopa-support__copy { max-width: 560px; }

  .bopa-support h2 {
    margin: 0;
    max-width: 620px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.35vw, 3.65rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-tight);
    color: #fff;
  }

  .bopa-support__lead {
    max-width: 560px;
    margin: 28px 0 30px;
    color: rgba(255,255,255,.88);
    font-size: clamp(1rem, 1.22vw, 1.13rem);
    line-height: 1.72;
  }

  .bopa-support__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 58px;
    padding: 0 24px;
    border-radius: var(--radius-md);
    background: var(--mp-blue-bright);
    color: #fff;
    font-weight: 750;
    text-decoration: none;
    box-shadow: 0 12px 34px color-mix(in srgb, var(--mp-blue-bright) 30%, transparent);
    transition: transform .22s ease, background .22s ease, box-shadow .22s ease;
  }

  .bopa-support__cta:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--mp-blue-bright) 88%, white);
    box-shadow: 0 16px 42px color-mix(in srgb, var(--mp-blue-bright) 40%, transparent);
  }

  .bopa-support__cta-icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  .bopa-support__note {
    margin: 18px 0 0;
    color: rgba(255,255,255,.58);
    font-size: .84rem;
    font-style: italic;
  }

  .bopa-support__visual {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  .bopa-support__visual img {
    display: block;
    width: min(100%, 560px);
    height: auto;
    object-fit: contain;
    mix-blend-mode: screen;
    filter: saturate(1.03) contrast(1.03);
  }

  .bopa-contact {
    position: relative;
    background: var(--color-bg-tint);
    color: var(--color-ink);
    overflow: hidden;
  }

  .bopa-contact__inner {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding: clamp(72px, 8vw, 104px) 0;
    display: grid;
    grid-template-columns: minmax(260px, .78fr) minmax(520px, 1.22fr);
    gap: clamp(48px, 7vw, 100px);
    align-items: start;
  }

  .bopa-contact__kicker {
    margin: 0 0 7px;
    color: var(--mp-blue-bright);
    font-weight: 760;
    font-size: .98rem;
  }

  .bopa-contact h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 4.15rem);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-navy);
  }

  .bopa-contact__text {
    max-width: 390px;
    margin: 24px 0 34px;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .bopa-contact__details {
    display: grid;
    gap: 20px;
  }

  .bopa-contact__detail {
    display: grid;
    grid-template-columns: 44px minmax(0,1fr);
    gap: 14px;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }

  .bopa-contact__detail-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-accent) 12%, white);
    color: var(--color-accent);
    font-weight: 800;
    font-size: 1.05rem;
  }

  .bopa-contact__detail-icon--linkedin { font-family: Arial, sans-serif; }

  .bopa-contact__detail strong,
  .bopa-contact__detail small {
    display: block;
  }

  .bopa-contact__detail strong { margin-top: 1px; font-size: .95rem; color: var(--color-ink); }
  .bopa-contact__detail small { margin-top: 4px; color: var(--color-muted); line-height: 1.45; font-size: .84rem; }

