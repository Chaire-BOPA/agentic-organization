---
import Base from '../layouts/Base.astro';
---

<Base
  title="Publications - BOPA"
  description="Les publications scientifiques et axes de recherche de la Chaire Innovation BOPA."
>
  <section class="section-block">
    <div class="wrap">
      <span class="kicker">Innovations</span>
      <h1>Publications</h1>
      <p class="lede">
        Grâce au soutien de ses partenaires, la Chaire Innovation BOPA a pu
        financer de nombreux travaux de recherche.
      </p>

      <div class="stat-row">
        <div class="stat">
          <span class="stat-value">46</span>
          <span class="stat-label">Articles scientifiques</span>
        </div>
        <div class="stat">
          <span class="stat-value">48</span>
          <span class="stat-label">Présentations en congrès</span>
        </div>
        <div class="stat">
          <span class="stat-value">3</span>
          <span class="stat-label">Axes de recherche</span>
        </div>
      </div>

      <h2>Trois axes de recherche</h2>
      <div class="card-grid">
        <div class="card">
          <h3>Data</h3>
          <p>Valoriser et exploiter les données générées et disponibles au bloc opératoire.</p>
        </div>
        <div class="card">
          <h3>Jumeaux numériques</h3>
          <p>
            Développer des modèles numériques anatomiques et
            hémodynamiques pour mieux comprendre et anticiper les
            situations cliniques.
          </p>
        </div>
        <div class="card">
          <h3>Sciences humaines</h3>
          <p>
            Analyser les impacts de la transformation numérique du bloc
            opératoire, pour identifier les conditions optimales d'une
            collaboration efficace entre l'humain et la machine.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
