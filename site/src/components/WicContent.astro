---
// Shared body for /wic/ et /en/wic/ (FR est la source de verite pour le
// markup/CSS ; seul le texte change, via isEn - meme pattern que
// BoptechContent.astro/PublicationsContent.astro/InnovationsContent.astro).
//
// Refonte du 2026-09-10 (pack "BOPA-WIC-Refonte-V1") : l'owner a fourni
// deux maquettes VALIDEES (01-modele-page-WIC.png, 02-modele-hero-WIC.png)
// avec consigne explicite de s'en eloigner le moins possible - ce fichier
// reproduit leur composition/hierarchie/alternance de fonds au plus pres,
// adaptee aux vrais tokens/composants du site (jamais une nouvelle DA).
// Objectif central du pack : arriver tres vite aux videos, qui deviennent
// le vrai temps fort de la page (grand lecteur + pellicule de vignettes),
// au lieu des petites cartes YouTube alignees de la version precedente.
//
// Hero : photo originale fournie par l'owner (03-photo-originale-hero-
// WIC.jpeg, jamais generee/retouchee - copiee telle quelle), avec le
// meme systeme calque photo/teinte/degrade que le Hero de la Home
// (HomeContent.astro : .hero-photo/.hero-wash/.hero-gradient), redeclare
// ici sous des noms de classe locaux (styles Astro scopes par composant)
// en reprenant la MEME courbe de degrade, jamais une formule inventee.
//
// Videos : memes 5 IDs verifies un par un sur la playlist officielle
// YouTube de la Chaire BOPA (inchange depuis la premiere integration).
// Vignettes de la pellicule : vraies miniatures YouTube officielles
// (i.ytimg.com/vi/<id>/hqdefault.jpg, CDN public de YouTube, aucune image
// generee) - seule la video ACTIVE recoit un vrai embed youtube-nocookie
// (chargee des qu'elle devient active, jamais les 5 en meme temps).
interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

const wicVideos = [
  { id: 'mMSFKrosI_Q', year: 2025 },
  { id: 'FUUCsqPMb2U', year: 2023 },
  { id: 'YHXT4Jh8Dd0', year: 2022 },
  { id: 'bnLG9ps0wxs', year: 2019 },
  { id: 'IvhXKSktSi0', year: 2017 },
].map((v) => ({ ...v, thumb: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg` }));
const wicPlaylistUrl = 'https://www.youtube.com/playlist?list=PLW02oRYi4wae-awNWfUJSXr6P9UpZkll4';

const chevronLeft =
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const chevronRight =
  '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const playIcon =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#FF0000"/><path d="M9.5 7.5v9l7-4.5z" fill="#fff"/></svg>';
---

<main class="wic-v2" id="wic-v2">
  <section class="wic-v2__hero" aria-labelledby="wic-title">
    <img
      class="wic-v2__hero-photo"
      src="/images/wic/hero-wic.jpeg"
      alt={isEn
        ? 'A speaker presents a 3D anatomical model during a Surgical Innovation Weekend workshop, in front of a seated audience.'
        : "Un intervenant presente une modelisation 3D anatomique lors d'un atelier du Week-end de l'Innovation Chirurgicale, devant un public assis."}
      width="2048"
      height="1536"
    />
    <div class="wic-v2__hero-wash" aria-hidden="true"></div>
    <div class="wic-v2__hero-gradient" aria-hidden="true"></div>
    <div class="wic-v2__container wic-v2__hero-inner">
      <p class="wic-v2__breadcrumb">
        {isEn ? 'Home' : 'Accueil'} <span aria-hidden="true">›</span> WIC
      </p>
      <span class="wic-v2__kicker">{isEn ? 'The Surgical Innovation Weekend' : "Le Week-end de l'Innovation Chirurgicale"}</span>
      <h1 id="wic-title">
        {isEn
          ? <>What if tomorrow's hospital could be invented in a single weekend?</>
          : <>Et si l'hôpital de demain s'inventait le temps d'un week-end&nbsp;?</>}
      </h1>
      <p class="wic-v2__lead">
        {isEn ? (
          <>
            The Surgical Innovation Weekend (WIC) is a gathering where people
            from all walks of life come together to imagine new ways of
            thinking about surgery and hospital practice.
          </>
        ) : (
          <>
            Le Week-end de l'Innovation Chirurgicale (WIC) est un rendez-vous
            où des acteurs venus d'horizons variés se rencontrent pour
            imaginer ensemble de nouvelles façons de penser la chirurgie et
            les pratiques hospitalières.
          </>
        )}
      </p>
    </div>
  </section>

  <section class="wic-v2__section" aria-labelledby="wic-multi-title">
    <div class="wic-v2__container wic-v2__duo">
      <div class="wic-v2__duo-col">
        <h2 id="wic-multi-title">
          {isEn
            ? 'A multidisciplinary gathering in the service of innovation'
            : "Une rencontre pluridisciplinaire au service de l'innovation"}
        </h2>
        <p class="wic-v2__lead">
          {isEn ? (
            <>
              Physicians, healthcare professionals, engineers, researchers
              and experts from different backgrounds bring their
              perspectives together to imagine new hospital practices. WIC
              creates a space away from the everyday, fostering creativity,
              exchange and the emergence of new ideas.
            </>
          ) : (
            <>
              Médecins, soignants, ingénieurs, chercheurs et experts
              d'horizons variés croisent leurs regards pour imaginer
              ensemble de nouvelles pratiques hospitalières. Le WIC crée un
              espace hors du quotidien, propice à la créativité, aux
              échanges et à l'émergence d'idées nouvelles.
            </>
          )}
        </p>
      </div>
      <div class="wic-v2__duo-divider" aria-hidden="true"></div>
      <div class="wic-v2__duo-col">
        <h2 id="wic-setting-title">{isEn ? 'A setting built for ideation' : "Un cadre qui favorise l'idéation"}</h2>
        <p class="wic-v2__lead">
          {isEn ? (
            <>
              WIC is not like a traditional conference. Its deliberately
              relaxed setting fosters informal exchange, creativity and the
              emergence of new ideas.
            </>
          ) : (
            <>
              Le WIC ne ressemble pas à un congrès traditionnel. Son cadre
              volontairement décontracté favorise les échanges informels, la
              créativité et l'émergence d'idées nouvelles.
            </>
          )}
        </p>
        <p class="wic-v2__callout-inline">
          {isEn ? (
            <>
              A breath of fresh air where a more innovative, more human and
              more collaborative hospital takes shape, together.
            </>
          ) : (
            <>
              Une bulle d'oxygène où se dessine, collectivement, un hôpital
              plus innovant, plus humain et plus collaboratif.
            </>
          )}
        </p>
      </div>
    </div>
  </section>

  <section class="wic-v2__section wic-v2__section--dark wic-v2__birth" aria-labelledby="wic-birth-title">
    <div class="wic-v2__container">
      <span class="wic-v2__kicker wic-v2__kicker--badge">2019 → 2020</span>
      <h2 id="wic-birth-title">{isEn ? 'From WIC to the birth of BOPA' : 'Du WIC à la naissance de BOPA'}</h2>
      <p class="wic-v2__lead wic-v2__lead--full">
        {isEn ? (
          <>
            The 2019 edition of the Surgical Innovation Weekend sparked a
            lasting momentum that led, in 2020, to the creation of the BOPA
            Chair: bringing different fields of expertise together to turn
            innovation into concrete progress for surgery and for patients.
          </>
        ) : (
          <>
            L'édition 2019 du Week-end de l'Innovation Chirurgicale a fait
            naître une dynamique durable qui a conduit, en 2020, à la
            création de la Chaire BOPA : faire travailler ensemble des
            expertises différentes pour transformer l'innovation en progrès
            concret pour la chirurgie et les patients.
          </>
        )}
      </p>
    </div>
  </section>

  <section class="wic-v2__section wic-v2__images" aria-labelledby="wic-images-title">
    <div class="wic-v2__container">
      <div class="wic-v2__images-head">
        <div>
          <span class="wic-v2__kicker wic-v2__kicker--line">{isEn ? 'WIC in pictures' : 'Le WIC en images'}</span>
          <h2 id="wic-images-title">{isEn ? 'WIC in pictures' : 'Le WIC en images'}</h2>
        </div>
        <p class="wic-v2__images-intro">
          {isEn
            ? 'Step into the latest editions of the Surgical Innovation Weekend.'
            : "Plongez au cœur des dernières éditions du Week-end de l'Innovation Chirurgicale."}
        </p>
      </div>

      <div class="wic-v2__player" data-action-carousel role="group" aria-roledescription={isEn ? 'carousel' : 'carrousel'} aria-label={isEn ? 'WIC videos' : 'Vidéos du WIC'}>
        <div class="wic-v2__player-viewport" data-action-viewport tabindex="0">
          <div class="wic-v2__player-track" data-action-track>
            {wicVideos.map((video, i) => (
              <div
                class="wic-v2__player-slide"
                data-action-slide
                data-video-id={video.id}
                data-video-year={video.year}
                role="group"
                aria-roledescription={isEn ? 'slide' : 'diapositive'}
                aria-label={`${i + 1} / ${wicVideos.length}`}
              >
                <div class="wic-v2__player-frame">
                  <button type="button" class="wic-v2__player-thumb" data-action-thumb aria-label={isEn ? `Play WIC ${video.year}` : `Lire WIC ${video.year}`}>
                    <img src={video.thumb} alt="" loading="lazy" width="480" height="360" />
                    <span class="wic-v2__player-play" set:html={playIcon} />
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>

        <button type="button" class="wic-v2__player-nav wic-v2__player-nav--prev" data-action-prev aria-label={isEn ? 'Previous video' : 'Vidéo précédente'} set:html={chevronLeft} />
        <button type="button" class="wic-v2__player-nav wic-v2__player-nav--next" data-action-next aria-label={isEn ? 'Next video' : 'Vidéo suivante'} set:html={chevronRight} />
      </div>

      <div class="wic-v2__player-meta">
        <p class="wic-v2__player-title" data-action-title>{`WIC ${wicVideos[0].year}`}</p>
        <div class="wic-v2__player-controls">
          <div class="wic-v2__player-dots" data-action-dots role="tablist" aria-label={isEn ? 'Go to a specific edition' : 'Aller à une édition'}>
            {wicVideos.map((video, i) => (
              <button
                type="button"
                class="wic-v2__player-dot"
                data-action-dot
                data-index={i}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`WIC ${video.year}`}
              ></button>
            ))}
          </div>
          <span class="wic-v2__player-counter" data-action-counter>{`01 / ${String(wicVideos.length).padStart(2, '0')}`}</span>
        </div>
      </div>

      <div class="wic-v2__filmstrip" data-action-filmstrip>
        {wicVideos.map((video, i) => (
          <button type="button" class="wic-v2__filmstrip-item" data-action-filmstrip-item data-index={i} aria-current={i === 0 ? 'true' : 'false'}>
            <img src={video.thumb} alt="" loading="lazy" width="480" height="360" />
            <span class="wic-v2__filmstrip-caption">{`WIC ${video.year}`}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="wic-v2__cta">
    <div class="wic-v2__container">
      <div class="wic-v2__cta-inner">
        <div class="wic-v2__cta-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none"><path d="M12 12h30l10 10v30H12z"/><path d="M26 24l16 8-16 8z" fill="currentColor" stroke="none"/></svg>
        </div>
        <div class="wic-v2__cta-copy">
          <h2>{isEn ? <>Want to see more?</> : <>Envie d'en voir plus ?</>}</h2>
          <p>
            {isEn
              ? 'All WIC editions, in video, on the BOPA Chair official channel.'
              : 'Toutes les éditions du WIC, en vidéo, sur la chaîne officielle de la Chaire BOPA.'}
          </p>
        </div>
        <a class="wic-v2__cta-button" href={wicPlaylistUrl} target="_blank" rel="noopener noreferrer">
          {isEn ? 'See all WIC videos' : 'Voir toutes les vidéos du WIC'} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</main>

<script>
  // Lecteur premium "Le WIC en images" (pack "BOPA-WIC-Refonte-V1",
  // 2026-09-10, remplace le rail de petites cartes de la version
  // precedente) - meme principe de carrousel centre que celui de la
  // sous-section "L'equipe BOPA en action" (HomeContent.astro : slide
  // active au centre, voisines partiellement visibles via
  // scroll-snap-align:center + padding-inline sur le viewport), mais
  // pilote ici aussi : le titre d'edition, les points de progression et
  // la pellicule de vignettes sous le lecteur (3 façons redondantes de
  // naviguer : drag/scroll, points, clic sur une vignette). Seule la
  // slide ACTIVE charge un vrai embed YouTube (cree/detruit a la volee) -
  // les autres restent de simples miniatures statiques, jamais 5 iframes
  // chargees en meme temps.
  const wicRoot = document.querySelector('[data-action-carousel]');
  if (wicRoot && !wicRoot.hasAttribute('data-action-ready')) {
    wicRoot.setAttribute('data-action-ready', 'true');

    const viewport = wicRoot.querySelector<HTMLElement>('[data-action-viewport]');
    const track = wicRoot.querySelector<HTMLElement>('[data-action-track]');
    const prev = wicRoot.querySelector<HTMLButtonElement>('[data-action-prev]');
    const next = wicRoot.querySelector<HTMLButtonElement>('[data-action-next]');
    const titleEl = document.querySelector<HTMLElement>('[data-action-title]');
    const counterEl = document.querySelector<HTMLElement>('[data-action-counter]');
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-action-dot]'));
    const filmItems = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-action-filmstrip-item]'));

    if (viewport && track && prev && next && titleEl && counterEl) {
      const getSlides = () => Array.from(track.querySelectorAll<HTMLElement>('[data-action-slide]'));
      const slides = getSlides();
      const total = slides.length;
      const pad = (n: number) => String(n).padStart(2, '0');

      const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const scrollBehavior = () => (reducedMotion() ? 'auto' : 'smooth');

      const nearestActiveIndex = () => {
        const viewportCenter = viewport.scrollLeft + viewport.clientWidth / 2;
        let best = 0;
        let bestDist = Infinity;
        slides.forEach((slide, i) => {
          const dist = Math.abs((slide.offsetLeft + slide.offsetWidth / 2) - viewportCenter);
          if (dist < bestDist) { bestDist = dist; best = i; }
        });
        return best;
      };

      // Charge/decharge le vrai embed YouTube uniquement sur la slide
      // active (jamais plusieurs a la fois) - les autres reviennent a
      // leur miniature statique (bouton play).
      const setEmbed = (index: number) => {
        slides.forEach((slide, i) => {
          const frame = slide.querySelector<HTMLElement>('.wic-v2__player-frame');
          if (!frame) return;
          const existingFrame = frame.querySelector('iframe');
          if (i === index) {
            if (existingFrame) return;
            frame.innerHTML = '';
            const iframe = document.createElement('iframe');
            iframe.src = `https://www.youtube-nocookie.com/embed/${slide.dataset.videoId}`;
            iframe.title = `Week-end de l'Innovation Chirurgicale ${slide.dataset.videoYear}`;
            iframe.loading = 'lazy';
            iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
            iframe.referrerPolicy = 'strict-origin-when-cross-origin';
            iframe.allowFullscreen = true;
            frame.appendChild(iframe);
          } else if (existingFrame) {
            const thumb = wicRoot.querySelector(`[data-action-slide]:nth-child(${i + 1}) [data-action-thumb]`);
            frame.innerHTML = '';
            if (thumb) frame.appendChild(thumb);
          }
        });
      };

      let activeIndex = 0;
      const render = () => {
        const year = slides[activeIndex]?.dataset.videoYear || '';
        titleEl.textContent = `WIC ${year}`;
        counterEl.textContent = `${pad(activeIndex + 1)} / ${pad(total)}`;
        prev.disabled = activeIndex <= 0;
        next.disabled = activeIndex >= total - 1;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === activeIndex));
        dots.forEach((dot, i) => dot.setAttribute('aria-selected', i === activeIndex ? 'true' : 'false'));
        filmItems.forEach((item, i) => item.setAttribute('aria-current', i === activeIndex ? 'true' : 'false'));
        setEmbed(activeIndex);
      };
      render();

      const goTo = (index: number) => {
        const clamped = Math.max(0, Math.min(total - 1, index));
        const target = slides[clamped];
        if (!target) return;
        viewport.scrollTo({
          left: target.offsetLeft + target.offsetWidth / 2 - viewport.clientWidth / 2,
          behavior: scrollBehavior(),
        });
      };

      prev.addEventListener('click', () => goTo(nearestActiveIndex() - 1));
      next.addEventListener('click', () => goTo(nearestActiveIndex() + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
      filmItems.forEach((item, i) => item.addEventListener('click', () => goTo(i)));
      wicRoot.querySelectorAll('[data-action-thumb]').forEach((btn, i) => btn.addEventListener('click', () => goTo(i)));

      viewport.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') { event.preventDefault(); goTo(nearestActiveIndex() + 1); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(nearestActiveIndex() - 1); }
      });

      let scrollRaf = 0;
      viewport.addEventListener('scroll', () => {
        cancelAnimationFrame(scrollRaf);
        scrollRaf = requestAnimationFrame(() => {
          const idx = nearestActiveIndex();
          if (idx !== activeIndex) { activeIndex = idx; render(); }
        });
      }, { passive: true });

      // Drag souris uniquement (trackpad/tactile deja geres par le
      // scroll natif) - meme technique que le carrousel photo "L'equipe
      // BOPA en action".
      let dragging = false;
      let dragStartX = 0;
      let dragStartScroll = 0;
      viewport.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse') return;
        dragging = true;
        dragStartX = event.clientX;
        dragStartScroll = viewport.scrollLeft;
        viewport.classList.add('is-dragging');
        viewport.setPointerCapture(event.pointerId);
      });
      viewport.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        viewport.scrollLeft = dragStartScroll - (event.clientX - dragStartX);
      });
      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        viewport.classList.remove('is-dragging');
        if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
        const idx = nearestActiveIndex();
        activeIndex = idx;
        goTo(idx);
      };
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      let wicResizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(wicResizeTimer);
        wicResizeTimer = setTimeout(() => goTo(activeIndex), 150);
      });
    }
  }
</script>

<style>
  /* ============================================================
     BOPA - /wic/ (refonte 2026-09-10, pack "BOPA-WIC-Refonte-V1")
     Reference directe : les 2 maquettes validees du pack (01-modele-
     page-WIC.png, 02-modele-hero-WIC.png). --mp-navy/--bopa-cyan
     rejoints via le selecteur de tokens partage de site.css (`.wic-v2`
     dans la meme liste que `.innovations-v2`, etc.).
     ============================================================ */

  .wic-v2 {
    color: var(--color-ink);
    background: var(--color-bg-tint);
  }

  .wic-v2 *,
  .wic-v2 *::before,
  .wic-v2 *::after {
    box-sizing: border-box;
  }

  .wic-v2__container {
    width: min(1320px, calc(100% - 64px));
    margin-inline: auto;
  }

  /* Hero : photo + calques, meme recette que le Hero de la Home
     (HomeContent.astro .hero-photo/.hero-wash/.hero-gradient) -
     redeclaree ici (styles Astro scopes par composant), meme courbe de
     degrade, jamais une formule inventee. */
  .wic-v2__hero {
    --wic-hero-blue: var(--mp-navy);
    position: relative;
    overflow: hidden;
    aspect-ratio: 2.15 / 1;
    min-height: 26rem;
    display: flex;
    align-items: center;
  }
  @media (max-width: 40rem) {
    .wic-v2__hero {
      aspect-ratio: auto;
      min-height: 30rem;
    }
  }

  .wic-v2__hero-photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }

  .wic-v2__hero-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--wic-hero-blue);
    opacity: 0.32;
    mix-blend-mode: color;
    pointer-events: none;
  }

  /* Meme courbe exacte que .hero-gradient (HomeContent.astro) - nuit
     profonde a gauche (texte), transition longue, jamais de transparence
     totale a droite. */
  .wic-v2__hero-gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--wic-hero-blue) 100%, transparent) 0%,
      color-mix(in srgb, var(--wic-hero-blue) 100%, transparent) 24%,
      color-mix(in srgb, var(--wic-hero-blue) 96%, transparent) 32%,
      color-mix(in srgb, var(--wic-hero-blue) 90%, transparent) 42%,
      color-mix(in srgb, var(--wic-hero-blue) 82%, transparent) 52%,
      color-mix(in srgb, var(--wic-hero-blue) 70%, transparent) 62%,
      color-mix(in srgb, var(--wic-hero-blue) 56%, transparent) 72%,
      color-mix(in srgb, var(--wic-hero-blue) 36%, transparent) 84%,
      color-mix(in srgb, var(--wic-hero-blue) 14%, transparent) 100%
    );
    pointer-events: none;
  }

  .wic-v2__hero-inner {
    position: relative;
    z-index: 3;
  }

  .wic-v2__breadcrumb {
    margin: 0 0 22px;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .wic-v2__breadcrumb span {
    margin-inline: 8px;
  }

  .wic-v2__kicker {
    display: inline-block;
    margin-bottom: 1.1rem;
    font-family: var(--font-text);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bopa-cyan);
  }

  .wic-v2__hero h1 {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(1.9rem, 3.1vw, 2.85rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: #fff;
  }

  .wic-v2__lead {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    line-height: 1.65;
    color: var(--color-muted);
  }
  .wic-v2__hero .wic-v2__lead {
