---
// FR / EN switch (pack "Version-Anglaise-Switch-FR-EN-V1", 2026-09-03).
// Rendered TWICE by Base.astro (variant="desktop" inside #site-nav, right
// before the "Nous soutenir" CTA; variant="mobile" outside #site-nav, right
// before the hamburger) because the two live in different DOM positions -
// #site-nav collapses entirely behind the hamburger below the header's
// nav breakpoint, so a single shared instance could not stay visible in
// both places. Only one of the two is ever displayed at a given viewport
// width (see the media query below), so exactly one is visible/focusable
// at a time - never both.
interface Props {
  lang: 'fr' | 'en';
  frPath: string;
  enPath: string;
  variant: 'desktop' | 'mobile';
}

const { lang, frPath, enPath, variant } = Astro.props;
const isEn = lang === 'en';
---

<div class={`lang-switch lang-switch--${variant}`} role="group" aria-label="Choisir la langue du site / Choose the site language">
  {isEn ? (
    <a class="lang-switch__link" href={frPath} lang="fr" hreflang="fr" data-lang-switch-link data-lang-switch-base={frPath}>FR</a>
  ) : (
    <span class="lang-switch__link is-active" aria-current="true">FR</span>
  )}
  <span class="lang-switch__sep" aria-hidden="true"></span>
  {isEn ? (
    <span class="lang-switch__link is-active" aria-current="true">EN</span>
  ) : (
    <a class="lang-switch__link" href={enPath} lang="en" hreflang="en" data-lang-switch-link data-lang-switch-base={enPath}>EN</a>
  )}
</div>

<style>
  /* No background/border/pill/underline anywhere here (owner's explicit
     "doit se fondre dans le header") - only color + weight distinguish the
     active language, exactly as specced. Font-size 0.8rem (< nav links'
     var(--text-sm)/0.875rem) : owner, 2026-09-03, "typo légèrement plus
     petite et plus légère que les liens de navigation", pour ne jamais
     lire comme une catégorie du menu. */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.8rem;
    line-height: 1;
  }

  /* Owner correction 2026-09-03 (pack "Version-Anglaise-Correctifs-V2") :
     le switch vit maintenant APRÈS le CTA, dans .nav-cta-group
     (Base.astro/site.css) dont le `gap: 12px` régit déjà l'espacement
     CTA -> séparateur -> switch - plus besoin de marges négatives ici
     pour compenser le gap de nav lui-même, puisque le switch n'est plus
     un enfant direct de nav. */

  /* Couleur : owner, 2026-09-03 - "NE CRÉE PAS un nouveau bleu, récupère
     EXACTEMENT le bleu nuit plus clair déjà utilisé dans la phrase
     française 'à toutes celles et ceux qui, par leur don, rendent cette
     aventure possible'" -> --color-accent (#03529c ; voir
     .bopa-support__patrons-thanks, index.astro). L'inactive réutilise le
     même token, atténué via color-mix plutôt qu'un gris indépendant -
     jamais de nouvelle couleur inventée pour cet état. */
  .lang-switch__link {
    color: color-mix(in srgb, var(--color-accent) 48%, transparent);
    font-weight: 400;
    text-decoration: none;
    padding: 2px;
    border-radius: 2px;
  }

  a.lang-switch__link {
    transition: color 0.2s ease;
  }

  a.lang-switch__link:hover {
    color: var(--color-accent);
  }

  .lang-switch__link.is-active {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* Barre verticale plutôt qu'un caractère "/" (owner, 2026-09-04 : la
     glyphe penche comme un slash, elle la veut bien verticale) - dessinée
     en CSS pour un vrai trait droit, pas un glyphe de police. Même couleur
     exacte qu'avant (color-mix, 45%) - seule la forme change. */
  .lang-switch__sep {
    display: inline-block;
    width: 1px;
    height: 0.9em;
    background: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  a.lang-switch__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Desktop instance lives inside #site-nav, hidden once the nav collapses
     behind the hamburger; mobile instance is the exact reverse. Same
     breakpoint as .site-header's own nav collapse (site.css, 76rem) -
     duplicated here since a scoped component style can't reference that
     rule directly, but the two are tightly coupled by design (the mobile
     instance exists specifically to survive this breakpoint). */
  .lang-switch--mobile {
    display: none;
  }

  @media (max-width: 76rem) {
    .lang-switch--desktop {
      display: none;
    }
    .lang-switch--mobile {
      display: inline-flex;
    }
  }
</style>
