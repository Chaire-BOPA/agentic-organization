---
// Shared shell for every page: head, header, footer.
// Nav lives here and only here; adding a page means adding one link below.
import '../../../source/brand/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Personalized during setup.
const siteName = 'BOPA';

type NavLink = { href: string; label: string };
type NavGroup = { label: string; children: NavLink[] };
type NavItem = NavLink | NavGroup;

// Mostly in-page anchors into the one-pager; "Nos innovations" is the
// one exception, a dropdown to its three dedicated pages (the home
// page's carousel only shows a preview of the full project list).
const nav: NavItem[] = [
  { href: '/#approche', label: 'Notre approche' },
  {
    label: 'Nos innovations',
    children: [
      { href: '/innovations', label: 'Nos projets' },
      { href: '/boptech', label: 'Plateforme BOPtech' },
      { href: '/publications', label: 'Publications' },
    ],
  },
  { href: '/#equipe', label: 'Notre équipe' },
  { href: '/#contact', label: 'Contact' },
];

const navCta = { href: '/#soutenir', label: 'Nous soutenir' };

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Aperçu de partage (LinkedIn, Slack, iMessage...) : sans ça, un lien
         partagé n'affiche ni image ni description, juste l'URL nue. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/">
          <img
            src="/logos/bopa-wordmark.png"
            alt="BOPA"
            width="900"
            height="415"
          />
          <span class="wordmark-text">
            <span class="wordmark-title">Le bloc opératoire<br /><em>Augmenté</em></span>
          </span>
        </a>
        <div class="site-header-controls">
          <nav id="site-nav">
            {nav.map((item) =>
              'children' in item ? (
                <div class="nav-dropdown">
                  <button type="button" class="nav-dropdown-trigger" aria-expanded="false">
                    {item.label}
                  </button>
                  <div class="nav-dropdown-panel">
                    {item.children.map((child) => (
                      <a href={child.href}>{child.label}</a>
                    ))}
                  </div>
                </div>
              ) : (
                <a href={item.href}>{item.label}</a>
              )
            )}
            <a class="btn nav-cta btn-filled-premium" href={navCta.href}>
              {navCta.label}
            </a>
          </nav>
          <button
            type="button"
            class="nav-toggle"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {siteName}</p>
    </footer>
    <script>
      // Click-to-open nav dropdown (just "Nos innovations" for now):
      // closes on outside click, Escape, or when a link inside is chosen.
      const dropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');

      const closeAllDropdowns = () => {
        dropdowns.forEach((d) => {
          d.classList.remove('is-open');
          d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        });
      };

      dropdowns.forEach((dropdown) => {
        const trigger = dropdown.querySelector('.nav-dropdown-trigger');
        trigger?.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = dropdown.classList.contains('is-open');
          closeAllDropdowns();
          if (!isOpen) {
            dropdown.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });

      document.addEventListener('click', closeAllDropdowns);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAllDropdowns();
      });
    </script>
    <script>
      // Mobile/tablet nav toggle: below the breakpoint where the full nav
      // row wraps onto multiple lines (site.css), the nav collapses behind
      // this hamburger button instead of just letting it wrap and bloat
      // the header's height.
      const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const siteNav = document.getElementById('site-nav');

      const closeNav = () => {
        siteNav?.classList.remove('is-open');
        navToggle?.setAttribute('aria-expanded', 'false');
      };

      navToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = siteNav?.classList.contains('is-open');
        if (isOpen) {
          closeNav();
        } else {
          siteNav?.classList.add('is-open');
          navToggle.setAttribute('aria-expanded', 'true');
        }
      });

      siteNav?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).tagName === 'A') closeNav();
      });

      document.addEventListener('click', (event) => {
        if (!siteNav?.contains(event.target as Node) && event.target !== navToggle) closeNav();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeNav();
      });
    </script>
    <script>
      // Header compact au scroll : au-delà d'un petit seuil, le header
      // gagne un fond flouté/translucide et une ombre discrète (voir
      // .site-header.is-scrolled dans site.css).
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        const applyScrollState = () => {
          header.classList.toggle('is-scrolled', window.scrollY > 24);
        };
        applyScrollState();
        window.addEventListener('scroll', applyScrollState, { passive: true });
      }
    </script>
    <script>
      // Scroll-reveal: fade/slide [data-reveal] elements up as they enter
      // the viewport, once each. Stat numbers additionally count up from 0.
      // Skips straight to the revealed state for prefers-reduced-motion.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el: HTMLElement) => {
        const target = parseInt(el.textContent ?? '', 10);
        if (Number.isNaN(target)) return;
        const suffix = (el.textContent ?? '').replace(/^[0-9]+/, '');
        const duration = 1000;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const revealAll = () => revealables.forEach((el) => el.classList.add('is-revealed'));

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-revealed');
              if (el.classList.contains('stat-value')) countUp(el);
              obs.unobserve(el);
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
        );
        revealables.forEach((el) => observer.observe(el));

        // Safety net: a backgrounded/prerendered tab or an odd browser can
        // delay or skip intersection callbacks entirely. Content must never
        // stay invisible because of a decorative animation, so force it
        // visible after a few seconds regardless.
        setTimeout(() => {
          observer.disconnect();
          revealAll();
        }, 3000);
      }
    </script>
  </body>
</html>
