---
// Shared shell for every page: head, header, footer.
// Nav lives here and only here; adding a page means adding one link below.
import '../../../source/brand/tokens.css';
import '../styles/site.css';
import LangSwitch from '../components/LangSwitch.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
}

// `lang` defaults to 'fr' so every existing FR page (`<Base title=...
// description=...>`, no lang prop) renders exactly as before this pack -
// nothing below that reads `lang`/`isEn` can change FR's output, since FR
// always takes the `!isEn` branch it already took.
const { title, description, lang = 'fr' } = Astro.props;
const isEn = lang === 'en';

// Personalized during setup.
const siteName = 'BOPA';

type NavLink = { href: string; label: string };
type NavGroup = { label: string; children: NavLink[] };
type NavItem = NavLink | NavGroup;

// Flat in-page anchors into the one-pager, per the owner's 2026-08-27
// header restructuring pack. The nav no longer links out to the
// dedicated /innovations, /boptech, /publications pages (owner's
// explicit call, same day) - those pages still exist and are still
// linked from within the home page's own content, just not from the
// header.
const nav: NavItem[] = [
  { href: '/#notre-mission', label: 'Notre mission' },
  { href: '/#innovations-bopa', label: 'Nos innovations' },
  { href: '/#notre-vision', label: 'Notre vision' },
  { href: '/#qui-sommes-nous', label: 'Qui sommes-nous ?' },
  { href: '/#nous-contacter', label: 'Nous contacter' },
];

const navCta = { href: '/#nous-soutenir', label: 'Nous soutenir' };

// Footer "Navigation" column (pack "Footer-Header-Interaction-V1",
// 2026-08-28) - même liste que le header (nav + navCta), aplatie au cas
// où un groupe à enfants apparaisse un jour dans `nav`. Aucune nouvelle
// ancre : uniquement celles déjà utilisées par le header lui-même.
const footerNavLinks: NavLink[] = [
  ...nav.flatMap((item) => ('children' in item ? item.children : [item])),
  navCta,
];

// Footer "Nous suivre" (pack "Footer-Pleine-Largeur-Header-Mirror-V2",
// 2026-08-29) - remplace "Liens utiles". LinkedIn = la page entreprise de
// la Chaire (déjà utilisée/confirmée dans source/brief.md, 2026-08-27),
// pas un profil personnel. YouTube = chaîne réelle de la Chaire, transmise
// par l'owner en direct dans cette session (aucune URL inventée).
// Icônes décorées à la main (owner, 2026-08-29 : "les petits symboles de
// LinkedIn... et le symbole de youtube") - pas de librairie d'icônes
// importée pour deux pictos, juste deux petits SVG inline comme partout
// ailleurs sur ce site. Couleurs de marque réelles (bleu LinkedIn officiel,
// rouge YouTube officiel), pas les tokens BOPA : ce sont des logos
// reconnaissables, pas des icônes du design system.
const linkedinIcon = `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="1" y="1" width="22" height="22" rx="5" fill="#0A66C2"/><text x="12" y="16.8" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="12.5" fill="#fff">in</text></svg>`;
const youtubeIcon = `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="5" fill="#FF0000"/><path d="M10 8.7v6.6l6-3.3z" fill="#fff"/></svg>`;

const footerSocialLinks = [
  { href: 'https://www.linkedin.com/company/chaire-innovation-bopa/?viewAsMember=true', label: 'LinkedIn', icon: linkedinIcon },
  { href: 'https://www.youtube.com/channel/UCEkgkM4yxb_mQPnMHaaK4lQ', label: 'YouTube', icon: youtubeIcon },
];

// --- English mirror of the nav/footer above (pack "Version-Anglaise-
// Switch-FR-EN-V1", 2026-09-03). The FR arrays above are never edited or
// reused for EN - a parallel set, selected below by `isEn`, so a future FR
// wording tweak can never accidentally change under the EN nav and
// vice versa. Anchor ids match the ones actually used in en/index.astro.
const navEn: NavItem[] = [
  { href: '/en/#our-mission', label: 'Our mission' },
  { href: '/en/#bopa-innovations', label: 'Our innovations' },
  { href: '/en/#our-vision', label: 'Our vision' },
  { href: '/en/#who-we-are', label: 'Who we are?' },
  { href: '/en/#contact-us', label: 'Contact us' },
];
const navCtaEn = { href: '/en/#support-us', label: 'Support us' };
const footerNavLinksEn: NavLink[] = [
  ...navEn.flatMap((item) => ('children' in item ? item.children : [item])),
  navCtaEn,
];

const activeNav = isEn ? navEn : nav;
const activeNavCta = isEn ? navCtaEn : navCta;
const activeFooterNavLinks = isEn ? footerNavLinksEn : footerNavLinks;

// --- FR <-> EN page map, for the header/footer language switch ---
// An explicit table, not a slug/regex transform: only four public pages
// exist, so a plain lookup can never silently mis-map a future one.
// Astro.url.pathname can arrive with or without a trailing slash depending
// on how the link was followed (trailingSlash isn't set, so Astro accepts
// both) - stripped before matching so either form hits the same entry.
const FR_TO_EN: Record<string, string> = {
  '/': '/en',
  '/nos_innovations': '/en/our-innovations',
  '/boptech': '/en/boptech',
  '/publications': '/en/publications',
};
const EN_TO_FR: Record<string, string> = Object.fromEntries(
  Object.entries(FR_TO_EN).map(([fr, en]) => [en, fr])
);
const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const frPath = isEn ? (EN_TO_FR[currentPath] ?? '/') : currentPath;
const enPath = isEn ? currentPath : (FR_TO_EN[currentPath] ?? '/en');

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og/og-image.jpg', Astro.site);
const frAlternateUrl = new URL(frPath, Astro.site);
const enAlternateUrl = new URL(enPath, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={frAlternateUrl} />
    <link rel="alternate" hreflang="en" href={enAlternateUrl} />
    <link rel="alternate" hreflang="x-default" href={frAlternateUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Aperçu de partage (LinkedIn, Slack, iMessage...) : sans ça, un lien
         partagé n'affiche ni image ni description, juste l'URL nue. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isEn ? 'en_US' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <header class="site-header" data-site-header>
      <div class="site-header-inner">
        <a class="wordmark" href={isEn ? '/en' : '/'}>
          <img
            src="/logos/bopa-wordmark.png"
            alt="BOPA"
            width="900"
            height="415"
          />
          <span class="wordmark-text">
            <span class="wordmark-title">
              {isEn ? (<>The Augmented<br /><em>Operating Room</em></>) : (<>Le bloc opératoire<br /><em>Augmenté</em></>)}
            </span>
          </span>
        </a>
        <div class="site-header-controls">
          <nav id="site-nav">
            {activeNav.map((item) =>
              'children' in item ? (
                <div class="nav-dropdown">
                  <button type="button" class="nav-dropdown-trigger" aria-expanded="false">
                    {item.label}
                  </button>
                  <div class="nav-dropdown-panel">
                    {item.children.map((child) => (
                      <a href={child.href}>{child.label}</a>
                    ))}
                  </div>
                </div>
              ) : (
                <a href={item.href}>{item.label}</a>
              )
            )}
            <div class="nav-cta-group">
              <a class="btn nav-cta btn-filled-premium" href={activeNavCta.href}>
                {activeNavCta.label}
              </a>
              <span class="nav-lang-divider" aria-hidden="true"></span>
              <LangSwitch lang={lang} frPath={frPath} enPath={enPath} variant="desktop" />
            </div>
          </nav>
          <LangSwitch lang={lang} frPath={frPath} enPath={enPath} variant="mobile" />
          <button
            type="button"
            class="nav-toggle"
            aria-label={isEn ? 'Open menu' : 'Ouvrir le menu'}
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer" id="site-footer" data-site-footer>
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div class="site-footer__brand">
            <a class="wordmark" href={isEn ? '/en' : '/'}>
              <img
                src="/logos/bopa-wordmark.png"
                alt="BOPA"
                width="900"
                height="415"
              />
              <span class="wordmark-text">
                <span class="wordmark-title">
                  {isEn ? (<>The Augmented<br /><em>Operating Room</em></>) : (<>Le bloc opératoire<br /><em>Augmenté</em></>)}
                </span>
              </span>
            </a>
          </div>

          <nav class="site-footer__column" aria-label={isEn ? 'Footer navigation' : 'Navigation de pied de page'}>
            <p class="site-footer__heading">Navigation</p>
            <div class="site-footer__nav-grid">
              <div class="site-footer__nav-col">
                {activeFooterNavLinks.slice(0, 3).map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </div>
              <div class="site-footer__nav-col">
                {activeFooterNavLinks.slice(3).map((item) => (
                  <a href={item.href}>{item.label}</a>
                ))}
              </div>
            </div>
          </nav>

          <div class="site-footer__column">
            <p class="site-footer__heading">{isEn ? 'Follow us' : 'Nous suivre'}</p>
            <div class="site-footer__social-list">
              {footerSocialLinks.map((item) => (
                <a class="site-footer__social-link" href={item.href} target="_blank" rel="noopener noreferrer">
                  <span class="site-footer__social-icon" set:html={item.icon} />
                  {item.label}
                </a>
              ))}
            </div>
          </div>

          <div class="site-footer__column">
            <p class="site-footer__heading">{isEn ? 'Find us' : 'Nous trouver'}</p>
            <p class="site-footer__contact">
              Hôpital Paul-Brousse<br />
              12 avenue Paul Vaillant-Couturier<br />
              94804 Villejuif Cedex
            </p>
          </div>
        </div>

        <div class="site-footer__bottom">
          <p>© {new Date().getFullYear()} {isEn ? `${siteName} Innovation Chair` : `Chaire ${siteName}`}</p>
        </div>
      </div>
    </footer>
    <script>
      // Click-to-open nav dropdown (just "Nos innovations" for now):
      // closes on outside click, Escape, or when a link inside is chosen.
      const dropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');

      const closeAllDropdowns = () => {
        dropdowns.forEach((d) => {
          d.classList.remove('is-open');
          d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        });
      };

      dropdowns.forEach((dropdown) => {
        const trigger = dropdown.querySelector('.nav-dropdown-trigger');
        trigger?.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = dropdown.classList.contains('is-open');
          closeAllDropdowns();
          if (!isOpen) {
            dropdown.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });

      document.addEventListener('click', closeAllDropdowns);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAllDropdowns();
      });
    </script>
    <script>
      // Mobile/tablet nav toggle: below the breakpoint where the full nav
      // row wraps onto multiple lines (site.css), the nav collapses behind
      // this hamburger button instead of just letting it wrap and bloat
      // the header's height.
      const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const siteNav = document.getElementById('site-nav');

      const closeNav = () => {
        siteNav?.classList.remove('is-open');
        navToggle?.setAttribute('aria-expanded', 'false');
      };

      navToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = siteNav?.classList.contains('is-open');
        if (isOpen) {
          closeNav();
        } else {
          siteNav?.classList.add('is-open');
          navToggle.setAttribute('aria-expanded', 'true');
        }
      });

      siteNav?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).tagName === 'A') closeNav();
      });

      document.addEventListener('click', (event) => {
        if (!siteNav?.contains(event.target as Node) && event.target !== navToggle) closeNav();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeNav();
      });
    </script>
    <script>
      // Header compact au scroll : au-delà d'un petit seuil, le header
      // gagne un fond flouté/translucide et une ombre discrète (voir
      // .site-header.is-scrolled dans site.css).
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        const applyScrollState = () => {
          header.classList.toggle('is-scrolled', window.scrollY > 24);
        };
        applyScrollState();
        window.addEventListener('scroll', applyScrollState, { passive: true });
      }
    </script>
    <script>
      // Offset d'ancre dynamique (owner, 2026-08-29 : "le header ne masque
      // pas totalement la section du dessus" en cliquant "Les innovations
      // BOPA"). Root cause réelle : --bopa-header-height (utilisé par
      // scroll-margin-top en CSS, site.css) est une constante FIXE calculée
      // pour le header replié à une seule ligne de nav - mais dès qu'une
      // largeur desktop "moyenne" ne laisse plus assez de place à la nav
      // (mesuré : ~1410px et en dessous, avant que le hamburger mobile ne
      // prenne le relais), le bouton "Nous soutenir" passe à la ligne et le
      // header devient bien plus haut que cette constante ne le prévoit -
      // la valeur fixe ne peut pas suivre un header dont la hauteur dépend
      // du nombre de lignes de nav à une largeur donnée. Corrige en
      // mesurant la vraie hauteur du header EN DIRECT à chaque clic/chargement
      // plutôt que de se fier à une constante.
      const anchorHeader = document.querySelector<HTMLElement>('[data-site-header]');
      const reduceMotionForAnchors = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function getAnchorHeaderOffset(): number {
        if (!anchorHeader) return 0;
        const wasScrolled = anchorHeader.classList.contains('is-scrolled');
        if (!wasScrolled) {
          // Seul l'état "replié" compte une fois arrivé à l'ancre (le
          // script "Header compact au scroll" le déclenche dès 24px de
          // scroll, bien avant la fin de l'animation) - mesuré ici sans
          // attendre la transition CSS (coupée le temps de la lecture
          // synchrone) pour ne jamais capturer une hauteur intermédiaire.
          anchorHeader.style.transitionDuration = '0s';
          anchorHeader.classList.add('is-scrolled');
        }
        const height = anchorHeader.getBoundingClientRect().height;
        if (!wasScrolled) {
          anchorHeader.classList.remove('is-scrolled');
          anchorHeader.style.transitionDuration = '';
        }
        return height;
      }

      function scrollToAnchorHash(hash: string, smooth: boolean) {
        const id = decodeURIComponent(hash.replace(/^#/, ''));
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        const top = target.getBoundingClientRect().top + window.scrollY - getAnchorHeaderOffset();
        // 'auto' déférerait au `scroll-behavior:smooth` global (html,
        // site.css) au lieu de sauter instantanément - piège réel trouvé en
        // testant ce correctif : un window.scrollTo({behavior:'auto'})
        // s'est mis à animer lentement au lieu de sauter, alors que 'auto'
        // était censé vouloir dire "instantané" ici. 'instant' force le vrai
        // saut sans animation quand `smooth` est false.
        window.scrollTo({ top, behavior: smooth && !reduceMotionForAnchors ? 'smooth' : 'instant' });
      }

      document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
        let url: URL;
        try {
          url = new URL(link.href, window.location.href);
        } catch {
          return;
        }
        if (url.pathname !== window.location.pathname || !url.hash) return;
        link.addEventListener('click', (event) => {
          event.preventDefault();
          scrollToAnchorHash(url.hash, true);
          history.pushState(null, '', url.hash);
        });
      });

      if (window.location.hash) {
        // Correction immédiate, puis une seconde une fois les polices
        // chargées (une police tardive peut décaler les hauteurs, même
        // prudence que le script d'égalisation des cartes de "Nos
        // innovations"), puis une troisième une fois TOUTES les ressources
        // chargées (`load`, pas juste les polices) - les images `loading`
        // (lazy) sous l'ancre ciblée peuvent réserver leur place via leurs
        // attributs width/height mais décaler quand même de quelques px une
        // fois réellement chargées (mesuré : ~7px résiduels avec les deux
        // premières corrections seules). Couvre le cas d'un lien profond
        // partagé direct (ex. quelqu'un partage /#qui-sommes-nous).
        scrollToAnchorHash(window.location.hash, false);
        document.fonts.ready.then(() => scrollToAnchorHash(window.location.hash, false));
        // `load` peut déjà être passé au moment où ce script s'exécute
        // (script de module, différé) - un addEventListener('load', ...)
        // tardif ne se déclencherait alors jamais.
        if (document.readyState === 'complete') {
          scrollToAnchorHash(window.location.hash, false);
        } else {
          window.addEventListener('load', () => scrollToAnchorHash(window.location.hash, false));
        }
      }
    </script>
    <script>
      // Header disparaît en glissant vers le haut à l'approche du footer
      // (pack "Footer-Header-Interaction-V1", 2026-08-28). IntersectionObserver
      // sur le footer plutôt qu'un listener scroll permanent. Le header reste
      // sticky et garde sa place dans le flux : aucun saut de page, aucune
      // hauteur qui change.
      // Deux pièges réels rencontrés en testant ceci en direct (vrai scroll +
      // vrai observer, pas seulement des manipulations manuelles) :
      // 1) donner un transform à un ANCÊTRE non-sticky du header (ex. un
      //    wrapper dédié à porter cette classe) casse entièrement son
      //    collage - il redevient un élément qui défile normalement avec la
      //    page (un ancêtre transformé change la référence de
      //    positionnement du sticky, comportement CSS réel).
      // 2) sur CE header sticky une fois réellement "collé", un simple
      //    classList.toggle() qui ajoute une règle CSS (transform, top OU
      //    margin-top) dans une feuille de style ne se répercute jamais
      //    visuellement, alors que modifier directement `element.style.*`
      //    en JS fonctionne de façon fiable - ce site n'utilise donc PAS de
      //    classe pour l'effet visuel, seulement pour l'état sémantique/CSS
      //    (garde `is-hidden-by-footer` pour ça), et pose le transform en
      //    style inline dans le callback lui-même.
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const footer = document.querySelector<HTMLElement>('[data-site-footer]');

      if (header && footer && 'IntersectionObserver' in window) {
        const getHeaderHeight = () => Math.ceil(header.getBoundingClientRect().height || 0);
        let observer: IntersectionObserver | undefined;

        const setHidden = (hidden: boolean) => {
          header.classList.toggle('is-hidden-by-footer', hidden);
          header.style.transform = hidden ? 'translateY(-100%)' : '';
          header.style.pointerEvents = hidden ? 'none' : '';
        };

        const createObserver = () => {
          observer?.disconnect();
          const headerHeight = getHeaderHeight();
          observer = new IntersectionObserver(
            ([entry]) => setHidden(entry.isIntersecting),
            { root: null, threshold: 0, rootMargin: `0px 0px -${Math.max(headerHeight * 0.15, 8)}px 0px` }
          );
          observer.observe(footer);
        };

        createObserver();

        let resizeTimer: ReturnType<typeof setTimeout>;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(createObserver, 150);
        });
      }
    </script>
    <script>
      // Scroll-reveal: fade/slide [data-reveal] elements up as they enter
      // the viewport, once each. Stat numbers additionally count up from 0.
      // Skips straight to the revealed state for prefers-reduced-motion.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el: HTMLElement) => {
        const target = parseInt(el.textContent ?? '', 10);
        if (Number.isNaN(target)) return;
        const suffix = (el.textContent ?? '').replace(/^[0-9]+/, '');
        const duration = 1000;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const revealAll = () => revealables.forEach((el) => el.classList.add('is-revealed'));

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-revealed');
              if (el.classList.contains('stat-value')) countUp(el);
              obs.unobserve(el);
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
        );
        revealables.forEach((el) => observer.observe(el));

        // Safety net: a backgrounded/prerendered tab or an odd browser can
        // delay or skip intersection callbacks entirely. Content must never
        // stay invisible because of a decorative animation, so force it
        // visible after a few seconds regardless.
        setTimeout(() => {
          observer.disconnect();
          revealAll();
        }, 3000);
      }
    </script>
    <script>
      // Carry the current in-page anchor across the FR/EN switch when
      // possible (owner: "si possible, conserver aussi la section/ancre en
      // cours"). The server can only ever know the current PATH when
      // building each link's href above - the URL's hash fragment is never
      // sent in an HTTP request, so it doesn't exist yet at that point.
      // Resolved here instead, client-side, once the real hash is known.
      const anchorFrToEn: Record<string, string> = {
        'notre-mission': 'our-mission',
        'innovations-bopa': 'bopa-innovations',
        'notre-vision': 'our-vision',
        'qui-sommes-nous': 'who-we-are',
        'nous-contacter': 'contact-us',
        'nous-soutenir': 'support-us',
      };
      const anchorEnToFr: Record<string, string> = Object.fromEntries(
        Object.entries(anchorFrToEn).map(([fr, en]) => [en, fr])
      );
      const currentHash = window.location.hash.replace(/^#/, '');
      if (currentHash) {
        const onEn = document.documentElement.lang === 'en';
        const translatedHash = onEn ? anchorEnToFr[currentHash] : anchorFrToEn[currentHash];
        if (translatedHash) {
          document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch-link]').forEach((link) => {
            const base = link.getAttribute('data-lang-switch-base');
            if (base) link.href = `${base}#${translatedHash}`;
          });
        }
      }
    </script>
  </body>
</html>
