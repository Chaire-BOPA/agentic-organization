---
// Shared shell for every page: head, header, footer.
// Nav lives here and only here; adding a page means adding one link below.
import '../../../source/brand/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Personalized during setup.
const siteName = 'BOPA';

type NavLink = { href: string; label: string };

// Nav lives here and only here.
const nav: NavLink[] = [
  { href: '/mission', label: 'La Chaire' },
  { href: '/projets', label: 'Le Projet' },
  { href: '/#mission', label: 'La méthode BOPA' },
  { href: '/boptech', label: 'Les innovations BOPA' },
  { href: '/contact', label: 'Contact' },
];

const navCta = { href: 'https://soutenir.fondationaphp.fr/BOPA/', label: 'Nous soutenir' };
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/">
          <img
            src="/logos/bopa-wordmark.png"
            alt="BOPA"
            width="900"
            height="415"
          />
          <span class="wordmark-text">
            <span>Chaire Innovation</span>
            <span>Bloc Opératoire Augmenté</span>
          </span>
        </a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a class="nav-cta" href={navCta.href} target="_blank" rel="noopener">
            {navCta.label}
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {siteName}</p>
    </footer>
    <script>
      // Scroll-reveal: fade/slide [data-reveal] elements up as they enter
      // the viewport, once each. Stat numbers additionally count up from 0.
      // Skips straight to the revealed state for prefers-reduced-motion.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el: HTMLElement) => {
        const target = parseInt(el.textContent ?? '', 10);
        if (Number.isNaN(target)) return;
        const suffix = (el.textContent ?? '').replace(/^[0-9]+/, '');
        const duration = 1000;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(target * eased) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      const revealAll = () => revealables.forEach((el) => el.classList.add('is-revealed'));

      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-revealed');
              if (el.classList.contains('stat-value')) countUp(el);
              obs.unobserve(el);
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
        );
        revealables.forEach((el) => observer.observe(el));

        // Safety net: a backgrounded/prerendered tab or an odd browser can
        // delay or skip intersection callbacks entirely. Content must never
        // stay invisible because of a decorative animation, so force it
        // visible after a few seconds regardless.
        setTimeout(() => {
          observer.disconnect();
          revealAll();
        }, 3000);
      }
    </script>
  </body>
</html>
