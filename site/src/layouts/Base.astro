---
// Shared shell for every page: head, header, footer.
// Nav lives here and only here; adding a page means adding one link below.
import '../../../source/brand/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Personalized during setup.
const siteName = 'BOPA';

type NavLink = { href: string; label: string };
type NavItem = NavLink | { label: string; children: NavLink[] };

// Nav lives here and only here. Each dropdown's children link to their own
// dedicated page (the home page also covers the same topics as a single
// scrollable overview — the two aren't kept in sync automatically).
const nav: NavItem[] = [
  {
    label: 'La Chaire',
    children: [
      { href: '/mission', label: 'Notre mission' },
      { href: '/equipe', label: 'Notre équipe' },
      { href: '/partenaires', label: 'Nos partenaires' },
    ],
  },
  {
    label: 'Innovations',
    children: [
      { href: '/projets', label: 'Nos projets' },
      { href: '/boptech', label: 'Plateforme BOPtech' },
      { href: '/publications', label: 'Publications' },
    ],
  },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">{siteName}</a>
      <nav>
        {nav.map((item) =>
          'children' in item ? (
            <div class="nav-dropdown">
              <button type="button" class="nav-dropdown-trigger" aria-expanded="false">
                {item.label}
              </button>
              <div class="nav-dropdown-panel">
                {item.children.map((child) => (
                  <a href={child.href}>{child.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          )
        )}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {siteName}</p>
    </footer>
    <script>
      // Click-to-open nav dropdowns: closes on outside click, Escape, or
      // when a link inside is chosen. Deliberately not <details> — native
      // disclosure widgets don't let more than one close automatically,
      // which read as buggy with two independent dropdowns side by side.
      const dropdowns = document.querySelectorAll<HTMLElement>('.nav-dropdown');

      function closeAll() {
        dropdowns.forEach((d) => {
          d.classList.remove('is-open');
          d.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        });
      }

      dropdowns.forEach((dropdown) => {
        const trigger = dropdown.querySelector('.nav-dropdown-trigger');
        trigger?.addEventListener('click', (event) => {
          event.stopPropagation();
          const isOpen = dropdown.classList.contains('is-open');
          closeAll();
          if (!isOpen) {
            dropdown.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });

      document.addEventListener('click', closeAll);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeAll();
      });
    </script>
  </body>
</html>
